@page "/login"

<PageTitle>Login</PageTitle>

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card shadow-lg p-4 rounded-4" style="width: 380px;">
        <div class="text-center mb-4">
            <img src="images/LogoRoboBertoIA.png" alt="Logo RoboBerto" class="logo mb-3" />
            <h4 class="fw-bold text-primary">Acesse sua conta</h4>
            <p class="text-muted">Entre para continuar usando o sistema</p>
        </div>

        <div>
            <div class="mb-3">
                <label for="email" class="form-label fw-semibold">E-mail</label>
                <input type="email" id="email" class="form-control rounded-pill" placeholder="Digite seu e-mail" />
            </div>

            <div class="mb-3">
                <label for="senha" class="form-label fw-semibold">Senha</label>
                <input type="password" id="senha" class="form-control rounded-pill" placeholder="Digite sua senha" />
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <input type="checkbox" id="lembrar" />
                    <label for="lembrar" class="text-muted ms-1">Lembrar-me</label>
                </div>
                <a href="#" class="text-decoration-none text-primary small">Esqueci minha senha</a>
            </div>

            <button class="btn btn-primary w-100 rounded-pill fw-semibold">Entrar</button>
        </div>
    </div>
</div>

<style>
    .logo {
        width: 120px;
        height: auto;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
    }

    .card {
        background-color: #fff;
        border: none;
    }

    .form-control {
        padding: 10px 15px;
        font-size: 0.95rem;
    }

    .btn-primary {
        background-color: #4e73df;
        border: none;
        transition: all 0.2s ease;
    }

    .btn-primary:hover {
        background-color: #375ac8;
        transform: scale(1.02);
    }
</style>

