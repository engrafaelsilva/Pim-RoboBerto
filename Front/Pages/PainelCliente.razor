@page "/painel-cliente"

@using System.Text.Json

@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Abrir Chamado</PageTitle>

<div class="painel-wrapper">

    <div class="header-section text-white">
        <h2 class="fw-bold">📌 Abrir Chamado</h2>
        <p class="opacity-75">Preencha as informações abaixo para registrar um chamado</p>
    </div>

    <!-- MENSAGEM DE STATUS -->
    @if (!string.IsNullOrEmpty(MensagemStatus))
    {
        <div class="alert @StatusClass mt-3">@MensagemStatus</div>
    }

    <!-- FORMULÁRIO -->
    <div class="card p-4 shadow-lg mt-4 fade-in form-card">
        <h4 class="fw-bold text-primary mb-3">Novo Chamado</h4>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Categoria</label>
                <select class="form-select" @bind="Categoria">
                    <option value="">Selecione...</option>
                    @foreach (var cat in Categorias)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Prioridade</label>
                <select class="form-select" @bind="Prioridade">
                    <option value="">Selecione...</option>
                    @foreach (var p in Prioridades)
                    {
                        <option value="@p.Value">@p.Key</option>
                    }
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Título</label>
            <input type="text" class="form-control" @bind="Titulo" />
        </div>

        <div class="mb-3">
            <label class="form-label">Descrição</label>
            <textarea class="form-control" rows="4" @bind="Descricao"></textarea>
        </div>

        <button class="btn btn-primary btn-lg" @onclick="EnviarChamado">
            🚀 Enviar Chamado
        </button>
    </div>
</div>

<style>
    .painel-wrapper {
        min-height: 100vh;
        padding: 40px 20px;
        background: linear-gradient(135deg, #2064F8 0%, #12437C 100%);
    }

    .header-section {
        text-align: center;
        margin-bottom: 30px;
    }

    .form-card {
        background: #ffffffd9;
        border-radius: 20px;
    }

    .fade-in {
        animation: fadeIn 0.35s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    // Campos do formulário
    public string Categoria { get; set; }
    public int? Prioridade { get; set; }
    public string Titulo { get; set; }
    public string Descricao { get; set; }

    public string MensagemStatus { get; set; }
    public string StatusClass { get; set; }

    // Dados fixos
    public List<string> Categorias = new()
    {
        "Infraestrutura", "Suporte", "Financeiro"
    };

    public Dictionary<string, int> Prioridades = new()
    {
        { "Baixa", 0 },
        { "Média", 1 },
        { "Alta", 2 }
    };

    private async Task EnviarChamado()
    {
        MensagemStatus = "";

        // Validação básica
        if (string.IsNullOrEmpty(Categoria) ||
            Prioridade == null ||
            string.IsNullOrEmpty(Titulo) ||
            string.IsNullOrEmpty(Descricao))
        {
            MensagemStatus = "Preencha todos os campos!";
            StatusClass = "alert-danger";
            return;
        }

        // Obtém token salvo
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
        if (string.IsNullOrEmpty(token))
        {
            MensagemStatus = "Erro: Usuário não autenticado!";
            StatusClass = "alert-danger";
            return;
        }

        // Formato EXATO do Swagger
        var payload = new ChamadoCreateDTO
            {
                Categoria = new CategoriaDTO { Nome = Categoria },
                Prioridade = Prioridade.Value,
                Titulo = Titulo,
                Descricao = Descricao
            };

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Post, "Chamados")
                {
                    Content = JsonContent.Create(payload, options: new JsonSerializerOptions
                    {
                        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
                    })
                };

            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                MensagemStatus = "Chamado criado com sucesso!";
                StatusClass = "alert-success";

                // Lê o retorno completo do chamado criado
                var jsonChamado = await response.Content.ReadAsStringAsync();
                var chamadoCriado = JsonSerializer.Deserialize<JsonElement>(jsonChamado);

                // Salva descrição e resposta do Gemini no localStorage
                await JS.InvokeVoidAsync("localStorage.setItem",
                    "chatPergunta",
                    chamadoCriado.GetProperty("descricao").GetString());

                await JS.InvokeVoidAsync("localStorage.setItem",
                    "chatResposta",
                    chamadoCriado.GetProperty("sugestaoGemini").GetString());

                // Redireciona para o ChatBoot depois de 1 segundo
                await Task.Delay(1000);
                Nav.NavigateTo("/chatboot");

                // Limpa o formulário
                Categoria = "";
                Prioridade = null;
                Titulo = "";
                Descricao = "";
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                MensagemStatus = $"Erro ao abrir chamado: {erro}";
                StatusClass = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            MensagemStatus = $"Erro inesperado: {ex.Message}";
            StatusClass = "alert-danger";
        }
    }

    // DTOs
    public class ChamadoCreateDTO
    {
        public CategoriaDTO Categoria { get; set; }
        public int Prioridade { get; set; }
        public string Titulo { get; set; }
        public string Descricao { get; set; }
    }

    public class CategoriaDTO
    {
        public string Nome { get; set; }
    }
}