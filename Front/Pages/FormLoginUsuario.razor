@page "/login"
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json

<PageTitle>Login</PageTitle>

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-4 rounded-4" style="width: 380px;">
        <div class="text-center mb-4">
            <h4 class="fw-bold text-primary">Acesse sua conta</h4>
            <p class="text-muted">Entre para continuar usando o sistema</p>
        </div>

        <EditForm Model="@login" OnValidSubmit="ValidarLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="email" class="form-label fw-semibold">E-mail</label>
                <InputText type="email" id="email" class="form-control rounded-pill"
                           placeholder="Digite seu e-mail"
                           @bind-Value="login.Email" />
                <ValidationMessage For="@(() => login.Email)" />
            </div>

            <div class="mb-3">
                <label for="senha" class="form-label fw-semibold">Senha</label>
                <InputText type="password" id="senha" class="form-control rounded-pill"
                           placeholder="Digite sua senha"
                           @bind-Value="login.Senha" />
                <ValidationMessage For="@(() => login.Senha)" />
            </div>

            <button type="submit" class="btn btn-primary w-100 rounded-pill fw-semibold" disabled="@isLoading">
                @(isLoading ? "Entrando..." : "Entrar")
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(mensagem))
        {
            <div class="alert @(isSuccess ? "alert-success" : "alert-danger") mt-3 text-center">
                @mensagem
            </div>
        }
    </div>
</div>

@code {

    private LoginModel login = new();
    private string mensagem = string.Empty;
    private bool isSuccess = false;
    private bool isLoading = false;

    private async Task ValidarLogin()
    {
        mensagem = string.Empty;
        isSuccess = false;
        isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("Autenticacao/login", login);

            if (!response.IsSuccessStatusCode)
            {
                mensagem = "❌ E-mail ou senha incorretos.";
                return;
            }

            var usuarioRetorno = await response.Content.ReadFromJsonAsync<UsuarioRetorno>();

            if (usuarioRetorno == null || string.IsNullOrEmpty(usuarioRetorno.Token))
            {
                mensagem = "❌ Resposta inválida do servidor (token não encontrado).";
                return;
            }

            // 🔥 SALVA NO LOCALSTORAGE
            await JS.InvokeVoidAsync("localStorage.setItem", "username", usuarioRetorno.Nome);
            await JS.InvokeVoidAsync("localStorage.setItem", "token", usuarioRetorno.Token);

            isSuccess = true;
            mensagem = "Login realizado com sucesso!";
            await Task.Delay(800);

            Navigation.NavigateTo("/painel-cliente", forceLoad: true);
        }
        catch
        {
            mensagem = "❌ Erro inesperado ao fazer login.";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
        [Required]
        public string Senha { get; set; } = "";
    }

    public class UsuarioRetorno
    {
        public string Email { get; set; } = "";
        public string Tipo { get; set; } = "";
        public string Nome { get; set; } = "";
        public string Token { get; set; } = "";
    }
}