@page "/login"

@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text
@using System.Text.Json.Serialization;

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-4 rounded-4" style="width: 380px;">
        <div class="text-center mb-4">
            <h4 class="fw-bold text-primary">Acesse sua conta</h4>
            <p class="text-muted">Entre para continuar usando o sistema</p>
        </div>

        <EditForm Model="@login" OnValidSubmit="ValidarLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="email" class="form-label fw-semibold">E-mail</label>
                <InputText type="email" id="email" class="form-control rounded-pill"
                           placeholder="Digite seu e-mail"
                           @bind-Value="login.Email" />
                <ValidationMessage For="@(() => login.Email)" />
            </div>

            <div class="mb-3">
                <label for="senha" class="form-label fw-semibold">Senha</label>
                <InputText type="password" id="senha" class="form-control rounded-pill"
                           placeholder="Digite sua senha"
                           @bind-Value="login.Senha" />
                <ValidationMessage For="@(() => login.Senha)" />
            </div>

            <button type="submit" class="btn btn-primary w-100 rounded-pill fw-semibold" disabled="@isLoading">
                @(isLoading ? "Entrando..." : "Entrar")
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(mensagem))
        {
            <div class="alert @(isSuccess ? "alert-success" : "alert-danger") mt-3 text-center">
                @mensagem
            </div>
        }
    </div>
</div>

@code {
    private LoginModel login = new();
    private string mensagem = string.Empty;
    private bool isSuccess = false;
    private bool isLoading = false;

    private async Task ValidarLogin()
    {
        mensagem = string.Empty;
        isSuccess = false;
        isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("Autenticacao/login", login);

            // 🔥 Tratamento correto de login inválido
            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                mensagem = "❌ E-mail ou senha incorretos.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                mensagem = "❌ Erro no servidor ao fazer login.";
                return;
            }

            var loginResponse = await response.Content.ReadFromJsonAsync<LoginResponse>();
            if (loginResponse == null || string.IsNullOrEmpty(loginResponse.Token))
            {
                mensagem = "❌ Resposta inválida do servidor (token não encontrado).";
                return;
            }

            // Salvar token
            await JS.InvokeVoidAsync("localStorage.setItem", "token", loginResponse.Token);

            // Decodificar o JWT
            var payload = loginResponse.Token.Split('.')[1];
            var decodedPayload = Base64UrlDecode(payload);
            var tokenData = JsonSerializer.Deserialize<JwtPayload>(decodedPayload);

            string role = tokenData.role ?? tokenData.rol ?? tokenData.roleSchema;

            if (string.IsNullOrEmpty(role))
            {
                mensagem = "❌ Token inválido (role não encontrado).";
                return;
            }

            // 🔹 Descobrir o nome do usuário a partir do token (se existir)
            var nomeUsuario =
                   tokenData.name
                ?? tokenData.nome
                ?? tokenData.unique_name
                ?? tokenData.given_name
                ?? tokenData.email; // fallback: e-mail

            // 🔹 Salvar dados no localStorage
            await JS.InvokeVoidAsync("localStorage.setItem", "email", tokenData.email);
            await JS.InvokeVoidAsync("localStorage.setItem", "role", role);
            await JS.InvokeVoidAsync("localStorage.setItem", "usuarioNome", nomeUsuario ?? string.Empty);

            isSuccess = true;
            mensagem = "Login realizado com sucesso!";
            await Task.Delay(700);

            // Redirecionamento baseado no role
            switch (role.ToUpper())
            {
                case "ADM":
                    Navigation.NavigateTo("/paineladm", true);
                    break;

                case "TECNICO":
                    Navigation.NavigateTo("/paineltecnico", true);
                    break;

                default:
                    Navigation.NavigateTo("/painelcolaborador", true);
                    break;
            }
        }
        catch
        {
            mensagem = "❌ Erro inesperado ao fazer login.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string Base64UrlDecode(string input)
    {
        string output = input.Replace('-', '+').Replace('_', '/');
        switch (output.Length % 4)
        {
            case 2: output += "=="; break;
            case 3: output += "="; break;
        }
        var bytes = Convert.FromBase64String(output);
        return Encoding.UTF8.GetString(bytes);
    }

    public class LoginModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Senha { get; set; } = "";
    }

    public class LoginResponse
    {
        [JsonPropertyName("token")]
        public string Token { get; set; } = "";
    }

    public class JwtPayload
    {
        public string nameid { get; set; }

        [JsonPropertyName("email")]
        public string email { get; set; } = "";

        // possíveis nomes para o claim de role
        [JsonPropertyName("role")]
        public string role { get; set; }

        [JsonPropertyName("rol")]
        public string rol { get; set; }

        [JsonPropertyName("http://schemas.microsoft.com/ws/2008/06/identity/claims/role")]
        public string roleSchema { get; set; }

        // 🔹 possíveis nomes para o claim de nome
        [JsonPropertyName("name")]
        public string name { get; set; }

        [JsonPropertyName("nome")]
        public string nome { get; set; }

        [JsonPropertyName("unique_name")]
        public string unique_name { get; set; }

        [JsonPropertyName("given_name")]
        public string given_name { get; set; }

        public long nbf { get; set; }
        public long exp { get; set; }
        public long iat { get; set; }
    }
}