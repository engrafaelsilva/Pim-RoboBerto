@using Microsoft.AspNetCore.Components

<div class="modal-backdrop" style="display:@(Visible ? "block" : "none")">
    <div class="modal">
        <h4>Confirmação da Sugestão da IA</h4>

        @if (string.IsNullOrWhiteSpace(Mensagem))
        {
            <p>Nenhuma sugestão disponível.</p>
        }
        else
        {
            <div class="sugestao-box">
                <p>@(Mensagem)</p>
            </div>
        }

        <div style="display:flex; gap:8px; margin-top:12px;">
            <button class="btn-primary" @onclick="() => Confirmar(true)">Resolveu</button>
            <button class="btn-secondary" @onclick="() => Confirmar(false)">Não resolveu</button>
            <button class="btn" @onclick="IrParaChat">Ir para Chat</button>
            <button class="btn-close" @onclick="Close">Fechar</button>
        </div>
    </div>
</div>

@code {
    bool Visible = false;
    string Mensagem = "";
    Guid ChamadoId = Guid.Empty;

    [Parameter] public EventCallback<(bool resolveu, Guid chamadoId)> OnConfirmacao { get; set; }
    [Parameter] public EventCallback<Guid> OnIrParaChat { get; set; }

    // Expose for parent components via @ref
    public void Show(string mensagem, Guid chamadoId)
    {
        Mensagem = mensagem ?? "";
        ChamadoId = chamadoId;
        Visible = true;
        StateHasChanged();
    }

    void Close()
    {
        Visible = false;
        StateHasChanged();
    }

    async Task Confirmar(bool resolveu)
    {
        Visible = false;
        if (OnConfirmacao.HasDelegate)
            await OnConfirmacao.InvokeAsync((resolveu, ChamadoId));
    }

    async Task IrParaChat()
    {
        Visible = false;
        if (OnIrParaChat.HasDelegate)
            await OnIrParaChat.InvokeAsync(ChamadoId);
    }
}
