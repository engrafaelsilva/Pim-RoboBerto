@page "/painel-colaborador"

@inject NavigationManager Navigation

<link rel="stylesheet" href="css/PainelColaborador.css" />

<div class="layout">

    <!-- Sidebar -->
    <aside class="sidebar">
        <h2 class="logo">Colaborador</h2>

        <nav class="menu">
            <button class="menu-item" @onclick="() => AbaSelecionada = 0">
                Home
            </button>

            <button class="menu-item" @onclick="() => AbaSelecionada = 1">
                Abrir Chamado
            </button>

            <button class="menu-item" @onclick="() => AbaSelecionada = 2">
                Meus Chamados
            </button>

            <button class="menu-item" @onclick="() => AbaSelecionada = 3">
                Chat com Técnico
            </button>

            <button class="menu-item logout" @onclick="Logout">
                Logout
            </button>
        </nav>
    </aside>


    <!-- Conteúdo Principal -->
    <main class="conteudo">
        @if (AbaSelecionada == 0)
        {
            <!-- FORMULÁRIO DE CHAMADO -->
            <section class="card">
                <h1>Seja bem-vindo(a)!</h1>
                <p>Aqui você poderá abrir um chamado, acompanhar o status do chamado, conversar com algum técnico</p>
            </section>
        }

        @if (AbaSelecionada == 1)
        {
            <!-- FORMULÁRIO DE CHAMADO -->
            <section class="card">
                <h3>Abrir Novo Chamado</h3>

                <div class="form-grid">

                    <div class="form-control">
                        <label>Título</label>
                        <input class="input" @bind="NovoChamado.Titulo" placeholder="Informe o título do chamado" />
                    </div>

                    <div class="form-control full">
                        <label>Descrição</label>
                        <textarea class="textarea" rows="4" @bind="NovoChamado.Descricao" placeholder="Informe a descrição do chamado"></textarea>
                    </div>

                    <div class="form-control">
                        <label>Prioridade</label>
                        <select class="input" @bind="NovoChamado.Prioridade">
                            <option>Baixa</option>
                            <option>Média</option>
                            <option>Alta</option>
                        </select>
                    </div>

                    <div class="form-control">
                        <label>Categoria</label>
                        <select class="input" @bind="NovoChamado.Categoria">
                            <option>Suporte</option>
                            <option>Financeiro</option>
                            <option>Infraestrutura</option>
                        </select>
                    </div>
                </div>

                <div class="btn-row">
                    <button class="btn secondary" @onclick="LimparFormulario">Limpar</button>
                    <button class="btn primary" @onclick="EnviarChamado">Enviar</button>
                </div>
            </section>
        }


        @if (AbaSelecionada == 2)
        {
            <!-- LISTA DE CHAMADOS -->
            <section class="card">
                <h3>Meus Chamados</h3>

                @if (Chamados.Count == 0)
                {
                    <p class="msg-empty">Nenhum chamado encontrado.</p>
                }
                else
                {
                    <div class="lista-chamados">
                        @foreach (var c in Chamados)
                        {
                            <div class="chamado-item">
                                <h4>@c.Titulo</h4>
                                <p>@c.Descricao</p>
                                <span class="status">@c.Status</span>
                            </div>
                        }
                    </div>
                }
            </section>
        }


        @if (AbaSelecionada == 3)
        {
            <!-- CHAT COM TÉCNICO -->
            <section class="card">
                <h3>Chat com Técnico</h3>

                <div class="chat-window">
                    @foreach (var m in ChatMensagens)
                    {
                        <div class="msg @(m.Remetente)">
                            <div class="bubble">@m.Texto</div>
                        </div>
                    }
                </div>

                <div class="chat-input">
                    <input class="input" @bind="MensagemChat" placeholder="Digite sua mensagem..." />
                    <button class="btn primary" @onclick="EnviarMensagemChat">Enviar</button>
                </div>
            </section>
        }

    </main>

</div>


@code {

    int AbaSelecionada = 0;

    // Modelo básico do chamado
    public class Chamado
    {
        public string Titulo { get; set; } = "";
        public string Descricao { get; set; } = "";
        public string Prioridade { get; set; } = "Baixa";
        public string Categoria { get; set; } = "Suporte";
        public string Status { get; set; } = "Aberto";
    }

    // Chat
    public class Mensagem
    {
        public string Remetente { get; set; } = "usuario"; // usuario | tecnico
        public string Texto { get; set; } = "";
    }

    Chamado NovoChamado = new();
    List<Chamado> Chamados = new();
    List<Mensagem> ChatMensagens = new();
    string MensagemChat = "";

    void EnviarChamado()
    {
        Chamados.Add(new Chamado
            {
                Titulo = NovoChamado.Titulo,
                Descricao = NovoChamado.Descricao,
                Prioridade = NovoChamado.Prioridade,
                Categoria = NovoChamado.Categoria,
                Status = "Aberto"
            });

        LimparFormulario();
    }

    void LimparFormulario()
    {
        NovoChamado = new Chamado();
    }

    void EnviarMensagemChat()
    {
        if (string.IsNullOrWhiteSpace(MensagemChat)) return;

        ChatMensagens.Add(new Mensagem
            {
                Remetente = "usuario",
                Texto = MensagemChat
            });

        MensagemChat = "";
    }

    void Logout()
    {
        Navigation.NavigateTo("/login");
    }
}
