<link rel="stylesheet" href="css/PainelColaborador.css" />

@if (Visible)
{
    <div class="modal-overlay">
        <div class="modal-content">
            <h3>Confirmar Sugestão</h3>

            <p>Deseja realmente confirmar esta sugestão como concluída?</p>

            <div class="modal-footer">
                <button class="btn-enviar" @onclick="Confirmar">Sim</button>
                <button class="btn-fechar" @onclick="Close">Não</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback OnConfirmar { get; set; }

    void Close()
    {
        Visible = false;
        VisibleChanged.InvokeAsync(false);
    }

    Task Confirmar()
    {
        Close();
        return OnConfirmar.InvokeAsync();
    }
}
