@namespace Front.Pages.Modais.Tecnico
@using Microsoft.AspNetCore.Components

@if (Mostrar)
{
    <div class="modal-backdrop">
        <div class="modal-container">
            <h5>@Titulo</h5>

            <textarea class="form-control mb-3"
                      rows="4"
                      placeholder="Digite seu comentário..."
                      @bind="ComentarioInterno">
            </textarea>

            <div class="modal-actions">
                <button class="btn btn-success"
                        @onclick="Enviar"
                        disabled="@IsSaving">
                    @(IsSaving ? "Enviando..." : "Enviar")
                </button>
                <button class="btn btn-secondary" @onclick="OnCancelar">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Mostrar { get; set; }
    [Parameter] public string Titulo { get; set; } = "Comentar Chamado";
    [Parameter] public string Comentario { get; set; } = "";
    [Parameter] public bool IsSaving { get; set; }

    [Parameter] public EventCallback<string> OnEnviar { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }

    string ComentarioInterno
    {
        get => Comentario;
        set => Comentario = value;
    }

    async Task Enviar()
    {
        await OnEnviar.InvokeAsync(Comentario);
    }
}