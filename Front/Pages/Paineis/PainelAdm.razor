    // ============================== HELPERS ==============================
    string GetStatusTexto(int status) => status switch
    {
        (int)EStatusChamado.ABERTO => "Aberto",
        (int)EStatusChamado.SUGESTAO_GERADA => "Sugestão Gerada",
        (int)EStatusChamado.FECHADO => "Fechado",
        (int)EStatusChamado.CANCELADO => "Cancelado",
        _ => "Desconhecido"
    };

    string GetPrioridadeTexto(int p) => p switch
    {
        0 => "Baixa",
        1 => "Média",
        2 => "Alta",
        _ => "?"
    };

    int TotalChamados => Chamados.Count;
    int ChamadosAbertos => Chamados.Count(c => c.Status == (int)EStatusChamado.ABERTO);
    int ChamadosSugestao => Chamados.Count(c => c.Status == (int)EStatusChamado.SUGESTAO_GERADA);
    int ChamadosFechados => Chamados.Count(c => c.Status == (int)EStatusChamado.FECHADO);
    int ChamadosCancelados => Chamados.Count(c => c.Status == (int)EStatusChamado.CANCELADO);
    int ChamadosSemTecnico => Chamados.Count(c =>
        (c.Tecnico == null || string.IsNullOrWhiteSpace(c.Tecnico.Id)) &&
        c.Status != (int)EStatusChamado.FECHADO &&
        c.Status != (int)EStatusChamado.CANCELADO);

    int TotalTecnicosAtivos => Usuarios.Count(u =>
        u.Ativo && u.Tipo != null && u.Tipo.ToUpper().Contains("TECNICO"));

    double PrioridadeMedia =>
        Chamados.Count == 0 ? 0 : Chamados.Average(c => c.Prioridade);
}