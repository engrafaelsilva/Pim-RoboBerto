@page "/paineladm"

@using System.Net.Http
@using System.Net.Http.Json
@using System.Text.Json
@using System.Linq
@using System.Threading.Tasks
@using IA_RoboBerto.Models.Enums
@using Front.Pages.Modais.Admin
@using System.Net.Http.Headers

@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http

<PageTitle>Painel do Administrador</PageTitle>

<link href="css/PainelAdm.css" rel="stylesheet" />
<link href="css/ModalUsuarioAdm.css" rel="stylesheet" />
<link href="css/ModalDepartamentoAdm.css" rel="stylesheet" />
<link href="css/ModalConfirmacaoAdm.css" rel="stylesheet" />

<div class="layout">

    <!-- Sidebar -->
    <aside class="sidebar">
        <h2 class="logo">Painel do Administrador</h2>

        <nav class="menu">
            <button class="menu-item" @onclick="() => AbaSelecionada = 0">Home</button>
            <button class="menu-item" @onclick="() => AbaSelecionada = 1">Chamados</button>
            <button class="menu-item" @onclick="() => AbaSelecionada = 2">Usuários</button>
            <button class="menu-item" @onclick="() => AbaSelecionada = 3">Categorias</button>
            <button class="menu-item" @onclick="() => AbaSelecionada = 4">Departamentos</button>
            <button class="menu-item" @onclick="() => AbaSelecionada = 5">Roles</button>
            <button class="menu-item" @onclick="() => AbaSelecionada = 6">Relatórios</button>
            <button class="menu-item logout" @onclick="Sair">Sair</button>
        </nav>
    </aside>

    <!-- Conteúdo -->
    <main class="conteudo">

        @* MENSAGEM GLOBAL DE STATUS *@
        @if (!string.IsNullOrEmpty(UiStatusMessage))
        {
            <div class="admin-alert @(UiStatusIsError ? "admin-alert-error" : "admin-alert-success")">
                @UiStatusMessage
            </div>
        }

        @* BARRA DE CARREGAMENTO GLOBAL (QUALQUER COISA CARREGANDO) *@
        @if (IsAnyLoading)
        {
            <div class="admin-loading-bar">
                <span>@LoadingText</span>
            </div>
        }

        @* ===================== DASHBOARD GERAL ===================== *@
        @if (AbaSelecionada == 0)
        {
            <section class="card dashboard-card">
                <div class="dashboard-header">
                    <div>
                        <h1>📊 Dashboard Geral</h1>
                        <p class="subtitle">
                            Visão consolidada dos chamados, usuários, categorias e departamentos do sistema.
                        </p>
                    </div>
                    <button class="btn-refresh"
                            disabled="@IsLoadingAllData"
                            @onclick="LoadAllData">
                        @(IsLoadingAllData ? "⏳ Atualizando..." : "🔄 Atualizar dados")
                    </button>
                </div>

                <div class="dashboard-grid">
                    <div class="dash-card primary">
                        <span class="dash-label">Total de chamados</span>
                        <span class="dash-value">@TotalChamados</span>
                        <span class="dash-footer">Abertos: @ChamadosAbertos • Fechados: @ChamadosFechados</span>
                    </div>

                    <div class="dash-card">
                        <span class="dash-label">Chamados por status</span>
                        <span class="dash-value-sm">
                            Aberto: @ChamadosAbertos<br />
                            Sugestão: @ChamadosSugestao<br />
                            Fechado: @ChamadosFechados<br />
                            Cancelado: @ChamadosCancelados
                        </span>
                    </div>

                    <div class="dash-card">
                        <span class="dash-label">Chamados sem técnico</span>
                        <span class="dash-value">@ChamadosSemTecnico</span>
                        <span class="dash-footer">Pendentes de alocação</span>
                    </div>

                    <div class="dash-card">
                        <span class="dash-label">Usuários</span>
                        <span class="dash-value">@Usuarios.Count</span>
                        <span class="dash-footer">
                            Técnicos ativos: @TotalTecnicosAtivos
                        </span>
                    </div>
                </div>

                <div class="dashboard-grid dashboard-grid-sec">
                    <div class="dash-card">
                        <span class="dash-label">Categorias</span>
                        <span class="dash-value">@Categorias.Count</span>
                        <span class="dash-footer">Organizam os chamados por tema</span>
                    </div>

                    <div class="dash-card">
                        <span class="dash-label">Departamentos</span>
                        <span class="dash-value">@Departamentos.Count</span>
                        <span class="dash-footer">Relacionados aos usuários</span>
                    </div>

                    <div class="dash-card">
                        <span class="dash-label">Prioridade média (0–2)</span>
                        <span class="dash-value">@PrioridadeMedia.ToString("0.0")</span>
                        <span class="dash-footer">Cálculo sobre todos os chamados</span>
                    </div>
                </div>
            </section>
        }

        @* ===================== CHAMADOS (TABELA ADM) ===================== *@
        @if (AbaSelecionada == 1)
        {
            <section class="card">
                <div class="card-header-flex">
                    <div>
                        <h5 class="fw-bold">📋 Chamados</h5>
                        <p class="subtitle">
                            Lista de todos os chamados cadastrados no sistema.
                        </p>
                    </div>
                    <button class="btn-refresh"
                            disabled="@IsLoadingChamados"
                            @onclick="LoadChamados">
                        @(IsLoadingChamados ? "⏳ Recarregando..." : "🔄 Recarregar")
                    </button>
                </div>

                <table class="table table-hover text-center">
                    <thead class="table-primary">
                        <tr>
                            <th>ID</th>
                            <th>Título</th>
                            <th>Cliente</th>
                            <th>Status</th>
                            <th>Prioridade</th>
                            <th>Técnico</th>
                            <th>Último Comentário</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Chamados)
                        {
                            var ultimoComentario = c.Mensagens?
                                .OrderByDescending(m => m.DataHoraMensagem)
                                .FirstOrDefault()?.Texto ?? "-";

                            <tr>
                                <td>@(c.Id?.Length > 6 ? c.Id.Substring(0, 6) : c.Id)</td>
                                <td>@c.Titulo</td>
                                <td>@(c.Autor?.Nome ?? "-")</td>
                                <td>@GetStatusTexto(c.Status)</td>
                                <td>@GetPrioridadeTexto(c.Prioridade)</td>
                                <td>@(c.Tecnico?.Nome ?? "-")</td>
                                <td>@ultimoComentario</td>
                                <td>
                                    <button class="btn btn-danger btn-sm"
                                            @onclick='() => AbrirModalAcaoChamado(c, "excluir")'>
                                        Excluir
                                    </button>

                                    <button class="btn btn-primary btn-sm"
                                            @onclick="() => AbrirModalComentarChamado(c)">
                                        Comentar
                                    </button>

                                    <button class="btn btn-warning btn-sm"
                                            @onclick='() => AbrirModalAcaoChamado(c, "fechar")'>
                                        Fechar
                                    </button>

                                    <button class="btn btn-secondary btn-sm"
                                            @onclick='() => AbrirModalAcaoChamado(c, "cancelar")'>
                                        Cancelar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        @* ===================== USUÁRIOS ===================== *@
        @if (AbaSelecionada == 2)
        {
            <section class="card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold">👥 Usuários</h5>
                    <button class="btn btn-success btn-sm" @onclick="AbrirModalCriarUsuario">Criar Usuário</button>
                </div>

                <table class="table table-striped text-center">
                    <thead class="table-secondary">
                        <tr>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Tipo</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Usuarios)
                        {
                            <tr>
                                <td>@u.Nome</td>
                                <td>@u.Email</td>
                                <td>@u.Tipo</td>
                                <td>@(u.Ativo ? "Ativo" : "Inativo")</td>
                                <td>
                                    <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalUsuario(u)">Editar</button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => ConfirmRemoverUsuario(u.Id, u.Nome)">Excluir</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        @* ===================== CATEGORIAS ===================== *@
        @if (AbaSelecionada == 3)
        {
            <section class="card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold">🏷️ Categorias</h5>
                    <button class="btn btn-success btn-sm" @onclick="AbrirModalCriarCategoria">Criar Categoria</button>
                </div>

                @foreach (var c in Categorias)
                {
                    <div class="border p-2 rounded mb-2 d-flex justify-content-between align-items-center">
                        @c.Nome
                        <div>
                            <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalCategoria(c)">Editar</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => ConfirmRemoverCategoria(c.Id, c.Nome)">Excluir</button>
                        </div>
                    </div>
                }
            </section>
        }

        @* ===================== DEPARTAMENTOS ===================== *@
        @if (AbaSelecionada == 4)
        {
            <section class="card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold">🏢 Departamentos</h5>
                    <button class="btn btn-success btn-sm" @onclick="AbrirModalCriarDepartamento">Criar Departamento</button>
                </div>

                @foreach (var d in Departamentos)
                {
                    <div class="border p-2 rounded mb-2">
                        <strong>@d.Nome</strong>
                        <ul>
                            @foreach (var u in d.Usuarios)
                            {
                                <li>@u.Nome</li>
                            }
                        </ul>
                        <div>
                            <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalDepartamento(d)">Editar</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => ConfirmRemoverDepartamento(d.Id, d.Nome)">Excluir</button>
                        </div>
                    </div>
                }
            </section>
        }

        @* ===================== ROLES (APENAS LEITURA) ===================== *@
        @if (AbaSelecionada == 5)
        {
            <section class="card p-4">
                <h5 class="fw-bold mb-3">🛡️ Roles</h5>
                <p class="text-muted mb-3">
                    Roles são somente leitura via API (somente endpoints GET estão expostos).
                </p>

                <table class="table table-striped text-center">
                    <thead class="table-secondary">
                        <tr>
                            <th>Nome da Role</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Roles)
                        {
                            <tr>
                                <td>@r.Nome</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        @* ===================== RELATÓRIOS DINÂMICOS ===================== *@
        @if (AbaSelecionada == 6)
        {
            <section class="card relatorios-card">
                <div class="card-header-flex">
                    <div>
                        <h5 class="fw-bold mb-1">📊 Relatórios Dinâmicos</h5>
                    </div>
                    <button class="btn-refresh"
                            disabled="@IsLoadingChamados"
                            @onclick="LoadChamados">
                        @(IsLoadingChamados ? "⏳ Atualizando..." : "🔄 Atualizar chamados")
                    </button>
                </div>

                <div class="relatorio-grid">
                    <div class="relatorio-section">
                        <h6>Chamados por Status</h6>
                        <table class="table table-sm table-striped text-center">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in Chamados.GroupBy(c => c.Status))
                                {
                                    <tr>
                                        <td>@GetStatusTexto(g.Key)</td>
                                        <td>@g.Count()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="relatorio-section">
                        <h6>Chamados por Prioridade</h6>
                        <table class="table table-sm table-striped text-center">
                            <thead>
                                <tr>
                                    <th>Prioridade</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in Chamados.GroupBy(c => c.Prioridade))
                                {
                                    <tr>
                                        <td>@GetPrioridadeTexto(g.Key)</td>
                                        <td>@g.Count()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="relatorio-section">
                        <h6>Chamados por Técnico</h6>
                        <table class="table table-sm table-striped text-center">
                            <thead>
                                <tr>
                                    <th>Técnico</th>
                                    <th>Abertos</th>
                                    <th>Fechados</th>
                                    <th>Cancelados</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in Chamados
                                    .Where(c => c.Tecnico != null && !string.IsNullOrWhiteSpace(c.Tecnico.Nome))
                                    .GroupBy(c => c.Tecnico.Nome))
                                {
                                    <tr>
                                        <td>@g.Key</td>
                                        <td>@g.Count(c => c.Status == (int)EStatusChamado.ABERTO || c.Status == (int)EStatusChamado.SUGESTAO_GERADA)</td>
                                        <td>@g.Count(c => c.Status == (int)EStatusChamado.FECHADO)</td>
                                        <td>@g.Count(c => c.Status == (int)EStatusChamado.CANCELADO)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="relatorio-section">
                        <h6>Chamados por Categoria</h6>
                        <table class="table table-sm table-striped text-center">
                            <thead>
                                <tr>
                                    <th>Categoria</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in Chamados
                                    .GroupBy(c => c.Categoria?.Nome ?? "Sem categoria"))
                                {
                                    <tr>
                                        <td>@g.Key</td>
                                        <td>@g.Count()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        }

    </main>
</div>

@* ===================== MODAIS DE FORMULÁRIO ===================== *@

@if (ModalUsuarioAtivo)
{
    <div class="modal-backdrop-admin">
        <div class="modal-admin">
            <h5>@(IsCreatingUsuario ? "Criar Usuário" : "Editar Usuário")</h5>

            <input class="form-control mb-2" placeholder="Nome" @bind="UsuarioModal.Nome" />
            <input class="form-control mb-2" placeholder="Email" @bind="UsuarioModal.Email" />
            @if (IsCreatingUsuario)
            {
                <input class="form-control mb-2" placeholder="Senha" type="password" @bind="UsuarioModal.Senha" />
            }
            <select class="form-select mb-2" @bind="UsuarioModal.Tipo">
                @foreach (var r in Roles)
                {
                    <option value="@r.Nome">@r.Nome</option>
                }
            </select>

            <select class="form-select mb-2" @bind="UsuarioModal.DepartamentoId">
                <option value="">-- Departamento --</option>
                @foreach (var d in Departamentos)
                {
                    <option value="@d.Id">@d.Nome</option>
                }
            </select>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" @bind="UsuarioModal.Ativo" />
                <label class="form-check-label">Ativo</label>
            </div>

            <div class="modal-actions">
                <button class="btn btn-success" @onclick="SalvarUsuario">Salvar</button>
                <button class="btn btn-secondary" @onclick="() => ModalUsuarioAtivo = false">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (ModalCategoriaAtivo)
{
    <div class="modal-backdrop-admin">
        <div class="modal-admin">
            <h5>@(IsCreatingCategoria ? "Criar Categoria" : "Editar Categoria")</h5>
            <input class="form-control mb-3" placeholder="Nome" @bind="CategoriaModal.Nome" />
            <div class="modal-actions">
                <button class="btn btn-success" @onclick="SalvarCategoria">Salvar</button>
                <button class="btn btn-secondary" @onclick="() => ModalCategoriaAtivo=false">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (ModalDepartamentoAtivo)
{
    <div class="modal-backdrop-admin">
        <div class="modal-admin">
            <h5>@(IsCreatingDepartamento ? "Criar Departamento" : "Editar Departamento")</h5>
            <input class="form-control mb-3" placeholder="Nome" @bind="DepartamentoModal.Nome" />
            <div class="modal-actions">
                <button class="btn btn-success" @onclick="SalvarDepartamento">Salvar</button>
                <button class="btn btn-secondary" @onclick="() => ModalDepartamentoAtivo=false">Cancelar</button>
            </div>
        </div>
    </div>
}

@* ===================== MODAIS DE CONFIRMAÇÃO ===================== *@
@if (ModalConfirmacaoUsuarioAtivo)
{
    <div class="modal-backdrop-admin">
        <div class="modal-admin modal-confirm">
            <h5>Excluir usuário</h5>
            <p>Deseja realmente excluir o usuário <strong>@UsuarioNomeParaExcluir</strong>? Esta ação é irreversível.</p>
            <div class="modal-actions">
                <button class="btn btn-danger" @onclick="RemoverUsuarioConfirmado">Excluir</button>
                <button class="btn btn-secondary" @onclick="FecharModalConfirmacaoUsuario">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (ModalConfirmacaoCategoriaAtivo)
{
    <div class="modal-backdrop-admin">
        <div class="modal-admin modal-confirm">
            <h5>Excluir categoria</h5>
            <p>Deseja realmente excluir a categoria <strong>@CategoriaNomeParaExcluir</strong>?</p>
            <div class="modal-actions">
                <button class="btn btn-danger" @onclick="RemoverCategoriaConfirmado">Excluir</button>
                <button class="btn btn-secondary" @onclick="FecharModalConfirmacaoCategoria">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (ModalConfirmacaoDepartamentoAtivo)
{
    <div class="modal-backdrop-admin">
        <div class="modal-admin modal-confirm">
            <h5>Excluir departamento</h5>
            <p>Deseja realmente excluir o departamento <strong>@DepartamentoNomeParaExcluir</strong>?</p>
            <div class="modal-actions">
                <button class="btn btn-danger" @onclick="RemoverDepartamentoConfirmado">Excluir</button>
                <button class="btn btn-secondary" @onclick="FecharModalConfirmacaoDepartamento">Cancelar</button>
            </div>
        </div>
    </div>
}

<ModalConfirmarAcaoChamado Mostrar="@MostrarModalConfirmacaoChamado"
                           Titulo="@TituloModalConfirmacaoChamado"
                           Mensagem="@MensagemModalConfirmacaoChamado"
                           TextoBotaoConfirmar="@TextoBotaoConfirmacaoChamado"
                           OnConfirmar="ConfirmarAcaoChamado"
                           OnCancelar="FecharModalConfirmacaoChamado" />

<ModalComentarChamado Mostrar="@MostrarModalComentarChamado"
                      Titulo="Comentar Chamado"
                      TextoComentario="@ComentarioChamadoTexto"
                      IsSaving="@IsSavingComentarioChamado"
                      OnEnviar="EnviarComentarioChamado"
                      OnCancelar="FecharModalComentarChamado" />

@code {

    // ================== STATUS GLOBAL / LOADING ==================
    string UiStatusMessage { get; set; }
    bool UiStatusIsError { get; set; }

    bool IsLoadingAllData { get; set; }
    bool IsLoadingChamados { get; set; }
    string LoadingText { get; set; } = "";

    bool IsAnyLoading => IsLoadingAllData || IsLoadingChamados;

    void ShowSuccess(string msg)
    {
        UiStatusMessage = msg;
        UiStatusIsError = false;
        StateHasChanged();
    }

    void ShowError(string msg)
    {
        UiStatusMessage = msg;
        UiStatusIsError = true;
        StateHasChanged();
    }

    // ================== ESTADO PARA CONFIRMAÇÕES ==================
    bool ModalConfirmacaoUsuarioAtivo = false;
    string UsuarioIdParaExcluir = "";
    string UsuarioNomeParaExcluir = "";

    bool ModalConfirmacaoCategoriaAtivo = false;
    string CategoriaIdParaExcluir = "";
    string CategoriaNomeParaExcluir = "";

    bool ModalConfirmacaoDepartamentoAtivo = false;
    string DepartamentoIdParaExcluir = "";
    string DepartamentoNomeParaExcluir = "";

    // ================== ESTADO PARA MODAIS DE CHAMADOS ==================
    ChamadoDTO? ChamadoSelecionado { get; set; }

    bool MostrarModalConfirmacaoChamado = false;
    string TipoAcaoChamado = ""; // "excluir", "fechar", "cancelar"
    string TituloModalConfirmacaoChamado = "";
    string MensagemModalConfirmacaoChamado = "";
    string TextoBotaoConfirmacaoChamado = "";

    bool MostrarModalComentarChamado = false;
    string ComentarioChamadoTexto = "";
    bool IsSavingComentarioChamado = false;

    void AbrirModalAcaoChamado(ChamadoDTO chamado, string tipoAcao)
    {
        ChamadoSelecionado = chamado;
        TipoAcaoChamado = tipoAcao;

        switch (tipoAcao)
        {
            case "excluir":
                TituloModalConfirmacaoChamado = "Excluir chamado";
                MensagemModalConfirmacaoChamado = $"Deseja realmente excluir o chamado \"{chamado.Titulo}\"? Esta ação é irreversível.";
                TextoBotaoConfirmacaoChamado = "Excluir";
                break;
            case "fechar":
                TituloModalConfirmacaoChamado = "Fechar chamado";
                MensagemModalConfirmacaoChamado = $"Deseja marcar o chamado \"{chamado.Titulo}\" como FECHADO?";
                TextoBotaoConfirmacaoChamado = "Fechar";
                break;
            case "cancelar":
                TituloModalConfirmacaoChamado = "Cancelar chamado";
                MensagemModalConfirmacaoChamado = $"Deseja cancelar o chamado \"{chamado.Titulo}\"?";
                TextoBotaoConfirmacaoChamado = "Cancelar chamado";
                break;
        }

        MostrarModalConfirmacaoChamado = true;
    }

    Task FecharModalConfirmacaoChamado()
    {
        MostrarModalConfirmacaoChamado = false;
        TipoAcaoChamado = "";
        return Task.CompletedTask;
    }

    async Task ConfirmarAcaoChamado()
    {
        if (ChamadoSelecionado == null || string.IsNullOrEmpty(TipoAcaoChamado))
        {
            ShowError("Nenhum chamado selecionado.");
            return;
        }

        try
        {
            HttpResponseMessage res;

            if (TipoAcaoChamado == "excluir")
            {
                // DELETE /Chamados/{id}
                res = await Http.DeleteAsync($"Chamados/{ChamadoSelecionado.Id}");
            }
            else if (TipoAcaoChamado == "fechar")
            {
                // PATCH /Chamados/{id}/fechar-chamado
                res = await Http.PatchAsync($"Chamados/{ChamadoSelecionado.Id}/fechar-chamado", null);
            }
            else // cancelar
            {
                // PATCH /Chamados/{id}/cancelar
                res = await Http.PatchAsync($"Chamados/{ChamadoSelecionado.Id}/cancelar", null);
            }

            if (res.IsSuccessStatusCode)
            {
                await LoadChamados();
                ShowSuccess("Ação executada com sucesso no chamado.");
            }
            else if (res.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                ShowError("Você não tem permissão para executar esta ação.");
            }
            else if (res.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                ShowError("Operação não permitida (409 - integridade).");
            }
            else
            {
                var txt = await res.Content.ReadAsStringAsync();
                ShowError($"Erro ao realizar ação: {res.StatusCode}\n{txt}");
            }
        }
        catch (Exception ex)
        {
            ShowError($"Erro ao realizar ação: {ex.Message}");
        }
        finally
        {
            await FecharModalConfirmacaoChamado();
        }
    }

