@page "/paineladm"

@using System.Net.Http
@using System.Net.Http.Json
@using System.Text.Json
@using System.Linq
@using System.Threading.Tasks
@using IA_RoboBerto.Models.Enums

@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http

<PageTitle>Painel do Administrador</PageTitle>

<link href="css/PainelAdm.css" rel="stylesheet" />

<div class="layout">

    <!-- Sidebar -->
    <aside class="sidebar">
        <h2 class="logo">Painel do Administrador</h2>

        <nav class="menu">
            <button class="menu-item" @onclick="() => AbaSelecionada = 0">Home</button>
            <button class="menu-item" @onclick="() => AbaSelecionada = 1">Chamados</button>
            <button class="menu-item" @onclick="() => AbaSelecionada = 2">Usuários</button>
            <button class="menu-item" @onclick="() => AbaSelecionada = 3">Categorias</button>
            <button class="menu-item" @onclick="() => AbaSelecionada = 4">Departamentos</button>
            <button class="menu-item" @onclick="() => AbaSelecionada = 5">Roles</button>
            <button class="menu-item" @onclick="() => AbaSelecionada = 6">Relatórios</button>
            <button class="menu-item logout" @onclick="Sair">Sair</button>
        </nav>
    </aside>

    <!-- Conteúdo -->
    <main class="conteudo">

        @if (AbaSelecionada == 0)
        {
            <section class="card p-4">
                <h1 class="mb-3">📊 Dashboard Geral</h1>

                <div class="row text-center">
                    <div class="col-md-3 mb-3">
                        <div class="card shadow-sm p-3">
                            <h4>@Chamados.Count</h4>
                            <p>Total de Chamados</p>
                        </div>
                    </div>

                    <div class="col-md-3 mb-3">
                        <div class="card shadow-sm p-3">
                            <h4>@Chamados.Count(c => c.Status == (int)EStatusChamado.ABERTO)</h4>
                            <p>Abertos</p>
                        </div>
                    </div>

                    <div class="col-md-3 mb-3">
                        <div class="card shadow-sm p-3">
                            <h4>@Chamados.Count(c => c.Status == (int)EStatusChamado.FECHADO)</h4>
                            <p>Fechados</p>
                        </div>
                    </div>

                    <div class="col-md-3 mb-3">
                        <div class="card shadow-sm p-3">
                            <h4>@Usuarios.Count</h4>
                            <p>Usuários</p>
                        </div>
                    </div>
                </div>

            </section>
        }

        @if (AbaSelecionada == 1)
        {
            <div class="card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold">📋 Chamados</h5>
                </div>

                <table class="table table-hover text-center">
                    <thead class="table-primary">
                        <tr>
                            <th>ID</th>
                            <th>Título</th>
                            <th>Cliente</th>
                            <th>Status</th>
                            <th>Prioridade</th>
                            <th>Técnico</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Chamados)
                        {
                            <tr>
                                <td>@(c.Id?.Length > 6 ? c.Id.Substring(0, 6) : c.Id)</td>
                                <td>@c.Titulo</td>
                                <td>@(c.Autor?.Nome ?? "-")</td>
                                <td>@GetStatusTexto(c.Status)</td>
                                <td>@GetPrioridadeTexto(c.Prioridade)</td>
                                <td>@(c.Tecnico?.Nome ?? "-")</td>
                                <td>
                                    <button class="btn btn-danger btn-sm" @onclick="() => ConfirmRemoverChamado(c.Id)">Excluir</button>
                                    <button class="btn btn-primary btn-sm" @onclick="() => AbrirComentarChamado(c)">Comentar</button>
                                    <button class="btn btn-warning btn-sm" @onclick="() => FecharChamado(c.Id)">Fechar</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="() => CancelarChamado(c.Id)">Cancelar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (AbaSelecionada == 2)
        {
            <div class="card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold">👥 Usuários</h5>
                    <button class="btn btn-success btn-sm" @onclick="AbrirModalCriarUsuario">Criar Usuário</button>
                </div>

                <table class="table table-striped text-center">
                    <thead class="table-secondary">
                        <tr>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Tipo</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Usuarios)
                        {
                            <tr>
                                <td>@u.Nome</td>
                                <td>@u.Email</td>
                                <td>@u.Tipo</td>
                                <td>@(u.Ativo ? "Ativo" : "Inativo")</td>
                                <td>
                                    <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalUsuario(u)">Editar</button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => ConfirmRemoverUsuario(u.Id)">Excluir</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (AbaSelecionada == 3)
        {
            <div class="card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold">🏷️ Categorias</h5>
                    <button class="btn btn-success btn-sm" @onclick="AbrirModalCriarCategoria">Criar Categoria</button>
                </div>

                @foreach (var c in Categorias)
                {
                    <div class="border p-2 rounded mb-2 d-flex justify-content-between align-items-center">
                        @c.Nome
                        <div>
                            <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalCategoria(c)">Editar</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => ConfirmRemoverCategoria(c.Id)">Excluir</button>
                        </div>
                    </div>
                }
            </div>
        }

        @if (AbaSelecionada == 4)
        {
            <div class="card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold">🏢 Departamentos</h5>
                    <button class="btn btn-success btn-sm" @onclick="AbrirModalCriarDepartamento">Criar Departamento</button>
                </div>

                @foreach (var d in Departamentos)
                {
                    <div class="border p-2 rounded mb-2">
                        <strong>@d.Nome</strong>
                        <ul>
                            @foreach (var u in d.Usuarios)
                            {
                                <li>@u.Nome</li>
                            }
                        </ul>
                        <div>
                            <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalDepartamento(d)">Editar</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => ConfirmRemoverDepartamento(d.Id)">Excluir</button>
                        </div>
                    </div>
                }
            </div>
        }

        @if (AbaSelecionada == 5)
        {
            <div class="card p-4">
                <h5 class="fw-bold mb-3">🛡️ Roles</h5>
                <p class="text-muted">Roles são somente leitura via API (só GET está exposto).</p>
                @foreach (var r in Roles)
                {
                    <div class="border p-2 rounded mb-2 d-flex justify-content-between align-items-center">
                        @r.Nome
                        <div>
                            <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalRole(r)">Editar (se suportado)</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => ConfirmRemoverRole(r.Id)">Excluir (se suportado)</button>
                        </div>
                    </div>
                }
            </div>
        }

        @if (AbaSelecionada == 6)
        {
            <div class="card p-4">
                <h5 class="fw-bold mb-3">📊 Relatórios</h5>
                <p>Em breve: dashboards com SLA, técnicos livres, chamados urgentes e muito mais.</p>
            </div>
        }

    </main>
</div>

<!-- MODAIS -->
@if (ModalUsuarioAtivo)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h5>@(IsCreatingUsuario ? "Criar Usuário" : "Editar Usuário")</h5>

            <input class="form-control mb-2" placeholder="Nome" @bind="UsuarioModal.Nome" />
            <input class="form-control mb-2" placeholder="Email" @bind="UsuarioModal.Email" />
            @if (IsCreatingUsuario)
            {
                <input class="form-control mb-2" placeholder="Senha" type="password" @bind="UsuarioModal.Senha" />
            }
            <select class="form-select mb-2" @bind="UsuarioModal.Tipo">
                @foreach (var r in Roles) { <option value="@r.Nome">@r.Nome</option> }
            </select>

            <select class="form-select mb-2" @bind="UsuarioModal.DepartamentoId">
                <option value="">-- Departamento --</option>
                @foreach (var d in Departamentos) { <option value="@d.Id">@d.Nome</option> }
            </select>

            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" @bind="UsuarioModal.Ativo" />
                <label class="form-check-label">Ativo</label>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-success" @onclick="SalvarUsuario">Salvar</button>
                <button class="btn btn-secondary" @onclick="() => ModalUsuarioAtivo = false">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (ModalCategoriaAtivo)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h5>@(IsCreatingCategoria ? "Criar Categoria" : "Editar Categoria")</h5>
            <input class="form-control mb-2" placeholder="Nome" @bind="CategoriaModal.Nome" />
            <div class="d-flex gap-2">
                <button class="btn btn-success" @onclick="SalvarCategoria">Salvar</button>
                <button class="btn btn-secondary" @onclick="() => ModalCategoriaAtivo=false">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (ModalDepartamentoAtivo)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h5>@(IsCreatingDepartamento ? "Criar Departamento" : "Editar Departamento")</h5>
            <input class="form-control mb-2" placeholder="Nome" @bind="DepartamentoModal.Nome" />
            <div class="d-flex gap-2">
                <button class="btn btn-success" @onclick="SalvarDepartamento">Salvar</button>
                <button class="btn btn-secondary" @onclick="() => ModalDepartamentoAtivo=false">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (ModalRoleAtivo)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h5>Editar Role</h5>
            <input class="form-control mb-2" placeholder="Nome" @bind="RoleModal.Nome" />
            <div class="d-flex gap-2">
                <button class="btn btn-success" @onclick="SalvarRole">Salvar</button>
                <button class="btn btn-secondary" @onclick="() => ModalRoleAtivo=false">Cancelar</button>
            </div>
        </div>
    </div>
}

@code {

    int AbaSelecionada = 0;

    List<ChamadoDTO> Chamados { get; set; } = new();
    List<UsuarioDTO> Usuarios { get; set; } = new();
    List<CategoriaDTO> Categorias { get; set; } = new();
    List<DepartamentoDTO> Departamentos { get; set; } = new();
    List<RoleDTO> Roles { get; set; } = new();

    // MODAIS + flags
    bool ModalUsuarioAtivo = false;
    bool IsCreatingUsuario = false;
    UsuarioModalModel UsuarioModal = new();

    bool ModalCategoriaAtivo = false;
    bool IsCreatingCategoria = false;
    CategoriaDTO CategoriaModal = new();

    bool ModalDepartamentoAtivo = false;
    bool IsCreatingDepartamento = false;
    DepartamentoDTO DepartamentoModal = new();

    bool ModalRoleAtivo = false;
    RoleDTO RoleModal = new();

    // DTOs (leves, focados no front)
    public class ChamadoDTO
    {
        public string Id { get; set; } = "";
        public string Titulo { get; set; } = "";
        public string Descricao { get; set; } = "";
        public int Prioridade { get; set; }
        public int Status { get; set; }
        public Autor Autor { get; set; } = new();
        public Tecnico Tecnico { get; set; } = new();
        public CategoriaMini Categoria { get; set; } = new();
        public List<MensagemDTO> Mensagens { get; set; } = new();
    }

    public class Autor { public string Id { get; set; } = ""; public string Nome { get; set; } = ""; }
    public class Tecnico { public string Id { get; set; } = ""; public string Nome { get; set; } = ""; }
    public class CategoriaMini { public string Nome { get; set; } = ""; }
    public class MensagemDTO { public string Id { get; set; } = ""; public Autor Autor { get; set; } = new(); public DateTime DataHoraMensagem { get; set; } public string Texto { get; set; } = ""; }

    public class UsuarioDTO
    {
        public string Id { get; set; } = "";
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Tipo { get; set; } = "Usuario";
        public bool Ativo { get; set; } = true;
    }

    // Modelo usado no modal de criação/edição (inclui senha e ids)
    public class UsuarioModalModel
    {
        public string Id { get; set; } = "";
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Senha { get; set; } = "";
        public string Tipo { get; set; } = "COLABORADOR"; // role name
        public bool Ativo { get; set; } = true;
        public string DepartamentoId { get; set; } = "";
        public string RoleId { get; set; } = "";
    }

    public class CategoriaDTO { public string Id { get; set; } = ""; public string Nome { get; set; } = ""; }
    public class DepartamentoDTO { public string Id { get; set; } = ""; public string Nome { get; set; } = ""; public List<UsuarioDTO> Usuarios { get; set; } = new(); }
    public class RoleDTO { public string Id { get; set; } = ""; public string Nome { get; set; } = ""; }

    // ============================== TOKEN ==============================
    async Task InjetarToken()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");

            if (string.IsNullOrEmpty(token))
            {
                Nav.NavigateTo("/login", true);
                return;
            }

            if (!Http.DefaultRequestHeaders.Contains("Authorization"))
                Http.DefaultRequestHeaders.Add("Authorization", $"Bearer {token}");
        }
        catch
        {
            Nav.NavigateTo("/login", true);
        }
    }

    // ============================== CICLO DE VIDA ==============================
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InjetarToken();
            await LoadAllData();
        }
    }

    async Task LoadAllData()
    {
        await LoadChamados();
        await LoadUsuarios();
        await LoadCategorias();
        await LoadDepartamentos();
        await LoadRoles();
    }

    // ============================== LOADS ====================================
    async Task LoadChamados()
    {
        try
        {
            var res = await Http.GetAsync("Chamados?paginaAtual=0&tamanho=900");
            if (res.IsSuccessStatusCode)
            {
                Chamados = await res.Content.ReadFromJsonAsync<List<ChamadoDTO>>() ?? new();
            }
            else if (res.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                await JS.InvokeVoidAsync("alert", "Sessão expirada. Faça login novamente.");
                Nav.NavigateTo("/login", true);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao carregar chamados: {ex.Message}");
        }

        StateHasChanged();
    }

    async Task LoadUsuarios()
    {
        try
        {
            var res = await Http.GetAsync("Usuario");
            if (res.IsSuccessStatusCode)
                Usuarios = await res.Content.ReadFromJsonAsync<List<UsuarioDTO>>() ?? new();
            else if (res.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Nav.NavigateTo("/login", true);
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Erro ao carregar usuários: {res.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao carregar usuários: {ex.Message}");
        }
    }

    async Task LoadCategorias()
    {
        try
        {
            var res = await Http.GetAsync("Categoria");
            if (res.IsSuccessStatusCode)
            {
                // Nota: seu controller retorna resultado.Items — mas aqui pedimos lista direta
                Categorias = await res.Content.ReadFromJsonAsync<List<CategoriaDTO>>() ?? new();
            }
            else if (res.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Nav.NavigateTo("/login", true);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao carregar categorias: {ex.Message}");
        }
    }

    async Task LoadDepartamentos()
    {
        try
        {
            var res = await Http.GetAsync("Departamento");
            if (res.IsSuccessStatusCode)
                Departamentos = await res.Content.ReadFromJsonAsync<List<DepartamentoDTO>>() ?? new();
            else if (res.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Nav.NavigateTo("/login", true);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao carregar departamentos: {ex.Message}");
        }
    }

    async Task LoadRoles()
    {
        try
        {
            var res = await Http.GetAsync("Role");
            if (res.IsSuccessStatusCode)
                Roles = await res.Content.ReadFromJsonAsync<List<RoleDTO>>() ?? new();
            else if (res.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Nav.NavigateTo("/login", true);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao carregar roles: {ex.Message}");
        }
    }

    // ============================== AÇÕES CHAMADOS ==============================
    async Task AbrirComentarChamado(ChamadoDTO c)
    {
        try
        {
            var comentario = await JS.InvokeAsync<string>("prompt", "Digite seu comentário:");
            if (!string.IsNullOrWhiteSpace(comentario))
            {
                var patchData = new { texto = comentario };
                var res = await Http.PatchAsync($"Chamados/{c.Id}/comentar", JsonContent.Create(patchData));
                if (res.IsSuccessStatusCode) await LoadChamados();
                else await JS.InvokeVoidAsync("alert", $"Erro ao comentar: {res.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao comentar: {ex.Message}");
        }
    }

    async Task FecharChamado(string id)
    {
        try
        {
            var res = await Http.PatchAsync($"Chamados/{id}/fechar-chamado", null);
            if (res.IsSuccessStatusCode) await LoadChamados();
            else await JS.InvokeVoidAsync("alert", $"Erro ao fechar chamado: {res.StatusCode}");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao fechar chamado: {ex.Message}");
        }
    }

    async Task CancelarChamado(string id)
    {
        try
        {
            var res = await Http.PatchAsync($"Chamados/{id}/cancelar", null);
            if (res.IsSuccessStatusCode) await LoadChamados();
            else await JS.InvokeVoidAsync("alert", $"Erro ao cancelar chamado: {res.StatusCode}");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao cancelar chamado: {ex.Message}");
        }
    }

    async Task ConfirmRemoverChamado(string id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir este chamado? Esta ação é irreversível.");
        if (ok) await RemoverChamado(id);
    }

    async Task RemoverChamado(string id)
    {
        try
        {
            var res = await Http.DeleteAsync($"Chamados/{id}");
            if (res.IsSuccessStatusCode) await LoadChamados();
            else if (res.StatusCode == System.Net.HttpStatusCode.Forbidden)
                await JS.InvokeVoidAsync("alert", "Você não tem permissão para remover este chamado.");
            else
                await JS.InvokeVoidAsync("alert", $"Erro ao remover chamado: {res.StatusCode}");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao remover chamado: {ex.Message}");
        }
    }

    // ============================== CRUD GENÉRICOS ==============================
    async Task ConfirmRemoverUsuario(string id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir este usuário?");
        if (ok) await RemoverUsuario(id);
    }

    async Task RemoverUsuario(string id)
    {
        try
        {
            var res = await Http.DeleteAsync($"Usuario/{id}");
            if (res.IsSuccessStatusCode) await LoadUsuarios();
            else if (res.StatusCode == System.Net.HttpStatusCode.Conflict)
                await JS.InvokeVoidAsync("alert", "Não é possível remover o usuário devido a integridade referencial.");
            else
                await JS.InvokeVoidAsync("alert", $"Erro ao remover usuário: {res.StatusCode}");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao remover usuário: {ex.Message}");
        }
    }

    async Task ConfirmRemoverCategoria(string id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir esta categoria?");
        if (ok) await RemoverCategoria(id);
    }

    async Task RemoverCategoria(string id)
    {
        try
        {
            var res = await Http.DeleteAsync($"Categoria/{id}");
            if (res.IsSuccessStatusCode) await LoadCategorias();
            else if (res.StatusCode == System.Net.HttpStatusCode.Conflict)
                await JS.InvokeVoidAsync("alert", "Não é possível remover a categoria (integridade - 409).");
            else
                await JS.InvokeVoidAsync("alert", $"Erro ao remover categoria: {res.StatusCode}");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao remover categoria: {ex.Message}");
        }
    }

    async Task ConfirmRemoverDepartamento(string id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir este departamento?");
        if (ok) await RemoverDepartamento(id);
    }

    async Task RemoverDepartamento(string id)
    {
        try
        {
            var res = await Http.DeleteAsync($"Departamento/{id}");
            if (res.IsSuccessStatusCode) await LoadDepartamentos();
            else if (res.StatusCode == System.Net.HttpStatusCode.Conflict)
                await JS.InvokeVoidAsync("alert", "Não é possível remover o departamento (integridade - 409).");
            else
                await JS.InvokeVoidAsync("alert", $"Erro ao remover departamento: {res.StatusCode}");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao remover departamento: {ex.Message}");
        }
    }

    async Task ConfirmRemoverRole(string id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir esta role?");
        if (ok) await RemoverRole(id);
    }

    async Task RemoverRole(string id)
    {
        try
        {
            var res = await Http.DeleteAsync($"Role/{id}");
            if (res.IsSuccessStatusCode) await LoadRoles();
            else if (res.StatusCode == System.Net.HttpStatusCode.Conflict)
                await JS.InvokeVoidAsync("alert", "Não é possível remover a role (integridade - 409).");
            else
                await JS.InvokeVoidAsync("alert", $"Erro ao remover role: {res.StatusCode}");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao remover role: {ex.Message}");
        }
    }

