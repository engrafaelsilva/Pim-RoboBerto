    // ============================== TOKEN ==============================
    async Task InjetarToken()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");

            if (string.IsNullOrWhiteSpace(token))
            {
                Nav.NavigateTo("/login", true);
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);
        }
        catch
        {
            Nav.NavigateTo("/login", true);
        }
    }

    // ============================== CICLO DE VIDA ==============================
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InjetarToken();
            await LoadAllData();
        }
    }

    async Task LoadAllData()
    {
        try
        {
            IsLoadingAllData = true;
            LoadingText = "Atualizando dados do painel...";
            UiStatusMessage = null;

            await LoadChamados();
            await LoadUsuarios();
            await LoadCategorias();
            await LoadDepartamentos();
            await LoadRoles();
            ShowSuccess("Dados atualizados com sucesso.");
        }
        finally
        {
            IsLoadingAllData = false;
            LoadingText = "";
            StateHasChanged();
        }
    }

    // ============================== LOADS ====================================
    async Task LoadChamados()
    {
        IsLoadingChamados = true;
        LoadingText = "Carregando chamados...";
        StateHasChanged();

        try
        {
            try
            {
                var res = await Http.GetAsync("Chamados?paginaAtual=0&tamanho=900");
                if (res.IsSuccessStatusCode)
                {
                    Chamados = await res.Content.ReadFromJsonAsync<List<ChamadoDTO>>() ?? new();
                }
                else if (res.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    ShowError("Sessão expirada. Faça login novamente.");
                    Nav.NavigateTo("/login", true);
                }
                else
                {
                    ShowError($"Erro ao carregar chamados: {res.StatusCode}");
                }
            }
            catch (Exception ex)
            {
                ShowError($"Erro ao carregar chamados: {ex.Message}");
            }
        }
        finally
        {
            IsLoadingChamados = false;
            LoadingText = IsLoadingAllData ? "Atualizando dados do painel..." : "";
            StateHasChanged();
        }
    }

