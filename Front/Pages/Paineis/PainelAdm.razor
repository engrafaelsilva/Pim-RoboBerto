    void AbrirModalCriarUsuario()
    {
        IsCreatingUsuario = true;
        UsuarioModal = new UsuarioModalModel();
        ModalUsuarioAtivo = true;
    }

    async Task SalvarUsuario()
    {
        try
        {
            if (IsCreatingUsuario)
            {
                // Payload para criação — ajuste os nomes caso seu backend precise outros nomes
                var payload = new
                {
                    Nome = UsuarioModal.Nome,
                    Email = UsuarioModal.Email,
                    Senha = UsuarioModal.Senha,           // backend espera campo senha
                    DepartamentoId = string.IsNullOrEmpty(UsuarioModal.DepartamentoId) ? (string?)null : UsuarioModal.DepartamentoId,
                    RoleId = Roles.FirstOrDefault(r => r.Nome == UsuarioModal.Tipo)?.Id
                };

                var res = await Http.PostAsJsonAsync("Usuario", payload);
                if (res.IsSuccessStatusCode)
                {
                    ModalUsuarioAtivo = false;
                    await LoadUsuarios();
                }
                else if (res.StatusCode == System.Net.HttpStatusCode.Conflict)
                {
                    await JS.InvokeVoidAsync("alert", "Email já cadastrado (409).");
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", $"Erro ao criar usuário: {res.StatusCode}");
                }
            }
            else
            {
                // Atualização — tentamos colocar um payload compatível com o que seu serviço usa para atualizar
                var payload = new
                {
                    Id = UsuarioModal.Id,
                    Nome = UsuarioModal.Nome,
                    Email = UsuarioModal.Email,
                    Tipo = UsuarioModal.Tipo,
                    Ativo = UsuarioModal.Ativo,
                    Departamento = new { Nome = Departamentos.FirstOrDefault(d => d.Id == UsuarioModal.DepartamentoId)?.Nome ?? "" }
                };

                var res = await Http.PutAsJsonAsync($"Usuario/{UsuarioModal.Id}", payload);
                if (res.IsSuccessStatusCode)
                {
                    ModalUsuarioAtivo = false;
                    await LoadUsuarios();
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", $"Erro ao atualizar usuário: {res.StatusCode}");
                }
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao salvar usuário: {ex.Message}");
        }
    }

