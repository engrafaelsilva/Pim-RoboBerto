    }

    async Task SalvarUsuario()
    {
        try
        {
            if (IsCreatingUsuario)
            {
                // POST /Usuario
                var payload = new
                {
                    Nome = UsuarioModal.Nome,
                    Email = UsuarioModal.Email,
                    Senha = UsuarioModal.Senha,
                    Tipo = UsuarioModal.Tipo,
                    Ativo = UsuarioModal.Ativo,
                    DepartamentoId = string.IsNullOrEmpty(UsuarioModal.DepartamentoId)
                        ? (string?)null
                        : UsuarioModal.DepartamentoId
                };

                var res = await Http.PostAsJsonAsync("Usuario", payload);
                if (res.IsSuccessStatusCode)
                {
                    ModalUsuarioAtivo = false;
                    await LoadAllData();
                    ShowSuccess("Usuário criado com sucesso.");
                }
                else if (res.StatusCode == System.Net.HttpStatusCode.Conflict)
                {
                    var body = await res.Content.ReadAsStringAsync();
                    ShowError($"Email já cadastrado (409).\n{body}");
                }
                else if (res.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    var body = await res.Content.ReadAsStringAsync();
                    ShowError($"Requisição inválida ao criar usuário (400).\n{body}");
                }
                else
                {
                    ShowError($"Erro ao criar usuário: {res.StatusCode}");
                }
            }
            else
            {
                // PUT /Usuario/{id}
                var payload = new
                {
                    Nome = UsuarioModal.Nome,
                    Email = UsuarioModal.Email,
                    Tipo = UsuarioModal.Tipo,
                    Ativo = UsuarioModal.Ativo,
                    DepartamentoId = string.IsNullOrEmpty(UsuarioModal.DepartamentoId)
                        ? (string?)null
                        : UsuarioModal.DepartamentoId
                };

                var res = await Http.PutAsJsonAsync($"Usuario/{UsuarioModal.Id}", payload);
                if (res.IsSuccessStatusCode)
                {
                    ModalUsuarioAtivo = false;
                    await LoadAllData();
                    ShowSuccess("Usuário atualizado com sucesso.");
                }
                else if (res.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    var body = await res.Content.ReadAsStringAsync();
                    ShowError($"Requisição inválida ao atualizar usuário (400).\n{body}");
                }
                else
                {
                    ShowError($"Erro ao atualizar usuário: {res.StatusCode}");
                }
            }
        }
        catch (Exception ex)
        {
            ShowError($"Erro ao salvar usuário: {ex.Message}");
        }
    }

