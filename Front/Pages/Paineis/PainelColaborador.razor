    // ================= CHAT TEMPO REAL (SignalR) ====================
    async Task GarantirConexaoChat()
    {
        if (_hubConnection is { State: HubConnectionState.Connected })
            return;

        if (!await InjetarToken()) return;

        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
        if (string.IsNullOrWhiteSpace(token))
        {
            await JS.InvokeVoidAsync("alert", "Sessão expirada. Faça login novamente.");
            Navigation.NavigateTo("/login");
            return;
        }

        var apiBase = Http.BaseAddress?.ToString().TrimEnd('/');
        if (string.IsNullOrEmpty(apiBase))
        {
            await JS.InvokeVoidAsync("alert", "BaseAddress da API não configurada no HttpClient.");
            return;
        }

        var hubUrl = $"{apiBase}/hubs/chat";

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl, options =>
            {
                options.AccessTokenProvider = () => Task.FromResult<string?>(token);
            })
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<Guid, MensagemDTO>("ReceberMensagem", (chamadoId, msg) =>
        {
            if (chamadoId != ChatChamadoId)
                return;

            // marca minhas mensagens como lidas
            foreach (var m in ChatMensagens.Where(x => x.Remetente == "usuario"))
                m.Lida = true;

            ChatMensagens.Add(new Mensagem
            {
                Remetente = "tecnico",
                Texto = msg.Texto
            });

            InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hubConnection.StartAsync();
            await _hubConnection.InvokeAsync("EntrarNoGrupoDoChamado", ChatChamadoId);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao conectar no chat em tempo real: {ex.Message}");
        }
    }

    async Task EnviarMensagemChat()
    {
        if (string.IsNullOrWhiteSpace(MensagemChat))
            return;

        if (_hubConnection is null || _hubConnection.State != HubConnectionState.Connected)
        {
            await GarantirConexaoChat();

            if (_hubConnection is null || _hubConnection.State != HubConnectionState.Connected)
            {
                await JS.InvokeVoidAsync("alert", "Não foi possível conectar ao chat em tempo real.");
                return;
            }
        }

        var texto = MensagemChat.Trim();
        MensagemChat = "";

        ChatMensagens.Add(new Mensagem
        {
            Remetente = "usuario",
            Texto = texto,
            Lida = false
        });
        await InvokeAsync(StateHasChanged);

        try
        {
            await _hubConnection.InvokeAsync("EnviarMensagemParaGrupo", ChatChamadoId, texto);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao enviar mensagem no chat: {ex.Message}");
        }
    }

    void HandleChatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            _ = EnviarMensagemChat();
        }
    }

    void AbrirChatBootPara(Guid id)
    {
        _ = JS.InvokeVoidAsync("localStorage.setItem", "chamadoId", id.ToString());
        _ = JS.InvokeVoidAsync("localStorage.setItem", "chatPergunta", Chamados.FirstOrDefault(c => c.Id == id)?.Descricao ?? "");
        var sugest = Chamados.FirstOrDefault(c => c.Id == id)?.SugestaoGemini ?? "";
        if (!string.IsNullOrEmpty(sugest))
            _ = JS.InvokeVoidAsync("localStorage.setItem", "chatResposta", sugest);
        Navigation.NavigateTo("/chatboot");
    }

