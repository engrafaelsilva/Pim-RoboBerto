            else
            {
                await JS.InvokeVoidAsync("alert", $"Erro ao confirmar sugestão: {resp.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao confirmar sugestão: {ex.Message}");
        }
