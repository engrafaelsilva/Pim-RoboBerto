@page "/painelcolaborador"

@using System.Text.Json
@using System.Text.Json.Serialization
@using Front.Pages.Modais.Colaborador
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Web

@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Painel do Colaborador</PageTitle>

<link rel="stylesheet" href="css/PainelColaborador.css" />
<link rel="stylesheet" href="css/Chat.css" />

<div class="layout">

    <aside class="sidebar">
        <h2 class="logo">Painel do Colaborador</h2>

        <nav class="menu">
            <button class="menu-item" @onclick="() => AbaSelecionada = 0">Home</button>
            <button class="menu-item" @onclick="() => AbrirNovoChamado()">Abrir Chamado</button>
            <button class="menu-item" @onclick="() => { AbaSelecionada = 2; _ = CarregarMeusChamados(); }">Meus Chamados</button>
            <button class="menu-item" @onclick="AbrirChatGeral">Conversar com Técnico</button>
            <button class="menu-item logout" @onclick="Logout">Sair</button>
        </nav>
    </aside>

    <main class="conteudo">
        @if (AbaSelecionada == 0)
        {
            <section class="card">
                <h1>Seja bem-vindo(a), @UsuarioNome!</h1>
                <p>Aqui você poderá abrir um chamado, acompanhar o status do chamado e conversar com um técnico.</p>
            </section>
        }

        @if (AbaSelecionada == 1)
        {
            <section class="card">
                <h3>Abrir Novo Chamado</h3>

                <div class="form-grid">
                    <div class="form-control">
                        <label>Título</label>
                        <input class="input" @bind="NovoChamado.Titulo" placeholder="Informe o título do chamado" />
                    </div>

                    <div class="form-control full">
                        <label>Descrição</label>
                        <textarea class="textarea" rows="4" @bind="NovoChamado.Descricao" placeholder="Informe a descrição do chamado"></textarea>
                    </div>

                    <div class="form-control">
                        <label>Prioridade</label>
                        <select class="input" @bind="NovoChamado.Prioridade">
                            <option>Baixa</option>
                            <option>Média</option>
                            <option>Alta</option>
                        </select>
                    </div>

                    <div class="form-control">
                        <label>Categoria</label>
                        <select class="input" @bind="NovoChamado.Categoria">
                            <option>Suporte</option>
                            <option>Financeiro</option>
                            <option>Infraestrutura</option>
                        </select>
                    </div>
                </div>

                <div class="btn-row">
                    <button class="btn secondary" @onclick="LimparFormulario" disabled="@isSending">Limpar</button>
                    <button class="btn primary" @onclick="EnviarChamado" disabled="@isSending">@((isSending) ? "Enviando..." : "Enviar")</button>
                </div>
            </section>
        }

        @if (AbaSelecionada == 2)
        {
            <section class="card">
                <h3>Meus Chamados</h3>

                <div class="chamados-controls-bar">
                    <button class="btn btn-refresh" @onclick="() => CarregarMeusChamados(paginaAtual, tamanhoPagina)">
                        <i class="fas fa-sync-alt"></i> Atualizar Lista
                    </button>

                    <div class="pagination-group">
                        <button class="btn btn-control" @onclick="() => ChangePage(-1)" disabled="@(paginaAtual == 0)">
                            <i class="fas fas-chevron-left"></i> Anterior
                        </button>
                        <span class="page-info">Página @((paginaAtual + 1))</span>
                        <button class="btn btn-control" @onclick="() => ChangePage(1)">
                            Próxima <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>

                <hr class="separator-list" />

                @if (isLoadingChamados)
                {
                    <p class="msg-loading"><i class="fas fa-spinner fa-spin"></i> Carregando chamados...</p>
                }
                else if (Chamados.Count == 0)
                {
                    <div class="lista-vazia">
                        <p class="msg-empty">Nenhum chamado encontrado. 🎉</p>
                        <button class="btn-primary" @onclick="() => AbrirNovoChamado()">Abrir Novo Chamado</button>
                    </div>
                }
                else
                {
                    <div class="lista-chamados-moderna">
                        @foreach (var c in Chamados)
                        {
                            <div class="chamado-ticket status-@c.Status.Replace(" ", "-").ToLower()">

                                <div class="ticket-info">
                                    <p class="descricao-label">Título do chamado:</p>
                                    <h4 class="ticket-title">@c.Titulo</h4>
                                    <p class="descricao-label">Descrição do chamado:</p>
                                    <p class="ticket-description">@c.Descricao</p>
                                    <p class="ia-suggestion-label">Comentário:</p>
                                    <p class="ticket-ai-suggestion">Aqui vai o comentário do chamado...</p>
                                </div>

                                <div class="ticket-meta">
                                    <span class="meta-item-data">Data de abertura: <br /> <strong>@c.DataAbertura.ToString("g")</strong></span>
                                    <span class="meta-item-data">Prioridade: <br /> <strong>@c.Prioridade</strong></span>
                                    <span class="meta-item-data">Status do chamado: <br /> <strong>@c.Status</strong></span>
                                </div>

                                <div class="ticket-actions">
                                    <button class="btn btn-details" @onclick="() => VerDetalhes(c.Id)">
                                        <i class="fas fa-eye"></i> Detalhes
                                    </button>
                                    <button class="btn btn-comment" @onclick="() => AbrirModalComentario(c.Id)">
                                        <i class="fas fa-comment"></i> Comentar
                                    </button>

                                    @if (c.Status == "Fechado" || c.Status == "Resolvido")
                                    {
                                        <button class="btn btn-reopen" @onclick="() => ReabrirChamado(c.Id)">
                                            <i class="fas fa-undo"></i> Reabrir
                                        </button>
                                    }

                                    @if (c.Status == "Aguardando Confirmação")
                                    {
                                        <button class="btn btn-confirm" @onclick="() => ModalConfirmacao.Show(c.SugestaoGemini, c.Id)">
                                            <i class="fas fa-check-circle"></i> Confirmar Sugestão
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }

        @if (AbaSelecionada == 3)
        {
            <section class="card chat-card">
                <div class="chat-header">
                    <h3>@TituloChat</h3>
                    <p class="subtitle">@SubtituloChat</p>
                </div>

                <div class="chat-window" id="chatWindow">
                    @foreach (var m in ChatMensagens)
                    {
                        var souEu = m.Remetente == "usuario";

                        <div class="chat-row @(souEu ? "me" : "other")">
                            @if (!souEu)
                            {
                                <div class="chat-avatar">👨‍🔧</div>
                            }

                            <div class="chat-bubble">
                                <span>@m.Texto</span>

                                @if (souEu)
                                {
                                    <span class="check-icon @(m.Lida ? "read" : "")">✓✓</span>
                                }
                            </div>

                            @if (souEu)
                            {
                                <div class="chat-avatar">🧑</div>
                            }
                        </div>
                    }
                </div>

                <div class="chat-input-row">
                    <input class="chat-input"
                           @bind="MensagemChat"
                           placeholder="Digite sua mensagem..."
                           @onkeydown="HandleChatKeyDown"
                           @onkeydown:preventDefault="@(MensagemChat?.Length > 0)" />

                    <button class="chat-send-btn" @onclick="EnviarMensagemChat">Enviar</button>
                </div>
            </section>
        }

        @if (MostrarDetalhes && ChamadoDetalhe != null)
        {
            <section class="card" style="margin-top:16px;">
                <h4>Detalhes do Chamado</h4>
                <p><strong>Título:</strong> @ChamadoDetalhe.Titulo</p>
                <p><strong>Descrição:</strong> @ChamadoDetalhe.Descricao</p>
                <p><strong>Técnico:</strong> @(string.IsNullOrWhiteSpace(ChamadoDetalhe.TecnicoNome) ? "—" : ChamadoDetalhe.TecnicoNome)</p>
                <p><strong>Sugestão IA:</strong> @(!string.IsNullOrEmpty(ChamadoDetalhe.SugestaoGemini) ? ChamadoDetalhe.SugestaoGemini : "—")</p>

                <div style="margin-top:8px;">
                    <button class="btn-primary" @onclick="() => ModalConfirmacao.Show(ChamadoDetalhe.SugestaoGemini, ChamadoDetalhe.Id)">Confirmar Sugestão</button>
                    <button class="btn-secondary" style="margin-left:8px;" @onclick="() => ReabrirChamado(ChamadoDetalhe.Id)">Reabrir</button>
                    <button class="btn-danger" style="margin-left:8px;" @onclick="() => CancelarChamado(ChamadoDetalhe.Id)">Cancelar</button>
                    <button class="btn-secondary" style="margin-left:8px;" @onclick="() => AbrirChatBootPara(ChamadoDetalhe.Id)">Abrir Chat</button>
                </div>

                <h5 style="margin-top:12px;">Mensagens</h5>
                @if (ChamadoDetalhe.Mensagens?.Any() != true)
                {
                    <p>Nenhuma mensagem.</p>
                }
                else
                {
                    @foreach (var msg in ChamadoDetalhe.Mensagens)
                    {
                        <div style="border-left:3px solid #eee; padding:8px; margin-bottom:6px;">
                            <small>@msg.AutorNome • @msg.DataHoraMensagem.ToString("g")</small>
                            <div>@msg.Texto</div>
                        </div>
                    }
                }

                <div style="margin-top:10px;">
                    <label>Enviar comentário</label>
                    <textarea class="textarea" rows="3" @bind="ComentarioTexto"></textarea>
                    <div style="margin-top:8px;">
                        <button class="btn-secondary" @onclick="FecharDetalhes">Fechar</button>
                        <button class="btn-primary" style="margin-left:8px;" @onclick="EnviarComentario" disabled="@isSendingComentario">
                            @(isSendingComentario ? "Enviando..." : "Enviar comentário")
                        </button>
                    </div>
                </div>
            </section>
        }

        <ModalConfirmacaoIA @ref="ModalConfirmacao" OnConfirmacao="ProcessarConfirmacaoIA" OnIrParaChat="IrParaChatDoModal" />
        <ModalComentar @ref="ModalComentarRef"
                       OnEnviar="EnviarComentarioModal"
                       OnFechar="FecharModalComentario" />
    </main>
</div>

@code {
    // ======= Modelo de mensagem do chat =======
    public class Mensagem
    {
        public string Remetente { get; set; } = "usuario";
        public string Texto { get; set; } = "";
        public bool Lida { get; set; } = false;
    }

    // Saudações / cabeçalho
    string UsuarioNome = "";
    string TituloChat = "Conversar com Técnico";
    string SubtituloChat = "Canal rápido com o suporte técnico.";

    // =============== SIGNALR / CHAT TEMPO REAL ===============
    HubConnection? _hubConnection;

    // Sala "geral" compartilhada entre colaborador e técnico
    readonly Guid ChatChamadoId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    // Modal para comentar no chamado
    ModalComentar? ModalComentarRef;
    Guid ChamadoIdSelecionadoParaComentario;

    void AbrirModalComentario(Guid id)
    {
        ChamadoIdSelecionadoParaComentario = id;
        ModalComentarRef?.Show();
    }

    void FecharModalComentario()
    {
        ChamadoIdSelecionadoParaComentario = Guid.Empty;
    }

    async Task EnviarComentarioModal(string texto)
    {
        if (ChamadoIdSelecionadoParaComentario == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Nenhum chamado selecionado para comentar.");
            return;
        }

        if (string.IsNullOrWhiteSpace(texto) || texto.Trim().Length < 3)
        {
            await JS.InvokeVoidAsync("alert", "Digite um comentário com pelo menos 3 caracteres.");
            return;
        }

        if (!await InjetarToken()) return;

        try
        {
            var payload = new { texto };
            var resp = await Http.PatchAsJsonAsync($"Chamados/{ChamadoIdSelecionadoParaComentario}/comentar", payload);

            if (resp.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "Comentário enviado com sucesso.");
                ModalComentarRef?.Hide();

                if (ChamadoDetalhe != null && ChamadoDetalhe.Id == ChamadoIdSelecionadoParaComentario)
                {
                    await VerDetalhes(ChamadoIdSelecionadoParaComentario);
                }
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Erro ao enviar comentário: {resp.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao enviar comentário: {ex.Message}");
        }
    }

    // ======================= TOKEN =======================
    async Task<bool> InjetarToken()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");

        if (string.IsNullOrWhiteSpace(token))
        {
            await JS.InvokeVoidAsync("alert", "Sessão expirada. Faça login novamente.");
            Navigation.NavigateTo("/login");
            return false;
        }

        Http.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        return true;
    }

    // ================= MODELOS =================
    class ChamadoListItem
    {
        public Guid Id { get; set; }
        public string Titulo { get; set; } = "";
        public string Descricao { get; set; } = "";
        public string Prioridade { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime DataAbertura { get; set; } = DateTime.Now;
        public string SugestaoGemini { get; set; } = "";
    }

    class ChamadoDetailDTO
    {
        public Guid Id { get; set; }
        public string Titulo { get; set; } = "";
        public string Descricao { get; set; } = "";
        public string SugestaoGemini { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime DataAbertura { get; set; } = DateTime.Now;
        public List<MensagemDTO>? Mensagens { get; set; }
        public string TecnicoNome { get; set; } = "";
        public bool? SugestaoResolveu { get; set; }
    }

    class MensagemDTO
    {
        public string Texto { get; set; } = "";
        public DateTime DataHoraMensagem { get; set; } = DateTime.Now;
        public string AutorNome { get; set; } = "";
    }

    int AbaSelecionada = 0;

    public class Chamado
    {
        public string Titulo { get; set; } = "";
        public string Descricao { get; set; } = "";
        public string Prioridade { get; set; } = "Baixa";
        public string Categoria { get; set; } = "Suporte";
        public string Status { get; set; } = "Aberto";
    }

    Chamado NovoChamado = new();
    List<ChamadoListItem> Chamados = new();
    List<Mensagem> ChatMensagens = new();
    string MensagemChat = "";

    bool isSending = false;

    bool MostrarDetalhes = false;
    ChamadoDetailDTO? ChamadoDetalhe = null;
    string ComentarioTexto = "";
    bool isSendingComentario = false;

    bool isLoadingChamados = false;

    // Pagination
    int paginaAtual = 0;
    int tamanhoPagina = 10;

    ModalConfirmacaoIA? ModalConfirmacao;

    // =============== CICLO DE VIDA ===============
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var nomeBruto = await JS.InvokeAsync<string>("localStorage.getItem", "usuarioNome") ?? "";

            if (string.IsNullOrWhiteSpace(nomeBruto))
                nomeBruto = await JS.InvokeAsync<string>("localStorage.getItem", "email") ?? "";

            UsuarioNome = ExtrairPrimeiroNome(nomeBruto);
        }
        catch
        {
            UsuarioNome = "";
        }
    }

    private string ExtrairPrimeiroNome(string valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return "";

        if (valor.Contains("@"))
            valor = valor.Split('@')[0];

        var partes = valor.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        var primeiro = partes[0];

        if (primeiro.Length == 1)
            return primeiro.ToUpper();

        return char.ToUpper(primeiro[0]) + primeiro.Substring(1).ToLower();
    }

    void AbrirNovoChamado()
    {
        AbaSelecionada = 1;
    }

    async Task AbrirChatGeral()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "chamadoId");
        AbaSelecionada = 3;
        await GarantirConexaoChat();
    }

    // =================== LISTAR MEUS CHAMADOS ====================
    async Task CarregarMeusChamados(int pagina = 0, int tamanho = 10)
    {
        isLoadingChamados = true;
        Chamados.Clear();

        if (!await InjetarToken()) { isLoadingChamados = false; return; }

        try
        {
            paginaAtual = pagina;
            tamanhoPagina = tamanho;

            var resp = await Http.GetAsync($"Chamados/meus?paginaAtual={pagina}&tamanho={tamanho}");

            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var root = doc.RootElement;

                if (root.ValueKind == JsonValueKind.Array)
                {
                    foreach (var el in root.EnumerateArray())
                    {
                        var item = new ChamadoListItem();

                        if (el.TryGetProperty("id", out var idp) && idp.ValueKind == JsonValueKind.String)
                        {
                            if (Guid.TryParse(idp.GetString(), out var tmpId))
                                item.Id = tmpId;
                        }

                        if (el.TryGetProperty("titulo", out var tp)) item.Titulo = tp.GetString() ?? "";
                        if (el.TryGetProperty("descricao", out var dp)) item.Descricao = dp.GetString() ?? "";

                        if (el.TryGetProperty("status", out var sp))
                        {
                            switch (sp.ValueKind)
                            {
                                case JsonValueKind.Number:
                                    int statusInt = sp.GetInt32();
                                    item.Status = statusInt switch
                                    {
                                        0 => "Aberto",
                                        1 => "Em andamento",
                                        2 => "Fechado",
                                        3 => "Resolvido",
                                        4 => "Aguardando Confirmação",
                                        _ => "Desconhecido"
                                    };
                                    break;
                                case JsonValueKind.String:
                                    item.Status = sp.GetString() ?? "Desconhecido";
                                    break;
                            }
                        }

                        if (el.TryGetProperty("prioridade", out var pp))
                        {
                            switch (pp.ValueKind)
                            {
                                case JsonValueKind.Number:
                                    int prioridadeInt = pp.GetInt32();
                                    item.Prioridade = prioridadeInt switch
                                    {
                                        0 => "Baixa",
                                        1 => "Média",
                                        2 => "Alta",
                                        _ => "Desconhecida"
                                    };
                                    break;
                                case JsonValueKind.String:
                                    item.Prioridade = pp.GetString() ?? "Desconhecida";
                                    break;
                            }
                        }

                        if (el.TryGetProperty("dataAbertura", out var dtp) && dtp.ValueKind == JsonValueKind.String)
                        {
                            if (DateTime.TryParse(dtp.GetString(), out var tmpDt))
                                item.DataAbertura = tmpDt;
                        }

                        if (el.TryGetProperty("sugestaoGemini", out var sg) && sg.ValueKind == JsonValueKind.String)
                            item.SugestaoGemini = sg.GetString() ?? "";

                        Chamados.Add(item);
                    }
                }
            }
            else if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                await JS.InvokeVoidAsync("alert", "Não autorizado (401) — faça login.");
            }
            else
            {
                var txt = await resp.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("alert", $"Erro ao listar chamados: {resp.StatusCode}\n{txt}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao listar chamados: {ex.Message}");
        }
        finally
        {
            isLoadingChamados = false;
            StateHasChanged();
        }
    }

    void ChangePage(int delta)
    {
        var novo = paginaAtual + delta;
        if (novo < 0) novo = 0;
        paginaAtual = novo;
        _ = CarregarMeusChamados(paginaAtual, tamanhoPagina);
    }

    // =================== ENVIAR CHAMADO ====================
    async Task EnviarChamado()
    {
        if (string.IsNullOrWhiteSpace(NovoChamado.Titulo) ||
            string.IsNullOrWhiteSpace(NovoChamado.Descricao) ||
            string.IsNullOrWhiteSpace(NovoChamado.Prioridade) ||
            string.IsNullOrWhiteSpace(NovoChamado.Categoria))
        {
            await JS.InvokeVoidAsync("alert", "Preencha título, descrição, prioridade e categoria antes de enviar.");
            return;
        }

        if (!await InjetarToken()) return;

        isSending = true;

        try
        {
            int prioridadeNum = NovoChamado.Prioridade?.ToLower() switch
            {
                "baixa" => 0,
                "média" => 1,
                "media" => 1,
                "alta" => 2,
                _ => 0
            };

            var payload = new
            {
                categoria = new { nome = NovoChamado.Categoria },
                prioridade = prioridadeNum,
                titulo = NovoChamado.Titulo,
                descricao = NovoChamado.Descricao
            };

            var response = await Http.PostAsJsonAsync("Chamados", payload);

            if (response.IsSuccessStatusCode)
            {
                var respostaJson = await response.Content.ReadAsStringAsync();

                Guid criadoId = Guid.Empty;
                string sugestaoGemini = "";

                using var doc = JsonDocument.Parse(respostaJson);
                var r = doc.RootElement;

                Guid.TryParse(r.GetProperty("id").GetString(), out criadoId);
                sugestaoGemini = r.GetProperty("sugestaoGemini").GetString() ?? "";

                await JS.InvokeVoidAsync("localStorage.setItem", "chatPergunta", NovoChamado.Descricao);
                await JS.InvokeVoidAsync("localStorage.setItem", "sugestaoGemini", sugestaoGemini);
                await JS.InvokeVoidAsync("localStorage.setItem", "chamadoId", criadoId.ToString());

                LimparFormulario();

                Navigation.NavigateTo("/chatboot");
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("alert", $"Erro ao criar chamado: {response.StatusCode}\n{erro}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao enviar chamado: {ex.Message}");
        }
        finally
        {
            isSending = false;
        }
    }

    void LimparFormulario()
    {
        NovoChamado = new Chamado();
    }

    // =================== DETALHES DO CHAMADO ====================
    async Task VerDetalhes(Guid id)
    {
        if (!await InjetarToken()) return;

        MostrarDetalhes = false;
        ChamadoDetalhe = null;
        ComentarioTexto = "";

        try
        {
            var resp = await Http.GetAsync($"Chamados/{id}");
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var root = doc.RootElement;

                var det = new ChamadoDetailDTO();

                if (root.TryGetProperty("id", out var idp) && idp.ValueKind == JsonValueKind.String)
                {
                    if (Guid.TryParse(idp.GetString(), out var tmpId))
                        det.Id = tmpId;
                }

                if (root.TryGetProperty("titulo", out var tp)) det.Titulo = tp.GetString() ?? "";
                if (root.TryGetProperty("descricao", out var dp)) det.Descricao = dp.GetString() ?? "";
                if (root.TryGetProperty("sugestaoGemini", out var sg)) det.SugestaoGemini = sg.GetString() ?? "";

                if (root.TryGetProperty("status", out var st))
                {
                    if (st.ValueKind == JsonValueKind.Number)
                    {
                        det.Status = st.GetInt32() switch
                        {
                            0 => "Aberto",
                            1 => "Em andamento",
                            2 => "Fechado",
                            3 => "Resolvido",
                            4 => "Aguardando Confirmação",
                            _ => "Desconhecido"
                        };
                    }
                    else
                    {
                        det.Status = st.GetString() ?? "";
                    }
                }

                if (root.TryGetProperty("dataAbertura", out var dtp) && dtp.ValueKind == JsonValueKind.String)
                {
                    if (DateTime.TryParse(dtp.GetString(), out var tmpDt))
                        det.DataAbertura = tmpDt;
                }

                if (root.TryGetProperty("tecnico", out var t) && t.ValueKind == JsonValueKind.Object)
                {
                    if (t.TryGetProperty("nome", out var nomeP))
                        det.TecnicoNome = nomeP.GetString() ?? "";
                }

                if (root.TryGetProperty("sugestaoResolveu", out var sr) && sr.ValueKind != JsonValueKind.Null)
                {
                    if (sr.ValueKind == JsonValueKind.True || sr.ValueKind == JsonValueKind.False)
                        det.SugestaoResolveu = sr.GetBoolean();
                }

                if (root.TryGetProperty("mensagens", out var msgs) && msgs.ValueKind == JsonValueKind.Array)
                {
                    det.Mensagens = new List<MensagemDTO>();
                    foreach (var m in msgs.EnumerateArray())
                    {
                        var md = new MensagemDTO();
                        if (m.TryGetProperty("texto", out var txt)) md.Texto = txt.GetString() ?? "";

                        if (m.TryGetProperty("dataHoraMensagem", out var dt) && dt.ValueKind == JsonValueKind.String)
                        {
                            if (DateTime.TryParse(dt.GetString(), out var tmpDt2))
                                md.DataHoraMensagem = tmpDt2;
                        }

                        if (m.TryGetProperty("autor", out var autor) && autor.ValueKind == JsonValueKind.Object)
                        {
                            if (autor.TryGetProperty("nome", out var nomeP)) md.AutorNome = nomeP.GetString() ?? "";
                        }

                        det.Mensagens.Add(md);
                    }
                }

                ChamadoDetalhe = det;
                MostrarDetalhes = true;
                StateHasChanged();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Erro ao obter chamado: {resp.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao obter detalhes: {ex.Message}");
        }
    }

    void FecharDetalhes()
    {
        MostrarDetalhes = false;
        ChamadoDetalhe = null;
        ComentarioTexto = "";
    }

    // =================== COMENTAR ====================
    async Task EnviarComentario()
    {
        if (ChamadoDetalhe == null) return;
        if (string.IsNullOrWhiteSpace(ComentarioTexto))
        {
            await JS.InvokeVoidAsync("alert", "Escreva um comentário antes de enviar.");
            return;
        }

        if (!await InjetarToken()) return;

        isSendingComentario = true;
        try
        {
            var payload = new { texto = ComentarioTexto };
            var resp = await Http.PatchAsJsonAsync($"Chamados/{ChamadoDetalhe.Id}/comentar", payload);

            if (resp.IsSuccessStatusCode)
            {
                ChamadoDetalhe.Mensagens ??= new List<MensagemDTO>();
                ChamadoDetalhe.Mensagens.Add(new MensagemDTO
                {
                    Texto = ComentarioTexto,
                    DataHoraMensagem = DateTime.Now,
                    AutorNome = "Você"
                });

                ComentarioTexto = "";
                StateHasChanged();
                await JS.InvokeVoidAsync("alert", "Comentário enviado.");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Erro ao enviar comentário: {resp.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao enviar comentário: {ex.Message}");
        }
        finally
        {
            isSendingComentario = false;
        }
    }

    // =================== AÇÕES: Cancelar / Reabrir / Confirmar Sugestão ====================
    async Task CancelarChamado(Guid id)
    {
        if (!await InjetarToken()) return;

        try
        {
            var resp = await Http.PatchAsync($"Chamados/{id}/cancelar", null);
            if (resp.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "Chamado cancelado.");
                await CarregarMeusChamados(paginaAtual, tamanhoPagina);
                if (ChamadoDetalhe != null && ChamadoDetalhe.Id == id) FecharDetalhes();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Erro ao cancelar chamado: {resp.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao cancelar chamado: {ex.Message}");
        }
    }

    async Task ReabrirChamado(Guid id)
    {
        if (!await InjetarToken()) return;

        try
        {
            var resp = await Http.PatchAsync($"Chamados/{id}/reabrir", null);
            if (resp.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "Chamado reaberto.");
                await CarregarMeusChamados(paginaAtual, tamanhoPagina);
                if (ChamadoDetalhe != null && ChamadoDetalhe.Id == id) await VerDetalhes(id);
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Erro ao reabrir chamado: {resp.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao reabrir chamado: {ex.Message}");
        }
    }

    async Task ProcessarConfirmacaoIA((bool resolveu, Guid chamadoId) data)
    {
        var resolveu = data.resolveu;
        var chamadoId = data.chamadoId;

        if (!await InjetarToken()) return;

        try
        {
            var resp = await Http.PatchAsJsonAsync($"Chamados/{chamadoId}/alterar-resolveu-sugestao", resolveu);

            if (resp.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "Obrigado — sua resposta foi registrada.");

                await CarregarMeusChamados(paginaAtual, tamanhoPagina);

                if (ChamadoDetalhe != null && ChamadoDetalhe.Id == chamadoId)
                    await VerDetalhes(chamadoId);
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Erro ao confirmar sugestão: {resp.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao confirmar sugestão: {ex.Message}");
        }
    }

    async Task IrParaChatDoModal(Guid chamadoId)
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "chamadoId", chamadoId.ToString());
        }
        catch { }
