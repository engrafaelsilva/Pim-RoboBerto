@page "/paineltecnico"

@using System.Net.Http.Json
@using System.Text.Json
@using System.Threading
@using IA_RoboBerto.Models.Enums
@using Front.Pages.Modais.Tecnico
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Web;

@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http

@implements IDisposable

<PageTitle>Painel do Técnico</PageTitle>

<link rel="stylesheet" href="css/PainelTecnico.css" />
<link rel="stylesheet" href="css/ModalTecnico.css" />
<link rel="stylesheet" href="css/Chat.css" />

<div class="layout">

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="logo-area">
            <div class="logo-icon">🛠️</div>
            <div class="logo-text">
                <span class="logo-title">Painel do Técnico</span>
            </div>
        </div>

        <nav class="menu">
            <button class="menu-item @(AbaSelecionada == 0 ? "active" : "")"
                    @onclick="() => AbaSelecionada = 0">
                <span>Home</span>
            </button>

            <button class="menu-item @(AbaSelecionada == 1 ? "active" : "")"
                    @onclick="() => AbaSelecionada = 1">
                <span>Chamados</span>
                @if (CountPendentes > 0)
                {
                    <span class="menu-pill">@CountPendentes</span>
                }
            </button>

            <button class="menu-item @(AbaSelecionada == 2 ? "active" : "")"
                    @onclick="() => AbaSelecionada = 2">
                <span>Conversar com Colaborador</span>
            </button>

            <button class="menu-item logout" @onclick="Sair">
                <span>Sair</span>
            </button>
        </nav>
    </aside>

    <!-- Conteúdo -->
    <main class="conteudo">

        @* STATUS GLOBAL *@
        @if (!string.IsNullOrEmpty(UiStatusMessage))
        {
            <div class="tec-alert @(UiStatusIsError ? "tec-alert-error" : "tec-alert-success")">
                @UiStatusMessage
            </div>
        }

        @if (IsLoadingChamados)
        {
            <div class="tec-loading-bar">
                <span>@LoadingText</span>
            </div>
        }

        @* ================== HOME ================== *@
        @if (AbaSelecionada == 0)
        {
            <section class="card home-card">
                <div class="home-header">
                    <div>
                        <h1>👨‍🔧 Olá, @UsuarioAtual?.Nome!</h1>
                        <p class="home-subtitle">
                            Aqui você acompanha seus chamados, assume pendências, comenta, fecha e interage com os colaboradores.
                        </p>
                    </div>

                    <button class="btn-refresh"
                            disabled="@IsLoadingChamados"
                            @onclick="LoadChamados">
                        @(IsLoadingChamados ? "⏳ Atualizando..." : "🔄 Atualizar dados")
                    </button>
                </div>

                <div class="home-metrics">
                    <div class="metric-card metric-pendentes">
                        <div class="metric-top">
                            <span class="metric-icon">⏳</span>
                            <span class="metric-label">Pendentes</span>
                        </div>
                        <span class="metric-value">@CountPendentes</span>
                        <span class="metric-hint">Chamados aguardando técnico responsável.</span>
                    </div>

                    <div class="metric-card metric-atendimento">
                        <div class="metric-top">
                            <span class="metric-icon">🧑‍🔧</span>
                            <span class="metric-label">Meus chamados</span>
                        </div>
                        <span class="metric-value">@CountMeus</span>
                        <span class="metric-hint">Chamados em atendimento sob sua responsabilidade.</span>
                    </div>

                    <div class="metric-card metric-expirados">
                        <div class="metric-top">
                            <span class="metric-icon">⚠️</span>
                            <span class="metric-label">Expirados</span>
                        </div>
                        <span class="metric-value">@CountExpirados</span>
                        <span class="metric-hint">Chamados com SLA vencido.</span>
                    </div>

                    <div class="metric-card metric-acatados">
                        <div class="metric-top">
                            <span class="metric-icon">📌</span>
                            <span class="metric-label">Acatados</span>
                        </div>
                        <span class="metric-value">@CountAcatados</span>
                        <span class="metric-hint">Chamados que você já acatou.</span>
                    </div>
                </div>

                <div class="home-bottom">
                    <div class="home-tip">
                        <span class="tip-icon">💡</span>
                        <div>
                            <strong>Dica rápida:</strong>
                            <p>Use a aba <b>Chamados</b> para assumir novas demandas, visualizar acatados e registrar comentários diretamente na linha do tempo.</p>
                        </div>
                    </div>
                </div>
            </section>
        }

        @* ================== CHAMADOS ================== *@
        @if (AbaSelecionada == 1)
        {
            <section class="card chamados-card">
                <div class="chamados-header">
                    <div>
                        <h3>Chamados</h3>
                        <p class="subtitle">
                            Filtre pelos status nas abas abaixo e interaja com os chamados: assumir, comentar, fechar, cancelar ou marcar sugestão resolvida.
                        </p>
                    </div>

                    <button class="btn-refresh"
                            disabled="@IsLoadingChamados"
                            @onclick="LoadChamados">
                        @(IsLoadingChamados ? "⏳ Recarregando..." : "🔄 Recarregar")
                    </button>
                </div>

                <div class="tabs">
                    <button class="tab @(ActiveTab == Tab.Pendentes ? "active" : "")"
                            @onclick="() => SelectTab(Tab.Pendentes)">
                        Pendentes (@CountPendentes)
                    </button>

                    <button class="tab @(ActiveTab == Tab.Meus ? "active" : "")"
                            @onclick="() => SelectTab(Tab.Meus)">
                        Meus chamados (@CountMeus)
                    </button>

                    <button class="tab @(ActiveTab == Tab.Expirados ? "active" : "")"
                            @onclick="() => SelectTab(Tab.Expirados)">
                        Expirados (@CountExpirados)
                    </button>

                    <button class="tab @(ActiveTab == Tab.Acatados ? "active" : "")"
                            @onclick="() => SelectTab(Tab.Acatados)">
                        Acatados (@CountAcatados)
                    </button>
                </div>

                <div class="content">
                    @if (ListaCarregando)
                    {
                        <div class="loading">
                            <span class="spinner"></span>
                            <span>Carregando chamados...</span>
                        </div>
                    }
                    else
                    {
                        var toShow = ChamadosToShow();
                        if (!toShow.Any())
                        {
                            <p class="empty-state">
                                Nenhum chamado encontrado nesta aba.
                            </p>
                        }
                        else
                        {
                            <div class="lista-chamados-grid">
                                @foreach (var c in toShow)
                                {
                                    var ultimaMensagem = c.Mensagens?
                                        .OrderByDescending(m => m.DataHoraMensagem)
                                        .FirstOrDefault();

                                    <div class="chamado-card @(EhExpirado(c) ? "chamado-expirado" : "")">
                                        <div class="chamado-card-header">
                                            <div class="chamado-card-header-left">
                                                <span class="chamado-id">#@c.Id</span>
                                                @if (!string.IsNullOrWhiteSpace(c.Categoria?.Nome))
                                                {
                                                    <span class="tag-categoria">@c.Categoria.Nome</span>
                                                }
                                            </div>

                                            <div class="chamado-card-header-right">
                                                <span class="badge-prioridade @GetPrioridadeCssClass(c.Prioridade)">
                                                    @GetPrioridadeTexto(c.Prioridade)
                                                </span>

                                                <span class="badge-status @GetStatusCssClass(c)">
                                                    @GetStatusVisual(c)
                                                </span>
                                            </div>
                                        </div>

                                        <h4 class="chamado-titulo">@c.Titulo</h4>

                                        <p class="chamado-descricao">
                                            @(!string.IsNullOrWhiteSpace(c.Descricao) ? c.Descricao : "(Sem descrição)")
                                        </p>

                                        <div class="chamado-meta">
                                            <span>
                                                Última interação:
                                                @(ultimaMensagem != null
                                                    ? ultimaMensagem.DataHoraMensagem.ToString("dd/MM/yyyy HH:mm")
                                                    : "-")
                                            </span>
                                            <span>
                                                Técnico:
                                                @(string.IsNullOrWhiteSpace(c.Tecnico?.Nome)
                                                    ? "Sem técnico"
                                                    : c.Tecnico.Nome)
                                            </span>
                                        </div>

                                        <div class="card-actions">
                                            @* Assumir: só se não tiver técnico e não estiver fechado/cancelado *@
                                            @if ((c.Tecnico == null || string.IsNullOrWhiteSpace(c.Tecnico.Id)) &&
                                                 c.Status != (int)EStatusChamado.FECHADO &&
                                                 c.Status != (int)EStatusChamado.CANCELADO)
                                            {
                                                <button class="btn-primary"
                                                        @onclick='() => AbrirModalAcaoChamado(c, "assumir")'>
                                                    Assumir
                                                </button>
                                            }

                                            <button class="btn-outline"
                                                    @onclick="() => AbrirModalComentarChamado(c)">
                                                Comentar
                                            </button>

                                            @* Fechar / Cancelar apenas se não estiver fechado/cancelado *@
                                            @if (c.Status != (int)EStatusChamado.FECHADO &&
                                                 c.Status != (int)EStatusChamado.CANCELADO)
                                            {
                                                <button class="btn-warning"
                                                        @onclick='() => AbrirModalAcaoChamado(c, "fechar")'>
                                                    Fechar
                                                </button>

                                                <button class="btn-secondary"
                                                        @onclick='() => AbrirModalAcaoChamado(c, "cancelar")'>
                                                    Cancelar
                                                </button>
                                            }

                                            <button class="btn-outline btn-outline-soft"
                                                    @onclick='() => AbrirModalAcaoChamado(c, "sugestao")'>
                                                Sugestão resolvida
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </section>
        }

        @* ================== CHAT ================== *@
        @if (AbaSelecionada == 2)
        {
            <section class="card chat-card">
                <div class="chat-header">
                    <h3>@TituloChat</h3>
                    <p class="subtitle">@SubtituloChat</p>
                </div>

                <div class="chat-window" id="chatWindow">
                    @foreach (var m in ChatMensagens)
                    {
                        var souEu = m.Remetente == "tecnico";
                        <div class="chat-row @(souEu ? "me" : "other")">
                            @if (!souEu)
                            {
                                <div class="chat-avatar">👤</div>
                            }

                            <div class="chat-bubble">
                                <span>@m.Texto</span>

                                @if (souEu)
                                {
                                    <span class="check-icon @(m.Lida ? "read" : "")">✓✓</span>
                                }
                            </div>

                            @if (souEu)
                            {
                                <div class="chat-avatar">🧑</div>
                            }
                        </div>
                    }
                </div>

                <div class="chat-input-row">
                    <input class="chat-input"
                           @bind="MensagemChat"
                           placeholder="Digite sua mensagem..."
                           @onkeydown="HandleChatKeyDown"
                           @onkeydown:preventDefault="@(MensagemChat?.Length > 0 && MensagemChat.EndsWith('\n'))" />

                    <button class="chat-send-btn" @onclick="EnviarMensagemChat">Enviar</button>
                </div>
            </section>
        }
    </main>
</div>

<!-- MODAIS (componentes separados) -->
<ModalConfirmarAcaoChamadoTecnico Mostrar="@MostrarModalConfirmacaoChamado"
                                  Titulo="@TituloModalConfirmacaoChamado"
                                  Mensagem="@MensagemModalConfirmacaoChamado"
                                  TextoBotaoConfirmar="@TextoBotaoConfirmacaoChamado"
                                  OnConfirmar="ConfirmarAcaoChamado"
                                  OnCancelar="FecharModalConfirmacaoChamado" />

<ModalComentarChamadoTecnico Mostrar="@MostrarModalComentarChamado"
                             Titulo="Comentar Chamado"
                             Comentario="@ComentarioChamadoTexto"
                             IsSaving="@IsSavingComentarioChamado"
                             OnEnviar="EnviarComentarioChamado"
                             OnCancelar="FecharModalComentarChamado" />

@code {
    // =================== CHAT MODEL ===================
    public class ChatMensagem
    {
        public string Remetente { get; set; } = "tecnico";
        public string Texto { get; set; } = "";
        public bool Lida { get; set; } = false;
    }

    class MensagemDTO
    {
        public string Texto { get; set; } = "";
        public DateTime DataHoraMensagem { get; set; } = DateTime.Now;
        public string AutorNome { get; set; } = "";
    }

    // =================== CAMPOS DE CHAT ===================
    string TituloChat = "Chat com Colaborador";
    string SubtituloChat = "Alinhamento rápido com o colaborador.";

    HubConnection? _hubConnection;
    readonly Guid ChatChamadoId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    List<ChatMensagem> ChatMensagens = new();
    string MensagemChat = "";

    // =================== ESTADOS GERAIS / STATUS UI ===================
    string UiStatusMessage { get; set; }
    bool UiStatusIsError { get; set; }
    bool IsLoadingChamados { get; set; }
    string LoadingText { get; set; } = "";

    void ShowSuccess(string msg)
    {
        UiStatusMessage = msg;
        UiStatusIsError = false;
        StateHasChanged();
    }

    void ShowError(string msg)
    {
        UiStatusMessage = msg;
        UiStatusIsError = true;
        StateHasChanged();
    }

    int AbaSelecionada = 0;

    enum Tab { Pendentes, Meus, Expirados, Acatados }
    Tab ActiveTab = Tab.Pendentes;

    bool ListaCarregando = false;

    // Chamados vindos da API
    List<ChamadoDTO> ChamadosPendentes { get; set; } = new();
    List<ChamadoDTO> ChamadosGerais { get; set; } = new();
    List<ChamadoDTO> ChamadosExpirados { get; set; } = new();
    List<ChamadoDTO> ChamadosAcatados { get; set; } = new();

    // Usuário atual (técnico logado)
    UsuarioAtualDTO? UsuarioAtual { get; set; }

    // Meus chamados (derivado da lista geral)
    List<ChamadoDTO> ChamadosMeus =>
        UsuarioAtual is null
            ? new List<ChamadoDTO>()
            : ChamadosGerais
                .Where(c => c.Tecnico != null &&
                            c.Tecnico.Id == UsuarioAtual.Id &&
                            c.Status != (int)EStatusChamado.FECHADO &&
                            c.Status != (int)EStatusChamado.CANCELADO)
                .ToList();

    int CountPendentes => ChamadosPendentes.Count;
    int CountMeus => ChamadosMeus.Count;
    int CountExpirados => ChamadosExpirados.Count;
    int CountAcatados => ChamadosAcatados.Count;

    // =================== MODAIS DE CHAMADOS ===================
    ChamadoDTO? ChamadoSelecionado { get; set; }

    bool MostrarModalConfirmacaoChamado = false;
    string TipoAcaoChamado = ""; // "assumir" | "fechar" | "cancelar" | "sugestao"
    string TituloModalConfirmacaoChamado = "";
    string MensagemModalConfirmacaoChamado = "";
    string TextoBotaoConfirmacaoChamado = "";

    bool MostrarModalComentarChamado = false;
    string ComentarioChamadoTexto = "";
    bool IsSavingComentarioChamado = false;

    // =================== MODELOS DTO ===================
    public class ChamadoDTO
    {
        public string Id { get; set; } = "";
        public string Titulo { get; set; } = "";
        public string Descricao { get; set; } = "";
        public int Prioridade { get; set; }
        public int Status { get; set; }
        public Autor Autor { get; set; } = new();
        public TecnicoDTO Tecnico { get; set; } = new();
        public CategoriaMini Categoria { get; set; } = new();
        public List<MensagemChamadoDTO> Mensagens { get; set; } = new();
    }

    public class Autor { public string Id { get; set; } = ""; public string Nome { get; set; } = ""; }
    public class TecnicoDTO { public string Id { get; set; } = ""; public string Nome { get; set; } = ""; }
    public class CategoriaMini { public string Nome { get; set; } = ""; }

    public class MensagemChamadoDTO
    {
        public string Id { get; set; } = "";
        public Autor Autor { get; set; } = new();
        public DateTime DataHoraMensagem { get; set; }
        public string Texto { get; set; } = "";
    }

    public class UsuarioAtualDTO
    {
        public string Id { get; set; } = "";
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Tipo { get; set; } = "";
    }

    // =================== CICLO DE VIDA ===================
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await InjetarToken();
        await LoadUsuarioAtual();
        await LoadChamados();
        await InicializarChat();
        await GarantirConexaoChat();
    }

    // =================== TOKEN ===================
    async Task InjetarToken()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");

            if (string.IsNullOrEmpty(token))
            {
                Nav.NavigateTo("/login", true);
                return;
            }

            if (!Http.DefaultRequestHeaders.Contains("Authorization"))
                Http.DefaultRequestHeaders.Add("Authorization", $"Bearer {token}");
        }
        catch
        {
            Nav.NavigateTo("/login", true);
        }
    }

    // =================== USUÁRIO ATUAL ===================
    async Task LoadUsuarioAtual()
    {
        try
        {
            var res = await Http.GetAsync("Usuario/eu");
            if (res.IsSuccessStatusCode)
            {
                UsuarioAtual = await res.Content.ReadFromJsonAsync<UsuarioAtualDTO>();
            }
            else if (res.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                ShowError("Sessão expirada. Faça login novamente.");
                Nav.NavigateTo("/login", true);
            }
        }
        catch (Exception ex)
        {
            ShowError($"Erro ao carregar usuário atual: {ex.Message}");
        }
    }

    // =================== CHAMADOS ===================
    async Task LoadChamados()
    {
        ListaCarregando = true;
        IsLoadingChamados = true;
        LoadingText = "Carregando chamados...";
        UiStatusMessage = null;
        StateHasChanged();

        try
        {
            // gerais
            var resGeral = await Http.GetAsync("Chamados?paginaAtual=0&tamanho=900");
            if (resGeral.IsSuccessStatusCode)
                ChamadosGerais = await resGeral.Content.ReadFromJsonAsync<List<ChamadoDTO>>() ?? new();

            // pendentes do técnico
            var resPend = await Http.GetAsync("Chamados/pendentes-tecnico");
            if (resPend.IsSuccessStatusCode)
                ChamadosPendentes = await resPend.Content.ReadFromJsonAsync<List<ChamadoDTO>>() ?? new();

            // expirados
            var resExp = await Http.GetAsync("Chamados/expirados");
            if (resExp.IsSuccessStatusCode)
                ChamadosExpirados = await resExp.Content.ReadFromJsonAsync<List<ChamadoDTO>>() ?? new();

            // acatados
            var resAcat = await Http.GetAsync("Chamados/acatados?paginaAtual=0&tamanho=900");
            if (resAcat.IsSuccessStatusCode)
                ChamadosAcatados = await resAcat.Content.ReadFromJsonAsync<List<ChamadoDTO>>() ?? new();

            ShowSuccess("Chamados atualizados com sucesso.");
        }
        catch (Exception ex)
        {
            ShowError($"Erro ao carregar chamados: {ex.Message}");
        }
        finally
        {
            ListaCarregando = false;
            IsLoadingChamados = false;
            LoadingText = "";
            StateHasChanged();
        }
    }

    // =================== TABS ===================
    void SelectTab(Tab t) => ActiveTab = t;

    IEnumerable<ChamadoDTO> ChamadosToShow() => ActiveTab switch
    {
        Tab.Pendentes => ChamadosPendentes.OrderByDescending(x => x.Prioridade),
        Tab.Meus      => ChamadosMeus.OrderByDescending(x => x.Prioridade),
        Tab.Expirados => ChamadosExpirados.OrderByDescending(x => x.Prioridade),
        Tab.Acatados  => ChamadosAcatados.OrderByDescending(x => x.Prioridade),
        _             => Enumerable.Empty<ChamadoDTO>()
    };

    // =================== AÇÕES CHAMADOS (MODAIS) ===================
    void AbrirModalAcaoChamado(ChamadoDTO chamado, string tipoAcao)
    {
        ChamadoSelecionado = chamado;
        TipoAcaoChamado = tipoAcao;

        switch (tipoAcao)
        {
            case "assumir":
                TituloModalConfirmacaoChamado = "Assumir chamado";
                MensagemModalConfirmacaoChamado = $"Deseja assumir o chamado \"{chamado.Titulo}\"?";
                TextoBotaoConfirmacaoChamado = "Assumir";
                break;

            case "fechar":
                TituloModalConfirmacaoChamado = "Fechar chamado";
                MensagemModalConfirmacaoChamado = $"Deseja marcar o chamado \"{chamado.Titulo}\" como FECHADO?";
                TextoBotaoConfirmacaoChamado = "Fechar";
                break;

            case "cancelar":
                TituloModalConfirmacaoChamado = "Cancelar chamado";
                MensagemModalConfirmacaoChamado = $"Deseja cancelar o chamado \"{chamado.Titulo}\"?";
                TextoBotaoConfirmacaoChamado = "Cancelar";
                break;

            case "sugestao":
                TituloModalConfirmacaoChamado = "Marcar sugestão resolvida";
                MensagemModalConfirmacaoChamado =
                    $"Deseja alterar o status de 'resolveu sugestão' do chamado \"{chamado.Titulo}\"?";
                TextoBotaoConfirmacaoChamado = "Confirmar";
                break;
        }

        MostrarModalConfirmacaoChamado = true;
    }

    void FecharModalConfirmacaoChamado()
    {
        MostrarModalConfirmacaoChamado = false;
        TipoAcaoChamado = "";
    }

    async Task ConfirmarAcaoChamado()
    {
        if (ChamadoSelecionado == null || string.IsNullOrEmpty(TipoAcaoChamado))
        {
            ShowError("Nenhum chamado selecionado.");
            return;
        }

        try
        {
            HttpResponseMessage res;
            // JSON vazio só para garantir Content-Type application/json
            var emptyJson = JsonContent.Create(new { });

            switch (TipoAcaoChamado)
            {
                case "assumir":
                    res = await Http.PatchAsync(
                        $"Chamados/{ChamadoSelecionado.Id}/acatar-chamado",
                        emptyJson);
                    break;

                case "fechar":
                    res = await Http.PatchAsync(
                        $"Chamados/{ChamadoSelecionado.Id}/fechar-chamado",
                        emptyJson);
                    break;

                case "cancelar":
                    res = await Http.PatchAsync(
                        $"Chamados/{ChamadoSelecionado.Id}/cancelar",
                        emptyJson);
                    break;

                case "sugestao":
                    res = await Http.PatchAsync(
                        $"Chamados/{ChamadoSelecionado.Id}/alterar-resolveu-sugestao",
                        emptyJson);
                    break;

                default:
                    ShowError("Ação inválida.");
                    return;
            }

            if (res.IsSuccessStatusCode)
            {
                await LoadChamados();
                ShowSuccess("Ação executada com sucesso no chamado.");
            }
            else
            {
                var txt = await res.Content.ReadAsStringAsync();
                ShowError($"Erro ao realizar ação: {res.StatusCode}\n{txt}");
            }
        }
        catch (Exception ex)
        {
            ShowError($"Erro ao realizar ação: {ex.Message}");
        }
        finally
        {
            FecharModalConfirmacaoChamado();
        }
    }

    void AbrirModalComentarChamado(ChamadoDTO chamado)
    {
        ChamadoSelecionado = chamado;
        ComentarioChamadoTexto = "";
        MostrarModalComentarChamado = true;
    }

    void FecharModalComentarChamado()
    {
        MostrarModalComentarChamado = false;
        ComentarioChamadoTexto = "";
    }

    async Task EnviarComentarioChamado(string texto)
    {
        if (ChamadoSelecionado == null)
        {
            ShowError("Nenhum chamado selecionado.");
            return;
        }

        if (string.IsNullOrWhiteSpace(texto))
        {
            ShowError("Digite um comentário antes de enviar.");
            return;
        }

        IsSavingComentarioChamado = true;

        try
        {
            var payload = new { texto };
            var res = await Http.PatchAsync(
                $"Chamados/{ChamadoSelecionado.Id}/comentar",
                JsonContent.Create(payload));

            if (res.IsSuccessStatusCode)
            {
                // 1) Atualiza localmente o chamado selecionado
                var novaMsg = new MensagemChamadoDTO
                    {
                        Id = Guid.NewGuid().ToString(),
                        Autor = new Autor
                        {
                            Id = UsuarioAtual?.Id ?? "",
                            Nome = UsuarioAtual?.Nome ?? "Técnico"
                        },
                        DataHoraMensagem = DateTime.Now,
                        Texto = texto
                    };

                ChamadoSelecionado.Mensagens ??= new List<MensagemChamadoDTO>();
                ChamadoSelecionado.Mensagens.Add(novaMsg);

                // atualiza também nas listas usadas pelos cards
                void AtualizarColecao(List<ChamadoDTO> lista)
                {
                    var item = lista.FirstOrDefault(x => x.Id == ChamadoSelecionado.Id);
                    if (item != null)
                    {
                        item.Mensagens ??= new List<MensagemChamadoDTO>();
                        item.Mensagens.Add(novaMsg);
                    }
                }

                AtualizarColecao(ChamadosGerais);
                AtualizarColecao(ChamadosPendentes);
                AtualizarColecao(ChamadosExpirados);
                AtualizarColecao(ChamadosAcatados);

                StateHasChanged(); // já reflete "Última interação"

                // 2) Recarrega do backend para ficar 100% em linha
                await LoadChamados();

                FecharModalComentarChamado();
                ShowSuccess("Comentário enviado com sucesso.");
            }
            else
            {
                var txt = await res.Content.ReadAsStringAsync();
                ShowError($"Erro ao enviar comentário: {res.StatusCode}\n{txt}");
            }
        }
        catch (Exception ex)
        {
            ShowError($"Erro ao enviar comentário: {ex.Message}");
        }
        finally
        {
            IsSavingComentarioChamado = false;
        }
    }

    // =================== SAIR ===================
    async Task Sair()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "token");
        }
        catch { }

        Nav.NavigateTo("/login", true);
    }

    // =================== CHAT (SignalR) ===================
    async Task InicializarChat()
    {
        if (!ChatMensagens.Any())
        {
            ChatMensagens.Add(new ChatMensagem
            {
                Remetente = "tecnico",
                Texto = "Olá! Sou o técnico, como posso te ajudar?"
            });
        }
    }

    async Task GarantirConexaoChat()
    {
        if (_hubConnection is { State: HubConnectionState.Connected })
            return;

        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
        if (string.IsNullOrWhiteSpace(token))
        {
            ShowError("Sessão expirada. Faça login novamente.");
            Nav.NavigateTo("/login");
            return;
        }

        var apiBase = Http.BaseAddress?.ToString().TrimEnd('/');
        if (string.IsNullOrEmpty(apiBase))
        {
            ShowError("BaseAddress da API não configurada no HttpClient.");
            return;
        }

        var hubUrl = $"{apiBase}/hubs/chat";

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl, options =>
            {
                options.AccessTokenProvider = () => Task.FromResult<string?>(token);
            })
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<Guid, MensagemDTO>("ReceberMensagem", (chamadoId, msg) =>
        {
            if (chamadoId != ChatChamadoId)
                return;

            foreach (var m in ChatMensagens.Where(x => x.Remetente == "tecnico"))
                m.Lida = true;

            ChatMensagens.Add(new ChatMensagem
            {
                Remetente = "colaborador",
                Texto = msg.Texto,
                Lida = false
            });

            InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hubConnection.StartAsync();
            await _hubConnection.InvokeAsync("EntrarNoGrupoDoChamado", ChatChamadoId);
        }
        catch (Exception ex)
        {
            ShowError($"Erro ao conectar no chat em tempo real: {ex.Message}");
        }
    }

    async Task EnviarMensagemChat()
    {
        if (string.IsNullOrWhiteSpace(MensagemChat))
            return;

        if (_hubConnection is null || _hubConnection.State != HubConnectionState.Connected)
        {
            await GarantirConexaoChat();

            if (_hubConnection is null || _hubConnection.State != HubConnectionState.Connected)
            {
                ShowError("Não foi possível conectar ao chat em tempo real.");
                return;
            }
        }

        var texto = MensagemChat.Trim();
        MensagemChat = "";

        ChatMensagens.Add(new ChatMensagem
        {
            Remetente = "tecnico",
            Texto = texto,
            Lida = false
        });

        await InvokeAsync(StateHasChanged);

        try
        {
            await _hubConnection.InvokeAsync("EnviarMensagemParaGrupo", ChatChamadoId, texto);
        }
        catch (Exception ex)
        {
            ShowError($"Erro ao enviar mensagem no chat: {ex.Message}");
        }
    }

    // =================== DISPOSE ===================
    public void Dispose()
    {
        if (_hubConnection != null)
        {
            _ = _hubConnection.StopAsync();
            _ = _hubConnection.DisposeAsync();
        }
    }

    // =================== HELPERS ===================
    string GetStatusTexto(int status) => status switch
    {
        (int)EStatusChamado.ABERTO          => "Aberto",
        (int)EStatusChamado.SUGESTAO_GERADA => "Sugestão Gerada",
        (int)EStatusChamado.FECHADO         => "Fechado",
        (int)EStatusChamado.CANCELADO       => "Cancelado",
        _                                   => "Desconhecido"
    };

    bool EhExpirado(ChamadoDTO c) =>
        ChamadosExpirados.Any(x => x.Id == c.Id) &&
        c.Status == (int)EStatusChamado.ABERTO;

    string GetStatusVisual(ChamadoDTO c)
    {
        if (EhExpirado(c)) return "Expirado";
        return GetStatusTexto(c.Status);
    }

    string GetStatusCssClass(ChamadoDTO c)
    {
        if (EhExpirado(c)) return "status-expirado";

        return c.Status switch
        {
            (int)EStatusChamado.FECHADO         => "status-fechado",
            (int)EStatusChamado.CANCELADO       => "status-cancelado",
            (int)EStatusChamado.ABERTO when
                (c.Tecnico == null || string.IsNullOrWhiteSpace(c.Tecnico.Id))
                                                => "status-pendente",
            (int)EStatusChamado.ABERTO          => "status-atendimento",
            (int)EStatusChamado.SUGESTAO_GERADA => "status-atendimento",
            _                                   => "status-pendente"
        };
    }

    string GetPrioridadeTexto(int p) => p switch
    {
        0 => "Baixa",
        1 => "Média",
        2 => "Alta",
        3 => "Crítica",
        _ => "N/D"
    };

    string GetPrioridadeCssClass(int p) => p switch
    {
        0 => "prio-baixa",
        1 => "prio-media",
        2 => "prio-alta",
        3 => "prio-critica",
        _ => "prio-media"
    };

    // =================== CHAT ENTER ===================
    void HandleChatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            _ = EnviarMensagemChat();
        }
    }
}