@page "/paineltecnico"

@using System.Net.Http.Json
@using System.Text.Json

@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http

<PageTitle>Painel do Técnico</PageTitle>

<link rel="stylesheet" href="css/PainelTecnico.css" />

<div class="layout">

    <!-- Sidebar -->
    <aside class="sidebar">
        <h2 class="logo">Painel do Técnico</h2>

        <nav class="menu">
            <button class="menu-item" @onclick="() => AbaSelecionada = 0">Home</button>
            <button class="menu-item" @onclick="() => AbaSelecionada = 1">Chamados</button>
            <button class="menu-item" @onclick="() => AbaSelecionada = 2">Chat com Colaborador</button>
            <button class="menu-item logout" @onclick="Sair">Sair</button>
        </nav>
    </aside>

    <!-- Conteúdo -->
    <main class="conteudo">
        @if (AbaSelecionada == 0)
        {
            <section class="card">
                <h1>Seja bem-vindo(a)!</h1>
                <p>Aqui você poderá gerenciar chamados, assumir, comentar, fechar e conversar com colaboradores.</p>
            </section>
        }

        @if (AbaSelecionada == 1)
        {
            <section class="card">
                <h3>Chamados</h3>

                <div class="tabs">
                    <button class="tab @(ActiveTab==Tab.Novo?"active":"")" @onclick="() => SelectTab(Tab.Novo)">Novo (@CountNovo)</button>
                    <button class="tab @(ActiveTab==Tab.Pendentes?"active":"")" @onclick="() => SelectTab(Tab.Pendentes)">Pendentes (@CountPendentes)</button>
                    <button class="tab @(ActiveTab==Tab.EmAtendimento?"active":"")" @onclick="() => SelectTab(Tab.EmAtendimento)">Em Atendimento (@CountEmAtendimento)</button>
                    <button class="tab @(ActiveTab==Tab.Expirados?"active":"")" @onclick="() => SelectTab(Tab.Expirados)">Expirados (@CountExpirados)</button>
                </div>

                <div class="content">
                    @if (ListaCarregando)
                    {
                        <p>Carregando chamados...</p>
                    }
                    else
                    {
                        var toShow = ChamadosToShow();
                        if (!toShow.Any())
                        {
                            <p>Nenhum chamado nesta aba.</p>
                        }
                        else
                        {
                            <div class="lista-chamados">
                                @foreach (var c in toShow)
                                {
                                    <div class="chamado-item">
                                        <h4>@c.Titulo</h4>
                                        <p>@c.Pergunta</p>
                                        <p class="meta">Técnico: @(string.IsNullOrEmpty(c.Tecnico) ? "Sem técnico" : c.Tecnico)</p>
                                        <div class="card-actions">
                                            @if (string.IsNullOrEmpty(c.Tecnico))
                                            {
                                                <button class="btn-primary" @onclick="() => AssumirChamado(c)">Assumir</button>
                                            }
                                            <button class="btn-outline" @onclick="() => AbrirDetalhe(c)">Abrir</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </section>
        }

        @if (AbaSelecionada == 2)
        {
            <section class="card">
                <h3>Chat com Colaborador</h3>

                <div class="chat-window" id="chatWindow">
                    @foreach (var msg in Mensagens)
                    {
                        <div class="msg @(msg.Remetente == "tecnico" ? "user" : "bot")">
                            <div class="avatar">@((msg.Remetente == "tecnico") ? "👨‍🔧" : "🧑")</div>
                            <div class="bubble">@msg.Texto</div>
                        </div>
                    }
                </div>

                <div class="chat-input mt-3 d-flex gap-2">
                    <input class="form-control" @bind="NovaMensagem" placeholder="Digite sua mensagem..." />
                    <button class="btn btn-primary" @onclick="EnviarMensagem">Enviar</button>
                </div>
            </section>
        }
    </main>
</div>

@code {

    // =================== ESTADOS ===================
    int AbaSelecionada = 0;

    List<ChamadoDTO> Chamados = new();
    bool ListaCarregando = false;

    enum Tab { Novo, Pendentes, EmAtendimento, Expirados }
    Tab ActiveTab = Tab.Novo;

    int CountNovo => Chamados.Count(x => x.Novo && !x.Fechado && !x.Cancelado);
    int CountPendentes => Chamados.Count(x => string.IsNullOrEmpty(x.Tecnico) && !x.Cancelado && !x.Fechado);
    int CountEmAtendimento => Chamados.Count(x => !string.IsNullOrEmpty(x.Tecnico) && !x.Fechado && !x.Cancelado);
    int CountExpirados => Chamados.Count(x => x.Expirado && !x.Fechado && !x.Cancelado);

    bool MenuAberto = false;

    // =================== MODELOS ===================
    public class ChamadoDTO
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Titulo { get; set; } = "";
        public string Pergunta { get; set; } = "";
        public string Resposta { get; set; } = "";
        public DateTime Data { get; set; } = DateTime.Now;
        public string Tecnico { get; set; } = "";
        public bool Fechado { get; set; } = false;
        public bool Cancelado { get; set; } = false;
        public bool Expirado { get; set; } = false;
        public bool Novo { get; set; } = true;
        public List<CommentDTO> Comments { get; set; } = new();
    }

    public class CommentDTO
    {
        public string Author { get; set; } = "Técnico";
        public string Text { get; set; } = "";
        public DateTime When { get; set; } = DateTime.Now;
    }

    // =================== CHAT ===================
    public class Mensagem
    {
        public string Remetente { get; set; } = "usuario"; // "tecnico" ou "colaborador"
        public string Texto { get; set; } = "";
    }

    List<Mensagem> Mensagens = new();
    string NovaMensagem = "";
    PeriodicTimer timer;

    // =================== CICLO ===================
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadChamados();
            await InicializarChat();
            StartTimer();
        }
    }

    // =================== MÉTODOS ===================
    void SelectTab(Tab t) => ActiveTab = t;
    IEnumerable<ChamadoDTO> ChamadosToShow() => ActiveTab switch
    {
        Tab.Novo => Chamados.Where(x => x.Novo && !x.Fechado && !x.Cancelado).OrderByDescending(x => x.Data),
        Tab.Pendentes => Chamados.Where(x => string.IsNullOrEmpty(x.Tecnico) && !x.Cancelado && !x.Fechado).OrderByDescending(x => x.Data),
        Tab.EmAtendimento => Chamados.Where(x => !string.IsNullOrEmpty(x.Tecnico) && !x.Fechado && !x.Cancelado).OrderByDescending(x => x.Data),
        Tab.Expirados => Chamados.Where(x => x.Expirado && !x.Fechado && !x.Cancelado).OrderByDescending(x => x.Data),
        _ => Chamados
    };

    async Task LoadChamados()
    {
        ListaCarregando = true;
        StateHasChanged();

        try
        {
            var res = await Http.GetAsync("Chamados/pendentes-tecnico");
            if (res.IsSuccessStatusCode)
            {
                var list = await res.Content.ReadFromJsonAsync<List<ChamadoDTO>>();
                if (list != null) Chamados = list;
            }
        }
        catch { }
        finally
        {
            ListaCarregando = false;
            StateHasChanged();
        }
    }

    async Task AssumirChamado(ChamadoDTO c)
    {
        try
        {
            var res = await Http.PatchAsync($"Chamados/{c.Id}/acatar-chamado", null);
            if (res.IsSuccessStatusCode)
            {
                c.Tecnico = "Você";
                StateHasChanged();
            }
        }
        catch { }
    }

    void AbrirDetalhe(ChamadoDTO c)
    {
        // Aqui você pode implementar modal ou seção expandida de detalhes
    }

    async Task Sair()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "chamados_tecnico");
        Nav.NavigateTo("/login", true);
    }

    // =================== CHAT ===================
    async Task InicializarChat()
    {
        var pergunta = await JS.InvokeAsync<string>("localStorage.getItem", "chatTecnicoMensagemInicial");
        var json = await JS.InvokeAsync<string>("localStorage.getItem", "chatTecnico");

        try
        {
            if (!string.IsNullOrEmpty(json))
                Mensagens = JsonSerializer.Deserialize<List<Mensagem>>(json) ?? new();
        }
        catch
        {
            Mensagens = new();
            await JS.InvokeVoidAsync("localStorage.removeItem", "chatTecnico");
        }

        if (Mensagens.Count == 0 && !string.IsNullOrEmpty(pergunta))
        {
            Mensagens.Add(new Mensagem
                {
                    Remetente = "colaborador",
                    Texto = pergunta
                });
            await SalvarChat();
        }
    }

    async Task EnviarMensagem()
    {
        if (string.IsNullOrWhiteSpace(NovaMensagem)) return;

        Mensagens.Add(new Mensagem
            {
                Remetente = "tecnico",
                Texto = NovaMensagem
            });

        await SalvarChat();
        NovaMensagem = "";
    }

    async Task SalvarChat()
    {
        var json = JsonSerializer.Serialize(Mensagens);
        await JS.InvokeVoidAsync("localStorage.setItem", "chatTecnico", json);
        await InvokeAsync(StateHasChanged);
    }

    void StartTimer()
    {
        timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = Task.Run(async () =>
        {
            while (await timer.WaitForNextTickAsync())
            {
                await AtualizarMensagens();
            }
        });
    }

    async Task AtualizarMensagens()
    {
        var json = await JS.InvokeAsync<string>("localStorage.getItem", "chatTecnico");
        if (string.IsNullOrEmpty(json)) return;

        try
        {
            var msgs = JsonSerializer.Deserialize<List<Mensagem>>(json) ?? new();
            if (msgs.Count != Mensagens.Count)
            {
                Mensagens = msgs;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    public void Dispose() => timer?.Dispose();
}