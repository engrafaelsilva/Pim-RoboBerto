@page "/painel-tecnico"
@using System.Text.Json
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Painel do Técnico</PageTitle>

<div class="painel-tecnico">

    <div class="header">
        <h2>Central do Técnico 🧠</h2>

        <div class="notificacao" @onclick="AbrirModalChamados">
            <span class="icon">🔔</span>
            @if (Chamados.Count > 0)
            {
                <span class="badge">@Chamados.Count</span>
            }
        </div>
    </div>

    <p class="subtitulo">Gerencie chamados, converse com colaboradores e acompanhe atendimentos.</p>

    @if (Chamados.Count == 0)
    {
        <p class="nenhum">Nenhum chamado pendente no momento.</p>
    }
    else
    {
        <h4 class="titulo-lista">Chamados recentes</h4>

        <div class="lista-chamados">
            @foreach (var chamado in Chamados)
            {
                <div class="chamado-card shadow-sm rounded-3 p-3 mb-3">
                    <p><strong>Pergunta:</strong> @chamado.Pergunta</p>
                    <p><strong>Sugestão da IA:</strong> @chamado.Resposta</p>
                    <p><strong>Data:</strong> @chamado.Data.ToString("g")</p>

                    <button class="btn-atender" @onclick="() => AtenderChamado(chamado)">
                        👨‍🔧 Atender Chamado
                    </button>
                </div>
            }
        </div>
    }

</div>

@if (ModalAberto)
{
    <div class="modal-overlay" @onclick="FecharModalChamados"></div>

    <div class="modal">
        <h3>Chamados Pendentes</h3>

        @foreach (var chamado in Chamados)
        {
            <div class="chamado-item">
                <p><strong>@chamado.Pergunta</strong></p>
                <button class="btn-mini" @onclick="() => AtenderChamado(chamado)">Atender</button>
            </div>
        }

        <button class="btn-fechar" @onclick="FecharModalChamados">Fechar</button>
    </div>
}

<style>
    .painel-tecnico {
        max-width: 960px;
        margin: 40px auto;
        padding: 20px;
        animation: fadeInPage 0.4s ease;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(135deg, #1d4ed8, #133b92);
        padding: 22px 28px;
        border-radius: 16px;
        color: white;
        box-shadow: 0 8px 20px #0003;
    }

        .header h2 {
            margin: 0;
            font-size: 26px;
            font-weight: 700;
        }

        .header p {
            margin: 2px 0 0;
            opacity: 0.9;
            font-size: 15px;
        }

    .notificacao {
        position: relative;
        cursor: pointer;
        font-size: 30px;
        transition: 0.2s;
    }

        .notificacao:hover {
            transform: scale(1.15);
        }

    .badge {
        position: absolute;
        top: -6px;
        right: -10px;
        background: #ff3b30;
        color: white;
        font-size: 12px;
        padding: 4px 7px;
        border-radius: 50%;
        font-weight: bold;
        box-shadow: 0 0 10px #0005;
    }

    .subtitulo {
        margin: 18px 0;
        color: #444;
        font-size: 17px;
    }

    .titulo-lista {
        margin: 25px 0 10px;
        font-size: 20px;
        color: #1d4ed8;
        font-weight: 600;
    }

    .chamado-card {
        background: #ffffff;
        padding: 18px;
        border-radius: 14px;
        border: 1px solid #e1e1e1;
        transition: 0.2s;
    }

        .chamado-card:hover {
            box-shadow: 0 8px 18px #0001;
            transform: translateY(-2px);
        }

    .btn-atender {
        background: #1d4ed8;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 15px;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-atender:hover {
            background: #133b92;
        }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #00000066;
        backdrop-filter: blur(6px);
        z-index: 9998;
    }

    .modal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: white;
        width: 420px;
        padding: 24px;
        border-radius: 16px;
        z-index: 9999;
        box-shadow: 0 0 25px #0004;
        animation: fadeIn 0.20s ease-in-out;
    }

        .modal h3 {
            margin-top: 0;
        }

    .chamado-item {
        padding: 12px;
        border-bottom: 1px solid #ddd;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-mini {
        background: #1d4ed8;
        color: white;
        border: none;
        padding: 6px 10px;
        font-size: 13px;
        border-radius: 6px;
        cursor: pointer;
    }

    .btn-fechar {
        margin-top: 18px;
        width: 100%;
        padding: 10px;
        background: #666;
        border: none;
        color: white;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 600;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translate(-50%, -55%);
    }

    to {
        opacity: 1;
        transform: translate(-50%, -50%);
    }

    }

    @@keyframes fadeInPage {
        from
        {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
</style>

@code {
    public class Chamado
    {
        public string Pergunta { get; set; } = "";
        public string Resposta { get; set; } = "";
        public DateTime Data { get; set; }
    }

    List<Chamado> Chamados = new();
    bool ModalAberto = false;

    protected override async Task OnAfterRenderAsync(bool firstRender){
        if (firstRender)
        {
            try
            {
                var json = await JS.InvokeAsync<string>("localStorage.getItem", "chamadoTecnico");

                if (!string.IsNullOrEmpty(json))
                {
                    var chamado = JsonSerializer.Deserialize<Chamado>(json);
                    if (chamado != null)
                        Chamados.Add(chamado);

                    await JS.InvokeVoidAsync("localStorage.removeItem", "chamadoTecnico");

                    StateHasChanged(); 
                }
            }
            catch {}
        }
    }

    void AbrirModalChamados() => ModalAberto = true;
    void FecharModalChamados() => ModalAberto = false;

    void AtenderChamado(Chamado chamado)
    {
        JS.InvokeVoidAsync("localStorage.setItem", "chatTecnico", JsonSerializer.Serialize(chamado));
        Nav.NavigateTo("/chat-tecnico");
    }
}