@page "/painel-tecnico"
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http

<PageTitle>Painel do Técnico</PageTitle>

<div class="painel-tecnico">

    <div class="header">
        <div>
            <h2>Central do Técnico 🧠</h2>
            <div class="header-actions">
                <button class="btn-outline small" @onclick="RefreshChamados">⟳ Atualizar</button>
                <button class="btn-outline small" @onclick="ToggleView">@((IsKanban) ? "🔳 Lista" : "📋 Kanban")</button>
                <button class="btn-primary small" @onclick="AbrirFormCriar">➕ Novo Chamado</button>
            </div>
        </div>

        <div class="notificacao" @onclick="AbrirModalChamados" title="Ver chamados pendentes">
            <span class="icon">🔔</span>
            @if (Chamados?.Count > 0)
            {
                <span class="badge">@Chamados.Count</span>
            }
        </div>
    </div>

    <p class="subtitulo">Gerencie chamados, converse com colaboradores e acompanhe atendimentos.</p>

    @if (!IsKanban)
    {
        <div class="tabs">
            <button class="tab @(ActiveTab==Tab.Pendentes ? "active" : "")" @onclick="() => SelectTab(Tab.Pendentes)">Pendentes (@CountPendentes)</button>
            <button class="tab @(ActiveTab==Tab.EmAtendimento ? "active" : "")" @onclick="() => SelectTab(Tab.EmAtendimento)">Em Atendimento (@CountEmAtendimento)</button>
            <button class="tab @(ActiveTab==Tab.Expirados ? "active" : "")" @onclick="() => SelectTab(Tab.Expirados)">Expirados (@CountExpirados)</button>
        </div>
    }

    <div class="content">

        @if (IsKanban)
        {
            <div class="kanban">
                <div class="kanban-col">
                    <h4>Pendentes (@CountPendentes)</h4>
                    @foreach (var c in Chamados.Where(x => string.IsNullOrEmpty(x.Tecnico) && !x.Cancelado && !x.Fechado).OrderByDescending(x => x.Data))
                    {
                        <div class="chamado-card" key="@c.Id">
                            <div class="card-top">
                                <div class="title">@c.Titulo</div>
                                <div class="meta">@c.Data.ToString("g")</div>
                            </div>
                            <div class="desc">@c.Pergunta</div>
                            <div class="card-actions">
                                <button class="btn-primary small" @onclick="() => AssumirChamado(c)">Assumir</button>
                                <button class="btn-outline small" @onclick="() => AbrirDetalhe(c)">Ver</button>
                            </div>
                        </div>
                    }
                </div>

                <div class="kanban-col">
                    <h4>Em Atendimento (@CountEmAtendimento)</h4>
                    @foreach (var c in Chamados.Where(x => !string.IsNullOrEmpty(x.Tecnico) && !x.Fechado && !x.Cancelado).OrderByDescending(x => x.Data))
                    {
                        <div class="chamado-card" key="@c.Id">
                            <div class="card-top">
                                <div class="title">@c.Titulo</div>
                                <div class="meta">@c.Data.ToString("g")</div>
                            </div>
                            <div class="desc">@c.Pergunta</div>
                            <div class="card-actions">
                                <button class="btn-primary small" @onclick="() => AbrirDetalhe(c)">Abrir</button>
                                <button class="btn-outline small" @onclick="() => FecharChamadoConfirm(c)">Fechar</button>
                            </div>
                        </div>
                    }
                </div>

                <div class="kanban-col">
                    <h4>Expirados (@CountExpirados)</h4>
                    @foreach (var c in Chamados.Where(x => x.Expirado && !x.Fechado && !x.Cancelado).OrderByDescending(x => x.Data))
                    {
                        <div class="chamado-card" key="@c.Id">
                            <div class="card-top">
                                <div class="title">@c.Titulo</div>
                                <div class="meta">@c.Data.ToString("g")</div>
                            </div>
                            <div class="desc">@c.Pergunta</div>
                            <div class="card-actions">
                                <button class="btn-primary small" @onclick="() => AbrirDetalhe(c)">Abrir</button>
                                <button class="btn-outline small" @onclick="() => AssumirChamado(c)">Assumir</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            @if (ListaCarregando)
            {
                <div class="empty">Carregando chamados...</div>
            }
            else
            {
                <div class="lista-chamados">
                    @{ var toShow = ChamadosToShow(); }

                    @if (!toShow.Any())
                    {
                        <div class="empty">Nenhum chamado nesta aba.</div>
                    }
                    else
                    {
                        @foreach (var chamado in toShow)
                        {
                            <div class="chamado-card shadow-sm rounded-3 p-3 mb-3">
                                <p><strong>Pergunta:</strong> @chamado.Pergunta</p>
                                <p><strong>Sugestão da IA:</strong> @chamado.Resposta</p>
                                <p class="meta-line"><span><strong>Data:</strong> @chamado.Data.ToString("g")</span>
                                    <span class="tag">@((string.IsNullOrEmpty(chamado.Tecnico)) ? "Sem técnico" : $"Técnico: {chamado.Tecnico}")</span></p>

                                <div class="card-actions">
                                    @if (string.IsNullOrEmpty(chamado.Tecnico))
                                    {
                                        <button class="btn-primary" @onclick="() => AssumirChamado(chamado)">👨‍🔧 Assumir chamado</button>
                                    }
                                    else
                                    {
                                        <button class="btn-outline" @onclick="() => AbrirDetalhe(chamado)">✉️ Abrir / Comentar</button>
                                        <button class="btn-outline danger" @onclick="() => FecharChamadoConfirm(chamado)">✅ Fechar</button>
                                    }
                                    <button class="btn-mini" @onclick="() => EditarChamado(chamado)">✏️ Editar</button>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        }
    </div>

</div>

<!-- Modals -->
@if (ModalAberto)
{
    <div class="modal-overlay" @onclick="CloseModal"></div>
    <div class="modal">
        <h3>Chamados Pendentes</h3>
        @if (!Chamados.Any())
        {
            <div class="empty">Nenhum chamado pendente.</div>
        }
        else
        {
            @foreach (var c in Chamados)
            {
                <div class="chamado-item">
                    <div>
                        <p class="m-0"><strong>@c.Titulo</strong></p>
                        <p class="m-0 small">@c.Pergunta</p>
                        <p class="m-0 small meta">@c.Data.ToString("g")</p>
                    </div>
                    <div>
                        <button class="btn-mini" @onclick="() => AbrirDetalhe(c)">Abrir</button>
                    </div>
                </div>
            }
        }

        <div style="margin-top:12px; display:flex; gap:8px; justify-content:flex-end;">
            <button class="btn-fechar" @onclick="CloseModal">Fechar</button>
        </div>
    </div>
}

@if (DetalheAberto && SelectedChamado != null)
{
    <div class="modal-overlay" @onclick="CloseDetalhe"></div>
    <div class="modal large" @onclick:stopPropagation>
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <h3>Chamado — @SelectedChamado.Titulo</h3>
            <div style="display:flex; gap:8px;">
                <button class="btn-outline small" @onclick="() => EditarChamado(SelectedChamado)">✏️ Editar</button>
                <button class="btn-outline small" @onclick="() => AssumirChamado(SelectedChamado)">👨‍🔧 Assumir</button>
                <button class="btn-primary small" @onclick="() => FecharChamadoConfirm(SelectedChamado)">✅ Fechar</button>
            </div>
        </div>

        <div style="margin-top:8px;">
            <p><strong>Pergunta:</strong> @SelectedChamado.Pergunta</p>
            <p><strong>Sugestão (IA):</strong> @SelectedChamado.Resposta</p>
            <p><strong>Data:</strong> @SelectedChamado.Data.ToString("g")</p>
            <p><strong>Técnico:</strong> @(string.IsNullOrEmpty(SelectedChamado.Tecnico) ? "—" : SelectedChamado.Tecnico)</p>
            <p><strong>Status:</strong> @(SelectedChamado.Fechado ? "Fechado" : SelectedChamado.Cancelado ? "Cancelado" : "Aberto")</p>
        </div>

        <hr />

        <div>
            <h4>Comentários</h4>
            <div class="comments">
                @if (!SelectedChamado.Comments.Any())
                {
                    <div class="empty">Sem comentários ainda.</div>
                }
                else
                {
                    @foreach (var cm in SelectedChamado.Comments)
                    {
                        <div class="comment">
                            <div><strong>@cm.Author</strong> <span class="small meta">@cm.When.ToString("g")</span></div>
                            <div>@cm.Text</div>
                        </div>
                    }
                }
            </div>

            <div class="comment-box">
                <input placeholder="Escreva uma observação..." @bind="NewCommentText" @onkeydown="OnCommentKey" />
                <button class="btn-primary small" @onclick="EnviarComentario">Enviar</button>
            </div>
        </div>

        <div style="margin-top:12px; display:flex; gap:8px; justify-content:flex-end;">
            <button class="btn-outline" @onclick="CloseDetalhe">Fechar</button>
        </div>
    </div>
}

@if (FormCriarAberto)
{
    <div class="modal-overlay" @onclick="FecharFormCriar"></div>
    <div class="modal" @onclick:stopPropagation>
        <h3>Criar Chamado (teste)</h3>
        <label>Título</label>
        <input @bind="FormTitulo" />
        <label>Pergunta</label>
        <textarea @bind="FormPergunta"></textarea>
        <label>Sugestão IA (opcional)</label>
        <input @bind="FormSugestao" />
        <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:8px;">
            <button class="btn-outline" @onclick="FecharFormCriar">Cancelar</button>
            <button class="btn-primary" @onclick="CriarChamadoLocal">Criar</button>
        </div>
    </div>
}

@if (ConfirmAction)
{
    <div class="modal-overlay" @onclick="CancelConfirm"></div>
    <div class="modal" @onclick:stopPropagation>
        <h3>@ConfirmTitle</h3>
        <p>@ConfirmMessage</p>
        <div style="display:flex; gap:8px; justify-content:flex-end;">
            <button class="btn-outline" @onclick="CancelConfirm">Cancelar</button>
            <button class="btn-primary" @onclick="ConfirmPerformWrapper">Confirmar</button>
        </div>
    </div>
}

<style>
    :root { --primary: #2064F8; --primary-dark: #133B92; --muted: #6b7280; --bg: #ffffff; }
    .painel-tecnico { max-width: 1100px; margin: 32px auto; padding: 20px; box-sizing: border-box; font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial; }
    .header { display:flex; justify-content:space-between; align-items:center; gap:16px; background: linear-gradient(135deg,var(--primary),var(--primary-dark)); color:white; padding:18px; border-radius:14px; box-shadow: 0 12px 36px rgba(19,59,146,0.12); }
    .header h2 { margin:0; font-size:22px; font-weight:700; }
    .header .header-actions { display:flex; gap:8px; align-items:center; }
    .btn-outline { background:white; color:var(--primary); border:none; padding:8px 12px; border-radius:8px; cursor:pointer; font-weight:700; }
    .btn-primary { background: linear-gradient(90deg,var(--primary),var(--primary-dark)); color:white; border:none; padding:8px 12px; border-radius:8px; cursor:pointer; font-weight:700; }
    .btn-mini { background:#f1f5f9; border:none; padding:6px 8px; border-radius:8px; cursor:pointer; }
    .notificacao { position:relative; cursor:pointer; font-size:26px; }
    .badge { position:absolute; top:-8px; right:-10px; background:#ff3b30; color:white; padding:6px 8px; border-radius:999px; font-weight:700; box-shadow:0 6px 16px rgba(0,0,0,0.12); }
    .subtitulo { margin:12px 0 18px; color:#222; }
    .tabs { display:flex; gap:8px; margin-bottom:12px; }
    .tab { padding:8px 12px; border-radius:10px; border:1px solid #e9eefc; background:#fff; cursor:pointer; font-weight:700; }
    .tab.active { background:linear-gradient(90deg,var(--primary),var(--primary-dark)); color:white; }
    .lista-chamados { display:flex; flex-direction:column; gap:12px; }
    .chamado-card { background:#fff; padding:14px; border-radius:10px; border:1px solid #eef5ff; box-shadow:0 6px 20px rgba(19,59,146,0.04); }
    .meta-line { display:flex; gap:12px; align-items:center; margin-top:6px; color:var(--muted); }
    .tag { background:#f1f5f9; padding:4px 8px; border-radius:999px; font-size:12px; color:var(--muted); font-weight:700; }
    .card-actions { display:flex; gap:8px; margin-top:10px; justify-content:flex-end; }
    .kanban { display:flex; gap:12px; }
    .kanban-col { background:#fbfdff; padding:12px; border-radius:10px; flex:1; min-height:200px; }
    .kanban-col h4 { margin-top:0; }
    .card-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
    .title { font-weight:700; }
    .modal-overlay { position:fixed; inset:0; background: rgba(0,0,0,0.45); backdrop-filter: blur(3px); z-index:9998; }
    .modal { position:fixed; left:50%; top:50%; transform:translate(-50%,-50%); background:white; padding:18px; border-radius:12px; width:480px; max-width:calc(100% - 32px); z-index:9999; box-shadow:0 30px 80px rgba(2,6,23,0.12); }
    .modal.large { width:800px; max-width:calc(100% - 32px); }
    .comments { max-height:200px; overflow:auto; display:flex; flex-direction:column; gap:8px; padding:6px 0; }
    .comment { padding:8px; background:#fbfdff; border-radius:8px; border:1px solid #eef5ff; }
    .comment-box { display:flex; gap:8px; margin-top:8px; }
    .comment-box input { flex:1; padding:8px 10px; border-radius:8px; border:1px solid #e6e9f2; }
    .empty { color:var(--muted); padding:12px 0; }
    .btn-fechar { background:#666; color:white; border:none; padding:8px 12px; border-radius:8px; cursor:pointer; }
    .small { font-size:13px; }
    .m-0 { margin:0; }
    .mb-3 { margin-bottom:12px; }
    @@media (max-width:900px) { .kanban { flex-direction:column; } .header { flex-direction:column; align-items:flex-start; gap:12px; } }
</style>

@code {
    readonly string apiBase = "/Chamados";

    public class ChamadoDTO
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Titulo { get; set; } = "";
        public string Pergunta { get; set; } = "";
        public string Resposta { get; set; } = "";
        public DateTime Data { get; set; } = DateTime.Now;
        public string Tecnico { get; set; } = "";
        public bool Fechado { get; set; } = false;
        public bool Cancelado { get; set; } = false;
        public bool Expirado { get; set; } = false;
        public List<CommentDTO> Comments { get; set; } = new();
    }
    public class CommentDTO { public string Author { get; set; } = "Técnico"; public string Text { get; set; } = ""; public DateTime When { get; set; } = DateTime.Now; }

    List<ChamadoDTO> Chamados = new();
    bool ModalAberto = false;
    bool ListaCarregando = false;
    bool IsKanban = false;

    enum Tab { Pendentes, EmAtendimento, Expirados }
    Tab ActiveTab = Tab.Pendentes;

    bool DetalheAberto = false;
    ChamadoDTO SelectedChamado;
    string NewCommentText = "";

    bool FormCriarAberto = false;
    string FormTitulo = "";
    string FormPergunta = "";
    string FormSugestao = "";

    bool ConfirmAction = false;
    string ConfirmTitle = "";
    string ConfirmMessage = "";
    Func<Task> ConfirmPerform = null;

    int CountPendentes => Chamados.Count(x => string.IsNullOrEmpty(x.Tecnico) && !x.Cancelado && !x.Fechado);
    int CountEmAtendimento => Chamados.Count(x => !string.IsNullOrEmpty(x.Tecnico) && !x.Fechado && !x.Cancelado);
    int CountExpirados => Chamados.Count(x => x.Expirado && !x.Fechado && !x.Cancelado);

    protected override async Task OnInitializedAsync()
    {
        await LoadFromLocalStorage();
        await RefreshChamados();
    }

    async Task LoadFromLocalStorage()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", "chamados_tecnico");
            if (!string.IsNullOrEmpty(json))
            {
                Chamados = JsonSerializer.Deserialize<List<ChamadoDTO>>(json) ?? new();
            }
        }
        catch { Chamados = new(); }
    }

    async Task PersistToLocalStorage()
    {
        try
        {
            var json = JsonSerializer.Serialize(Chamados);
            await JS.InvokeVoidAsync("localStorage.setItem", "chamados_tecnico", json);
        }
        catch { /* ignore */ }
    }

    async Task RefreshChamados()
    {
        ListaCarregando = true;
        StateHasChanged();

        try
        {
            var res = await Http.GetAsync($"{apiBase}/pendentes-tecnico");
            if (res.IsSuccessStatusCode)
            {
                var list = await res.Content.ReadFromJsonAsync<List<ChamadoDTO>>();
                if (list != null) Chamados = list;
                await PersistToLocalStorage();
            }
            else
            {
                var res2 = await Http.GetAsync($"{apiBase}");
                if (res2.IsSuccessStatusCode)
                {
                    var all = await res2.Content.ReadFromJsonAsync<List<ChamadoDTO>>();
                    if (all != null) Chamados = all;
                    await PersistToLocalStorage();
                }
            }
        }
        catch
        {
            // fallback to local
        }

        ListaCarregando = false;
        StateHasChanged();
    }

    IEnumerable<ChamadoDTO> ChamadosToShow()
    {
        return ActiveTab switch
        {
            Tab.Pendentes => Chamados.Where(x => string.IsNullOrEmpty(x.Tecnico) && !x.Cancelado && !x.Fechado).OrderByDescending(x => x.Data),
            Tab.EmAtendimento => Chamados.Where(x => !string.IsNullOrEmpty(x.Tecnico) && !x.Fechado && !x.Cancelado).OrderByDescending(x => x.Data),
            Tab.Expirados => Chamados.Where(x => x.Expirado && !x.Fechado && !x.Cancelado).OrderByDescending(x => x.Data),
            _ => Chamados
        };
    }

    void SelectTab(Tab t) { ActiveTab = t; }

    void ToggleView() { IsKanban = !IsKanban; }

    void AbrirModalChamados() => ModalAberto = true;
    void CloseModal() => ModalAberto = false;

    void AbrirDetalhe(ChamadoDTO c)
    {
        SelectedChamado = c;
        DetalheAberto = true;
    }
    void CloseDetalhe()
    {
        SelectedChamado = null;
        DetalheAberto = false;
        NewCommentText = "";
    }

    void AbrirFormCriar() { FormCriarAberto = true; }
    void FecharFormCriar() { FormCriarAberto = false; FormTitulo = ""; FormPergunta = ""; FormSugestao = ""; }

    async Task AssumirChamado(ChamadoDTO chamado)
    {
        try
        {
            var res = await Http.PatchAsync($"{apiBase}/{chamado.Id}/acatar-chamado", JsonContent.Create(new { tecnico = "TécnicoLocal" }));
            if (res.IsSuccessStatusCode)
            {
                var updated = await res.Content.ReadFromJsonAsync<ChamadoDTO>();
                if (updated != null)
                {
                    var idx = Chamados.FindIndex(x => x.Id == updated.Id);
                    if (idx >= 0) Chamados[idx] = updated;
                    else Chamados.Add(updated);
                }
            }
            else
            {
                chamado.Tecnico = "TécnicoLocal";
            }
        }
        catch
        {
            chamado.Tecnico = "TécnicoLocal";
        }
        await PersistToLocalStorage();
        StateHasChanged();
    }

    async Task EnviarComentario()
    {
        if (SelectedChamado == null || string.IsNullOrWhiteSpace(NewCommentText)) return;
        var comment = new CommentDTO { Author = "Técnico", Text = NewCommentText.Trim(), When = DateTime.Now };

        try
        {
            var res = await Http.PatchAsync($"{apiBase}/{SelectedChamado.Id}/comentar", JsonContent.Create(comment));
            if (res.IsSuccessStatusCode)
            {
                var updated = await res.Content.ReadFromJsonAsync<ChamadoDTO>();
                if (updated != null) SelectedChamado = updated;
            }
            else
            {
                SelectedChamado.Comments.Add(comment);
            }
        }
        catch
        {
            SelectedChamado.Comments.Add(comment);
        }

        var idx = Chamados.FindIndex(x => x.Id == SelectedChamado.Id);
        if (idx >= 0) Chamados[idx] = SelectedChamado;
        await PersistToLocalStorage();

        NewCommentText = "";
        await Task.Delay(80);
        StateHasChanged();
    }

    async Task FecharChamadoConfirm(ChamadoDTO chamado)
    {
        ConfirmTitle = "Fechar chamado";
        ConfirmMessage = "Deseja marcar este chamado como finalizado?";
        ConfirmPerform = async () => await FecharChamado(chamado);
        ConfirmAction = true;
    }
    async Task FecharChamado(ChamadoDTO chamado)
    {
        ConfirmAction = false;
        try
        {
            var res = await Http.PatchAsync($"{apiBase}/{chamado.Id}/fechar-chamado", null);
            if (res.IsSuccessStatusCode)
            {
                var updated = await res.Content.ReadFromJsonAsync<ChamadoDTO>();
                if (updated != null)
                {
                    var idx = Chamados.FindIndex(x => x.Id == updated.Id);
                    if (idx >= 0) Chamados[idx] = updated;
                }
            }
            else
            {
                chamado.Fechado = true;
            }
        }
        catch
        {
            chamado.Fechado = true;
        }
        await PersistToLocalStorage();
        StateHasChanged();
    }

    async Task CancelarChamadoConfirm(ChamadoDTO chamado)
    {
        ConfirmTitle = "Cancelar chamado";
        ConfirmMessage = "Deseja cancelar este chamado?";
        ConfirmPerform = async () => await CancelarChamado(chamado);
        ConfirmAction = true;
    }
    async Task CancelarChamado(ChamadoDTO chamado)
    {
        ConfirmAction = false;
        try
        {
            var res = await Http.PatchAsync($"{apiBase}/{chamado.Id}/cancelar", null);
            if (res.IsSuccessStatusCode)
            {
                var updated = await res.Content.ReadFromJsonAsync<ChamadoDTO>();
                if (updated != null)
                {
                    var idx = Chamados.FindIndex(x => x.Id == updated.Id);
                    if (idx >= 0) Chamados[idx] = updated;
                }
            }
            else
            {
                chamado.Cancelado = true;
            }
        }
        catch
        {
            chamado.Cancelado = true;
        }
        await PersistToLocalStorage();
        StateHasChanged();
    }

    async Task MarcarResolveuSugestao(ChamadoDTO chamado, bool resolveu)
    {
        try
        {
            var res = await Http.PatchAsync($"{apiBase}/{chamado.Id}/alterar-resolveu-sugestao", JsonContent.Create(new { resolveu }));
            if (res.IsSuccessStatusCode)
            {
                var updated = await res.Content.ReadFromJsonAsync<ChamadoDTO>();
                if (updated != null)
                {
                    var idx = Chamados.FindIndex(x => x.Id == updated.Id);
                    if (idx >= 0) Chamados[idx] = updated;
                    SelectedChamado = updated;
                }
            }
            else
            {
                chamado.Comments.Add(new CommentDTO { Author = "Sistema", Text = resolveu ? "Sugestão marcada como útil" : "Sugestão não foi útil", When = DateTime.Now });
            }
        }
        catch
        {
            chamado.Comments.Add(new CommentDTO { Author = "Sistema", Text = resolveu ? "Sugestão marcada como útil" : "Sugestão não foi útil", When = DateTime.Now });
        }
        await PersistToLocalStorage();
        StateHasChanged();
    }

    async Task EditarChamado(ChamadoDTO chamado)
    {
        SelectedChamado = chamado;
        FormTitulo = chamado.Titulo;
        FormPergunta = chamado.Pergunta;
        FormSugestao = chamado.Resposta;
        FormCriarAberto = true;
    }

    async Task CriarChamadoLocal()
    {
        var novo = new ChamadoDTO
        {
            Id = Guid.NewGuid().ToString(),
            Titulo = FormTitulo,
            Pergunta = FormPergunta,
            Resposta = FormSugestao,
            Data = DateTime.Now
        };
        Chamados.Add(novo);
        await PersistToLocalStorage();
        FecharFormCriar();
        StateHasChanged();
    }

    void CancelConfirm()
    {
        ConfirmAction = false;
        ConfirmPerform = null;
    }
    async Task ConfirmPerformWrapper()
    {
        if (ConfirmPerform != null) await ConfirmPerform();
        ConfirmAction = false;
        ConfirmPerform = null;
        StateHasChanged();
    }

    async Task OnCommentKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await EnviarComentario();
    }

    async Task ScrollToTop() { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); }
}