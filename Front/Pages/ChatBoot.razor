@page "/chatboot"
@using System.Text.Json
@using System.Threading
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Painel do Colaborador</PageTitle>

<link rel="stylesheet" href="css/ChatBoot.css" />

<div class="chat-container">

    <div class="chat-header">
        💬 Assistente Virtual
    </div>

    <div class="chat-window" id="chatWindow">

        @if (SemChamado)
        {
            <div class="message bot">
                <div class="avatar bot-avatar">🤖</div>
                <div class="bubble bot-bubble animate">
                    Não encontrei nenhum chamado ativo.<br />
                    Abra um chamado no painel para iniciar a conversa comigo!
                </div>
            </div>
        }
        else
        {
            <!-- Mensagem do usuário -->
            @if (!string.IsNullOrEmpty(UserMessage))
            {
                <div class="message user">
                    <div class="avatar user-avatar">🧑</div>
                    <div class="bubble user-bubble">@UserMessage</div>
                </div>
            }

            <!-- Mensagem inicial do bot -->
            <div class="message bot">
                <div class="avatar bot-avatar">🤖</div>
                <div class="bubble bot-bubble animate">
                    Olá! Vou analisar a descrição do chamado e sugerir uma possível solução.
                </div>
            </div>

            <!-- Indicação que a IA está sendo gerada -->
            @if (IsWaitingSuggestion)
            {
                <div class="message bot">
                    <div class="avatar bot-avatar">🤖</div>
                    <div class="bubble bot-bubble animate">
                        Gerando sugestão da IA... <span class="dots">●●●</span>
                    </div>
                </div>
            }

            <!-- Sugestão da IA -->
            @if (!string.IsNullOrEmpty(BotMessage) && !IsWaitingSuggestion)
            {
                <div class="message bot">
                    <div class="avatar bot-avatar">🤖</div>
                    <div class="bubble bot-bubble animate">@BotMessage</div>
                </div>
            }

            @if (AwaitingResolution)
            {
                <div class="message bot">
                    <div class="avatar bot-avatar">🤖</div>
                    <div class="bubble bot-bubble animate">
                        A sugestão acima ajudou a resolver seu problema?<br />
                        Responda: <strong>Sim</strong> ou <strong>Não</strong>.
                    </div>
                </div>

                <input class="resolution-input" @bind="UserResolution" @bind:event="oninput" placeholder="Digite Sim ou Não" />
                <button class="btn-send" @onclick="ProcessarResposta">@((processingResponse) ? "Enviando..." : "Enviar")</button>
            }
        }
    </div>
</div>

@code {
    bool SemChamado = false;
    bool AwaitingResolution = false;
    bool processingResponse = false;

    Guid ChamadoId;
    string UserMessage = "";
    string BotMessage = "";
    string UserResolution = "";

    bool IsWaitingSuggestion = false;
    CancellationTokenSource? pollingCts;

    const int PollIntervalMs = 3000;
    const int MaxPollAttempts = 10;

    protected override async Task OnInitializedAsync()
    {
        await InicializarChat();
    }

    async Task InicializarChat()
    {
        SemChamado = false;
        AwaitingResolution = false;
        processingResponse = false;
        IsWaitingSuggestion = false;

        string? chamadoStr = null;
        try { chamadoStr = await JS.InvokeAsync<string>("localStorage.getItem", "chamadoId"); } catch { }

        if (string.IsNullOrEmpty(chamadoStr) || !Guid.TryParse(chamadoStr, out ChamadoId))
        {
            SemChamado = true;
            return;
        }

        try { UserMessage = await JS.InvokeAsync<string>("localStorage.getItem", "chatPergunta") ?? ""; } catch { }

        await EnsureAuthAsync();

        try
        {
            var resp = await Http.GetAsync($"Chamados/{ChamadoId}");
            if (!resp.IsSuccessStatusCode)
            {
                SemChamado = string.IsNullOrEmpty(UserMessage);
                return;
            }

            var json = await resp.Content.ReadAsStringAsync();
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            if (root.TryGetProperty("descricao", out var descProp) && descProp.ValueKind == JsonValueKind.String)
            {
                var desc = descProp.GetString() ?? "";
                if (string.IsNullOrWhiteSpace(UserMessage) && !string.IsNullOrWhiteSpace(desc))
                {
                    UserMessage = desc;
                    await JS.InvokeVoidAsync("localStorage.setItem", "chatPergunta", desc);
                }
            }

            if (root.TryGetProperty("sugestaoGemini", out var sgProp) && sgProp.ValueKind == JsonValueKind.String)
            {
                BotMessage = sgProp.GetString() ?? "";
                if (!string.IsNullOrEmpty(BotMessage))
                    await JS.InvokeVoidAsync("localStorage.setItem", "chatResposta", BotMessage);
            }

            bool? resolveu = null;
            if (root.TryGetProperty("sugestaoResolveu", out var srProp) && srProp.ValueKind != JsonValueKind.Null)
            {
                if (srProp.ValueKind == JsonValueKind.True || srProp.ValueKind == JsonValueKind.False)
                    resolveu = srProp.GetBoolean();
            }

            AwaitingResolution = !string.IsNullOrEmpty(BotMessage) && (resolveu == null);
            SemChamado = string.IsNullOrEmpty(UserMessage) && string.IsNullOrEmpty(BotMessage);

            if (string.IsNullOrEmpty(BotMessage))
                _ = StartPollingForSuggestionAsync();
        }
        catch
        {
            SemChamado = string.IsNullOrEmpty(UserMessage);
        }
    }

    async Task StartPollingForSuggestionAsync()
    {
        pollingCts?.Cancel();
        pollingCts = new CancellationTokenSource();
        var ct = pollingCts.Token;

        IsWaitingSuggestion = true;
        int attempts = 0;

        try
        {
            while (attempts < MaxPollAttempts && !ct.IsCancellationRequested)
            {
                attempts++;
                await Task.Delay(PollIntervalMs, ct);
                await EnsureAuthAsync();

                HttpResponseMessage resp;
                try { resp = await Http.GetAsync($"Chamados/{ChamadoId}", ct); } catch { continue; }

                if (!resp.IsSuccessStatusCode)
                {
                    if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                    {
                        await JS.InvokeVoidAsync("alert", "Sessão expirada. Faça login novamente.");
                        Navigation.NavigateTo("/login");
                        return;
                    }
                    continue;
                }

                var json = await resp.Content.ReadAsStringAsync(ct);
                try
                {
                    using var doc = JsonDocument.Parse(json);
                    var root = doc.RootElement;

                    if (root.TryGetProperty("sugestaoGemini", out var sgProp) &&
                        sgProp.ValueKind == JsonValueKind.String)
                    {
                        var suggestion = sgProp.GetString() ?? "";
                        if (!string.IsNullOrWhiteSpace(suggestion))
                        {
                            BotMessage = suggestion;
                            await JS.InvokeVoidAsync("localStorage.setItem", "chatResposta", BotMessage);

                            bool? resolveu = null;
                            if (root.TryGetProperty("sugestaoResolveu", out var srProp) && srProp.ValueKind != JsonValueKind.Null)
                            {
                                if (srProp.ValueKind == JsonValueKind.True || srProp.ValueKind == JsonValueKind.False)
                                    resolveu = srProp.GetBoolean();
                            }

                            AwaitingResolution = !string.IsNullOrEmpty(BotMessage) && (resolveu == null);

                            IsWaitingSuggestion = false;
                            InvokeAsync(StateHasChanged);
                            break;
                        }
                    }
                }
                catch { }
            }
        }
        catch (TaskCanceledException) { }
        finally { IsWaitingSuggestion = false; }
    }

    async Task EnsureAuthAsync()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
            if (!string.IsNullOrWhiteSpace(token))
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
        catch { }
    }

    async Task ProcessarResposta()
    {
        if (string.IsNullOrWhiteSpace(UserResolution)) return;

        var resposta = UserResolution.Trim().ToLower();
        if (resposta != "sim" && resposta != "não" && resposta != "nao")
        {
            await JS.InvokeVoidAsync("alert", "Digite apenas: Sim ou Não.");
            return;
        }

        try { pollingCts?.Cancel(); } catch { }
        processingResponse = true;

        try
        {
            await EnsureAuthAsync();

            if (resposta == "sim")
            {
                try { await Http.PatchAsJsonAsync($"Chamados/{ChamadoId}/alterar-resolveu-sugestao", true); } catch { }
                BotMessage = "Perfeito! Seu chamado foi resolvido!";
                try
                {
                    await JS.InvokeVoidAsync("localStorage.removeItem", "chatPergunta");
                    await JS.InvokeVoidAsync("localStorage.removeItem", "chatResposta");
                    await JS.InvokeVoidAsync("localStorage.removeItem", "chamadoId");
                }
                catch { }
                AwaitingResolution = false;
                StateHasChanged();
                await Task.Delay(900);
                Navigation.NavigateTo("/painel-colaborador");
            }
            else
            {
                try { await Http.PatchAsJsonAsync($"Chamados/{ChamadoId}/alterar-resolveu-sugestao", false); } catch { }
                var pacote = new { Pergunta = UserMessage, Resposta = BotMessage, Data = DateTime.UtcNow };
                await JS.InvokeVoidAsync("localStorage.setItem", "chatTecnicoMensagemInicial", UserMessage);
                await JS.InvokeVoidAsync("localStorage.setItem", "chamadoTecnico", JsonSerializer.Serialize(pacote));
                await JS.InvokeVoidAsync("localStorage.removeItem", "chatPergunta");
                await JS.InvokeVoidAsync("localStorage.removeItem", "chatResposta");
                await JS.InvokeVoidAsync("localStorage.removeItem", "chamadoId");

                BotMessage = "Entendido! Vou encaminhar isso para um técnico.";
                AwaitingResolution = false;
                StateHasChanged();
                await Task.Delay(900);
                Navigation.NavigateTo("/chat-colaborador");
            }
        }
        finally
        {
            processingResponse = false;
            UserResolution = "";
        }
    }

    public void Dispose()
    {
        try { pollingCts?.Cancel(); pollingCts?.Dispose(); } catch { }
    }
}