@page "/chatboot"
@using System.Text.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>ChatBoot</PageTitle>

<div class="chat-container">

    <div class="chat-header">
        💬 Assistente Virtual
    </div>

    <div class="chat-window" id="chatWindow">

        @if (SemChamado)
        {
            <div class="message bot">
                <div class="avatar bot-avatar">🤖</div>
                <div class="bubble bot-bubble animate">
                    Não encontrei nenhum chamado ativo.<br />
                    Abra um chamado no painel para iniciar a conversa comigo!
                </div>
            </div>
        }
        else
        {
            <!-- Mensagem inicial do bot -->
            <div class="message bot">
                <div class="avatar bot-avatar">🤖</div>
                <div class="bubble bot-bubble animate">
                    Olá! Vou analisar a descrição do chamado e sugerir uma possível solução.
                </div>
            </div>

            <!-- Mensagem do usuário -->
            @if (!string.IsNullOrEmpty(UserMessage))
            {
                <div class="message user">
                    <div class="avatar user-avatar">🧑</div>
                    <div class="bubble user-bubble">@UserMessage</div>
                </div>
            }

            <!-- Sugestão da IA -->
            @if (!string.IsNullOrEmpty(BotMessage))
            {
                <div class="message bot">
                    <div class="avatar bot-avatar">🤖</div>
                    <div class="bubble bot-bubble animate">@BotMessage</div>
                </div>
            }

            @if (AwaitingResolution)
            {
                <div class="message bot">
                    <div class="avatar bot-avatar">🤖</div>
                    <div class="bubble bot-bubble animate">
                        A sugestão acima ajudou a resolver seu problema?<br />
                        Responda: <strong>Sim</strong> ou <strong>Não</strong>.
                    </div>
                </div>

                <input class="resolution-input"
                       @bind="UserResolution"
                       @bind:event="oninput"
                       placeholder="Digite Sim ou Não" />

                <button class="btn-send" @onclick="ProcessarResposta">Enviar</button>
            }
        }
    </div>
</div>

@code {

    bool SemChamado = false;
    bool AwaitingResolution = false;

    Guid ChamadoId;
    string UserMessage = "";
    string BotMessage = "";
    string UserResolution = "";

    protected override async Task OnInitializedAsync()
    {
        // Recupera ID
        var chamadoStr = await JS.InvokeAsync<string>("localStorage.getItem", "chamadoId");

        if (string.IsNullOrEmpty(chamadoStr) || !Guid.TryParse(chamadoStr, out ChamadoId))
        {
            SemChamado = true;
            return;
        }

        // Recupera apenas a descrição que veio do Painel
        UserMessage = await JS.InvokeAsync<string>("localStorage.getItem", "chatPergunta");

        try
        {
            // Busca o chamado completo na API
            var json = await Http.GetStringAsync($"Chamados/{ChamadoId}");
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            // Sugestão da IA
            if (root.TryGetProperty("sugestaoGemini", out var sProp) &&
                sProp.ValueKind == JsonValueKind.String)
            {
                BotMessage = sProp.GetString();
                await JS.InvokeVoidAsync("localStorage.setItem", "chatResposta", BotMessage);
            }

            // Se não há sugestão ainda, aguarda nada
            if (string.IsNullOrEmpty(BotMessage))
            {
                BotMessage = "Ainda não há resposta gerada pelo sistema.";
                AwaitingResolution = false;
                return;
            }

            // Verifica se já existe resposta dada pelo usuário
            bool? resolveu = null;

            if (root.TryGetProperty("sugestaoResolveu", out var resProp) &&
                resProp.ValueKind != JsonValueKind.Null)
            {
                resolveu = resProp.GetBoolean();
            }

            AwaitingResolution = (resolveu == null);

        }
        catch
        {
            SemChamado = true;
        }
    }

    async Task ProcessarResposta()
    {
        if (string.IsNullOrWhiteSpace(UserResolution))
            return;

        string resposta = UserResolution.Trim().ToLower();

        if (resposta != "sim" && resposta != "não" && resposta != "nao")
        {
            await JS.InvokeVoidAsync("alert", "Digite apenas: Sim ou Não.");
            return;
        }

        if (resposta == "sim")
        {
            await Http.PatchAsJsonAsync($"Chamados/{ChamadoId}/alterar-resolveu-sugestao", true);

            BotMessage = "Perfeito! Seu chamado foi resolvido!";

            // Limpa tudo
            await JS.InvokeVoidAsync("localStorage.clear");

            AwaitingResolution = false;

            await Task.Delay(1000);
            Navigation.NavigateTo("/painel-colaborador");
        }
        else
        {
            await Http.PatchAsJsonAsync($"Chamados/{ChamadoId}/alterar-resolveu-sugestao", false);

            // Envia para o técnico
            var pacote = new
            {
                Pergunta = UserMessage,
                Resposta = BotMessage,
                Data = DateTime.UtcNow
            };

            var json = JsonSerializer.Serialize(pacote);

            await JS.InvokeVoidAsync("localStorage.setItem", "chatTecnicoMensagemInicial", UserMessage);
            await JS.InvokeVoidAsync("localStorage.setItem", "chamadoTecnico", json);

            BotMessage = "Entendido! Vou encaminhar isso para um técnico.";

            await JS.InvokeVoidAsync("localStorage.clear");

            AwaitingResolution = false;

            await Task.Delay(900);
            Navigation.NavigateTo("/chat-colaborador");
        }
    }
}