@page "/chatboot"
@using System.Text.Json

@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>ChatBoot</PageTitle>

<!-- Botão Flutuante -->
<div class="chatboot-float-btn" @onclick="ToggleChat">
    💬
</div>

<!-- Container Flutuante -->
<div class="chatboot-panel @(IsOpen ? "open" : "")">
    <div class="panel-header">
        <strong>ChatBoot IA</strong>
        <button class="close-btn" @onclick="ToggleChat">✖</button>
    </div>

    <div class="chat-window" id="chatWindow">

        <!-- Mensagem inicial obrigatória -->
        <div class="message bot">
            <div class="avatar">🤖</div>
            <div class="bubble">
                Espere até que um técnico possa entrar em contato para resolver o problema.
            </div>
        </div>

        <div class="message bot">
            <div class="avatar">🤖</div>
            <div class="bubble">
                Olá! Sou seu assistente virtual. Aqui está a análise do seu chamado!
            </div>
        </div>

        @if (!string.IsNullOrEmpty(UserMessage))
        {
            <div class="message user">
                <div class="avatar">🧑</div>
                <div class="bubble">@UserMessage</div>
            </div>
        }

        @if (!string.IsNullOrEmpty(BotMessage))
        {
            <div class="message bot">
                <div class="avatar">🤖</div>
                <div class="bubble">@BotMessage</div>
            </div>
        }

        @if (!string.IsNullOrEmpty(UserMessage))
        {
            <div class="resolve-question mb-3">
                <p>Essa sugestão resolveu o chamado?</p> <br/>
                <button class="btn-resolve" @onclick="ResolveuChamado">Sim ✅</button>
                <button class="btn-not-resolve" @onclick="NaoResolveuChamado">Não ❌</button>
            </div>
        }
    </div>
</div>

<style>

    /* Botão Flutuante */
    .chatboot-float-btn {
        position: fixed;
        bottom: 25px;
        right: 25px;
        background: #0d6efd;
        color: white;
        padding: 14px 18px;
        border-radius: 50%;
        font-size: 22px;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(0,0,0,0.25);
        z-index: 9999;
    }

    /* Painel Flutuante */
    .chatboot-panel {
        position: fixed;
        bottom: 90px;
        right: 25px;
        width: 360px;
        height: 480px;
        background: #f8f9fa;
        border-radius: 16px;
        box-shadow: 0 4px 22px rgba(0,0,0,0.30);
        transform: translateY(120%);
        opacity: 0;
        visibility: hidden;
        transition: 0.3s ease-in-out;
        display: flex;
        flex-direction: column;
        z-index: 9999;
    }

    .chatboot-panel.open {
        transform: translateY(0%);
        opacity: 1;
        visibility: visible;
    }

    .panel-header {
        padding: 12px;
        font-size: 16px;
        background: #ffffff;
        border-bottom: 1px solid #ddd;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 16px 16px 0 0;
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
    }

    .chat-window {
        flex: 1;
        overflow-y: auto;
        padding: 15px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .message {
        display: flex;
        gap: 10px;
        align-items: flex-start;
    }

    .message.user {
        flex-direction: row-reverse;
    }

    .avatar {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #e0e0e0;
        border-radius: 50%;
        font-size: 18px;
    }

    .bubble {
        max-width: 70%;
        padding: 10px 14px;
        border-radius: 20px;
        font-size: 14px;
        line-height: 1.4;
        word-break: break-word;
    }

    .message.bot .bubble {
        background: #ffffff;
        border: 1px solid #ddd;
    }

    .message.user .bubble {
        background: #007bff;
        color: #ffffff;
    }

    .resolve-question {
        display: flex;
        gap: 10px;
        margin-top: 10px;
        align-items: center;
    }

    .btn-resolve, .btn-not-resolve {
        padding: 6px 12px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        font-weight: bold;
        font-size: 14px;
    }

    .btn-resolve {
        background: #28a745;
        color: white;
    }

    .btn-not-resolve {
        background: #dc3545;
        color: white;
    }
</style>

@code {

    bool IsOpen = false;

    string UserMessage = "";
    string BotMessage = "";

    protected override async Task OnInitializedAsync()
    {
        UserMessage = await JS.InvokeAsync<string>("localStorage.getItem", "chatPergunta");
        BotMessage = await JS.InvokeAsync<string>("localStorage.getItem", "chatResposta");
        StateHasChanged();
    }

    void ToggleChat()
    {
        IsOpen = !IsOpen;
    }

    async Task ResolveuChamado()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "chatPergunta");
        await JS.InvokeVoidAsync("localStorage.removeItem", "chatResposta");

        UserMessage = "";
        BotMessage = "";
        StateHasChanged();
    }

    async Task NaoResolveuChamado()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "chatTecnicoMensagemInicial", UserMessage);

        var chamado = new { Pergunta = UserMessage, Resposta = BotMessage, Data = DateTime.Now };
        string json = JsonSerializer.Serialize(chamado);

        await JS.InvokeVoidAsync("localStorage.setItem", "chamadoTecnico", json);

        await JS.InvokeVoidAsync("localStorage.removeItem", "chatPergunta");
        await JS.InvokeVoidAsync("localStorage.removeItem", "chatResposta");

        Navigation.NavigateTo("/painel-tecnico");
    }
}