@page "/chatboot"

@using System.Text.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Painel do Colaborador</PageTitle>

<link rel="stylesheet" href="css/ChatBoot.css" />

<div class="chat-container">

    <div class="chat-header">
        💬 Assistente Virtual
    </div>

    <div class="chat-window" id="chatWindow">

        @if (SemChamado)
        {
            <div class="message bot">
                <div class="avatar bot-avatar">🤖</div>
                <div class="bubble bot-bubble animate">
                    Não encontrei nenhum chamado ativo.<br />
                    Abra um chamado no painel para iniciar a conversa comigo!
                </div>
            </div>
        }
        else
        {
            @* Mensagem original do colaborador (descrição do chamado) *@
            @if (!string.IsNullOrEmpty(UserMessage))
            {
                <div class="message user">
                    <div class="avatar user-avatar">🧑</div>
                    <div class="bubble user-bubble">@UserMessage</div>
                </div>
            }

            @* Saudação inicial da IA *@
            <div class="message bot">
                <div class="avatar bot-avatar">🤖</div>
                <div class="bubble bot-bubble animate">
                    Olá! Vou analisar a descrição do chamado e sugerir uma possível solução.
                </div>
            </div>

            @* Estado: carregando sugestão *@
            @if (IsWaitingSuggestion)
            {
                <div class="message bot">
                    <div class="avatar bot-avatar">🤖</div>
                    <div class="bubble bot-bubble animate">
                        Gerando sugestão da IA... <span class="dots">●●●</span>
                    </div>
                </div>
            }

            @* Sugestão pronta *@
            @if (!string.IsNullOrEmpty(BotMessage) && !IsWaitingSuggestion)
            {
                <div class="message bot">
                    <div class="avatar bot-avatar">🤖</div>
                    <div class="bubble bot-bubble animate">@BotMessage</div>
                </div>
            }

            @* Pergunta se resolveu + campo de resposta *@
            @if (AwaitingResolution)
            {
                <div class="message bot">
                    <div class="avatar bot-avatar">🤖</div>
                    <div class="bubble bot-bubble animate">
                        A sugestão acima ajudou a resolver seu problema?<br />
                        Responda: <strong>Sim</strong> ou <strong>Não</strong>.
                    </div>
                </div>

                <div class="resolution-area">
                    <input class="resolution-input"
                           @bind="UserResolution"
                           @bind:event="oninput"
                           placeholder="Digite Sim ou Não" />

                    <button class="btn-send"
                            @onclick="ProcessarResposta"
                            disabled="@processingResponse">
                        @(processingResponse ? "Enviando..." : "Enviar")
                    </button>
                </div>
            }

            @* Mensagem final após o usuário responder (já está em BotMessage) *@
            @if (MostrandoMensagemFinal)
            {
                <div class="message bot">
                    <div class="avatar bot-avatar">🤖</div>
                    <div class="bubble bot-bubble animate">
                        @BotMessage
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {

    bool SemChamado = false;
    bool AwaitingResolution = false;
    bool processingResponse = false;
    bool IsWaitingSuggestion = false;
    bool MostrandoMensagemFinal = false;

    string ChamadoId = "";
    string UserMessage = "";
    string BotMessage = "";
    string UserResolution = "";
    string SugestaoOriginal = "";

    protected override async Task OnInitializedAsync()
    {
        SemChamado = false;
        AwaitingResolution = false;
        IsWaitingSuggestion = false;
        MostrandoMensagemFinal = false;

        // 1. Carrega dados do localStorage
        ChamadoId = await JS.InvokeAsync<string>("localStorage.getItem", "chamadoId");
        UserMessage = await JS.InvokeAsync<string>("localStorage.getItem", "chatPergunta") ?? "";
        SugestaoOriginal = await JS.InvokeAsync<string>("localStorage.getItem", "sugestaoGemini") ?? "";

        // 2. Se não existir chamado → mensagem inicial
        if (string.IsNullOrWhiteSpace(ChamadoId))
        {
            SemChamado = true;
            return;
        }

        // 3. Se a IA JÁ MANDOU sugestão (vem no POST /Chamados)
        if (!string.IsNullOrWhiteSpace(SugestaoOriginal))
        {
            // Mostra primeiro "Gerando sugestão..." e depois a sugestão de fato
            IsWaitingSuggestion = true;
            AwaitingResolution = false;
            BotMessage = string.Empty;

            _ = Task.Run(async () =>
            {
                await Task.Delay(1800); // tempo da animação "Gerando sugestão..."
                BotMessage = SugestaoOriginal;
                IsWaitingSuggestion = false;
                AwaitingResolution = true;
                await InvokeAsync(StateHasChanged);
            });

            return;
        }

        // 4. Se não veio sugestão no localStorage, algo deu errado na criação
        BotMessage = "Não foi possível carregar a sugestão da IA. Abra o chamado novamente.";
        IsWaitingSuggestion = false;
        AwaitingResolution = false;
    }

    async Task EnsureAuthAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
        Http.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
    }

    async Task ProcessarResposta()
    {
        if (string.IsNullOrWhiteSpace(UserResolution)) return;

        var resp = UserResolution.Trim().ToLower();

        if (resp != "sim" && resp != "nao" && resp != "não")
        {
            await JS.InvokeVoidAsync("alert", "Digite apenas SIM ou NÃO.");
            return;
        }

        processingResponse = true;
        StateHasChanged();

        await EnsureAuthAsync();

        bool resolveu = (resp == "sim");

        // PATCH: marcar se resolveu sugestão
        await Http.PatchAsJsonAsync($"Chamados/{ChamadoId}/alterar-resolveu-sugestao", resolveu);

        // Esconde pergunta + input
        AwaitingResolution = false;

        // Prepara mensagem final
        if (resolveu)
        {
            BotMessage = "Perfeito! Sua solicitação foi marcada como resolvida. Obrigado por utilizar o assistente! ✅";
        }
        else
        {
            BotMessage = "Entendido! Seu chamado será encaminhado automaticamente para um técnico humano dar continuidade ao atendimento. 👨‍🔧";
        }

        MostrandoMensagemFinal = true;
        StateHasChanged();

        // Limpa/reseta localStorage conforme o fluxo original
        if (resolveu)
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "chatPergunta");
            await JS.InvokeVoidAsync("localStorage.removeItem", "sugestaoGemini");
            await JS.InvokeVoidAsync("localStorage.removeItem", "chamadoId");
        }
        else
        {
            // Guarda a pergunta para o técnico ver no painel dele
            await JS.InvokeVoidAsync("localStorage.setItem", "chatTecnicoMensagemInicial", UserMessage);

            await JS.InvokeVoidAsync("localStorage.removeItem", "chatPergunta");
            await JS.InvokeVoidAsync("localStorage.removeItem", "sugestaoGemini");
            await JS.InvokeVoidAsync("localStorage.removeItem", "chamadoId");
        }

        // Pequeno delay para o usuário "sentir" a resposta final
        await Task.Delay(1800);

        processingResponse = false;
        MostrandoMensagemFinal = false;

        // Volta para o painel do colaborador
        Navigation.NavigateTo("/painelcolaborador", true);
    }
}