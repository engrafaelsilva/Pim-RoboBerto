@page "/abrirchamado"

<PageTitle>Abrir Chamado</PageTitle>

<div class="chamado-container">
    <div class="chamado-card">
        <h2>Abrir Chamado</h2>
        <p class="subtitle">Preencha as informações abaixo</p>

        <EditForm OnValidSubmit="EnviarChamado">
            <div class="form-group">
                <label for="titulo">Título do Chamado</label>
                <InputText id="titulo" class="form-control" @bind-Value="titulo" 
                           placeholder="Ex: Erro ao fazer login no sistema" required />
            </div>

            <div class="form-group">
                <label for="descricao">Descrição</label>
                <InputTextArea id="descricao" class="form-control descricao" 
                               @bind-Value="descricao" 
                               placeholder="Descreva detalhadamente o problema..." required />
            </div>

            <div class="form-group">
                <label for="prioridade">Prioridade</label>
                <InputSelect id="prioridade" class="form-control" @bind-Value="prioridade" required>
                    <option value="">Selecione</option>
                    <option>Baixa</option>
                    <option>Média</option>
                    <option>Alta</option>
                </InputSelect>
            </div>

            <button type="submit" class="btn-enviar">Enviar Chamado</button>
        </EditForm>

        @if (!string.IsNullOrEmpty(mensagemSucesso))
        {
            <p class="success-msg">@mensagemSucesso</p>
        }
    </div>
</div>

<style>
    .chamado-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 90vh;
        background: #f4f6fb;
    }

    .chamado-card {
        background: white;
        width: 100%;
        max-width: 450px;
        padding: 40px 30px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        text-align: left;
    }

    .chamado-card h2 {
        text-align: center;
        color: #133B92;
        margin-bottom: 10px;
    }

    .subtitle {
        text-align: center;
        color: #555;
        margin-bottom: 25px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        font-weight: 600;
        color: #333;
        display: block;
        margin-bottom: 5px;
    }

    .form-control {
        width: 100%;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid #ccc;
        font-size: 15px;
    }

    .form-control:focus {
        border-color: #2064F8;
        outline: none;
        box-shadow: 0 0 5px rgba(32, 100, 248, 0.3);
    }

    .descricao {
        min-height: 120px;
        resize: vertical;
    }

    .btn-enviar {
        width: 100%;
        background: linear-gradient(90deg, #2064F8, #133B92);
        color: white;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: background 0.3s ease;
    }

    .btn-enviar:hover {
        background: linear-gradient(90deg, #174FCC, #0E2E73);
    }

    .success-msg {
        margin-top: 15px;
        text-align: center;
        color: #2064F8;
        font-weight: bold;
    }
</style>
    
@code {
    private string titulo = "";
    private string descricao = "";
    private string prioridade = "";
    private string? mensagemSucesso;

    private void EnviarChamado()
    {
        // Simulação de envio
        mensagemSucesso = "Chamado aberto com sucesso! 🎉";
        titulo = descricao = prioridade = "";
    }
}