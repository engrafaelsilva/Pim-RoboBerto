@page "/Categoria/Edit/{Id:guid}"
@using IA_RoboBerto.DTOs
@inject HttpClient Http
@inject NavigationManager NavigationManager

<h3 class="mb-4">Editar Categoria</h3>

@if (categoriaModel == null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <EditForm Model="categoriaModel" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Nome</label>
            <InputText class="form-control" @bind-Value="categoriaModel.Nome" />
            <ValidationMessage For="@(() => categoriaModel.Nome)" />
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Salvando...</span>
                }
                else
                {
                    <span>Salvar Alterações</span>
                }
            </button>
            <button type="button" class="btn btn-light ms-2" @onclick="HandleCancel">Cancelar</button>
        </div>

    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; } // 1. Recebe o Id da rota

    private CategoriaMinDTO categoriaModel;
    private bool isSubmitting = false;

    // 2. Busca os dados da categoria ao carregar a página
    protected override async Task OnInitializedAsync()
    {
        // Chama o endpoint GET By Id do seu CategoriaController
        categoriaModel = await Http.GetFromJsonAsync<CategoriaMinDTO>($"https://localhost:7187/Categoria/{Id}");
    }

    // 3. O método de submit agora usa HTTP PUT (Atualizar)
    private async Task HandleSubmit()
    {
        if (isSubmitting) return;

        try
        {
            isSubmitting = true;

            // Chama o endpoint PUT do seu CategoriaController
            var response = await Http.PutAsJsonAsync($"https://localhost:7187/Categoria/{Id}", categoriaModel);

            if (response.IsSuccessStatusCode)
            {
                // Volta para a lista
                NavigationManager.NavigateTo("/categorias");
            }
            else
            {
                Console.WriteLine("Erro ao atualizar a categoria.");
                isSubmitting = false;
            }
        }
        catch
        {
            isSubmitting = false;
        }
    }

    private void HandleCancel()
    {
        // Volta para a lista de categorias sem salvar
        NavigationManager.NavigateTo("/categorias");
    }
}