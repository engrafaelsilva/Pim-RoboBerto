@page "/chat-tecnico"
@using System.Text.Json
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Chat com Cliente</PageTitle>

<h3 class="mb-3">Chat com Cliente 🛠️</h3>

<div class="chat-container shadow rounded-4 p-3">

    <div class="chat-window" id="chatWindow">
        @foreach (var msg in Mensagens)
        {
            <div class="message @(msg.Remetente == "tecnico" ? "user" : "bot")">
                <div class="avatar">@((msg.Remetente == "tecnico") ? "👨‍🔧" : "🧑")</div>
                <div class="bubble">@msg.Texto</div>
            </div>
        }
    </div>

    <div class="chat-input mt-3 d-flex gap-2">
        <input class="form-control" @bind="NovaMensagem" @bind:event="oninput" placeholder="Digite sua mensagem..." />
        <button class="btn btn-primary" @onclick="EnviarMensagem">Enviar</button>
    </div>
</div>

<style>
    .chat-container {
    max-width: 700px;
    margin: 0 auto;
    background-color: #f8f9fa;
    display: flex;
    flex-direction: column;
    height: 80vh;
    }

    .chat-window {
    flex: 1;
    overflow-y: auto;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    }

    .message {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    }

    .message.user {
    flex-direction: row-reverse;
    }

    .avatar {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #e0e0e0;
    border-radius: 50%;
    font-size: 20px;
    }

    .bubble {
    max-width: 70%;
    padding: 10px 15px;
    border-radius: 20px;
    line-height: 1.4;
    word-wrap: break-word;
    font-size: 15px;
    }

    .message.bot .bubble {
    background-color: #ffffff;
    border: 1px solid #ddd;
    }

    .message.user .bubble {
    background-color: #007bff;
    color: white;
    }
</style>

@code {
    public class Mensagem
    {
        public string Remetente { get; set; }
        public string Texto { get; set; }
    }

    List<Mensagem> Mensagens = new();
    string NovaMensagem = "";
    PeriodicTimer timer;

    protected override async Task OnInitializedAsync()
    {
        await InicializarChat();
        StartTimer();
    }

    async Task InicializarChat()
    {
        var pergunta = await JS.InvokeAsync<string>("localStorage.getItem", "chatTecnicoMensagemInicial");
        var json = await JS.InvokeAsync<string>("localStorage.getItem", "chatTecnico");

        try
        {
            if (!string.IsNullOrEmpty(json))
            {
                Mensagens = JsonSerializer.Deserialize<List<Mensagem>>(json) ?? new();
            }
        }
        catch
        {
            Mensagens = new();
            await JS.InvokeVoidAsync("localStorage.removeItem", "chatTecnico");
        }

        if (Mensagens.Count == 0 && !string.IsNullOrEmpty(pergunta))
        {
            Mensagens.Add(new Mensagem
                {
                    Remetente = "cliente",
                    Texto = pergunta
                });

            await Salvar();
        }
    }

    async Task EnviarMensagem()
    {
        if (string.IsNullOrWhiteSpace(NovaMensagem))
            return;

        Mensagens.Add(new Mensagem
            {
                Remetente = "tecnico",
                Texto = NovaMensagem
            });

        await Salvar();
        NovaMensagem = "";
    }

    async Task Salvar()
    {
        var json = JsonSerializer.Serialize(Mensagens);
        await JS.InvokeVoidAsync("localStorage.setItem", "chatTecnico", json);
        await InvokeAsync(StateHasChanged);
    }

    void StartTimer()
    {
        timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        _ = Task.Run(async () =>
        {
            while (await timer.WaitForNextTickAsync())
            {
                await AtualizarMensagens();
            }
        });
    }

    async Task AtualizarMensagens()
    {
        var json = await JS.InvokeAsync<string>("localStorage.getItem", "chatTecnico");

        if (string.IsNullOrEmpty(json))
            return;

        try
        {
            var msgs = JsonSerializer.Deserialize<List<Mensagem>>(json) ?? new();

            if (msgs.Count != Mensagens.Count)
            {
                Mensagens = msgs;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch {}
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}