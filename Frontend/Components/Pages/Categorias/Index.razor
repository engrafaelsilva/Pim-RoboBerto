@page "/categorias"
@using IA_RoboBerto.DTOs
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h1 class="text-center mb-3">Lista de Categorias</h1>

<a class="btn btn-primary mb-3" href="/Categoria/Create">Nova Categoria</a>

@if (categorias == null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in categorias)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Nome</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-warning me-1" @onclick="async () => await Editar(item.Id)">Editar</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="async () => await ConfirmDelete(item.Id)">Deletar</button>
                        <button type="button" @onclick="TestClick">Teste click</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <button type="button" class="btn btn-secondary me-2" @onclick="Anterior" disabled="@(!TemPaginaAnterior)">Anterior</button>
        <button type="button" class="btn btn-secondary" @onclick="Proximo" disabled="@(!TemProximaPagina)">Próximo</button>
        <span class="ms-3">Página @_paginaAtual + 1</span>
    </div>
}

@code {
    private List<CategoriaMinDTO>? categorias;
    private int _paginaAtual = 0;
    private int _paginaTamanho = 2;

    private bool TemPaginaAnterior => _paginaAtual > 0;
    private bool TemProximaPagina => categorias != null && categorias.Count == _paginaTamanho;

    protected override async Task OnInitializedAsync()
    {
        await CarregarCategorias();
    }

    private async Task CarregarCategorias()
    {
        categorias = await Http.GetFromJsonAsync<List<CategoriaMinDTO>>(
            $"https://localhost:7187/Categoria?paginaAtual={_paginaAtual}&tamanho={_paginaTamanho}"
        );
        StateHasChanged();
    }

    private Task Editar(Guid id)
    {
        Navigation.NavigateTo($"/Categoria/Edit/{id}");
        return Task.CompletedTask;
    }

    private async Task ConfirmDelete(Guid id)
    {
        // log no console do navegador para confirmar que o método foi invocado
        await JS.InvokeVoidAsync("console.log", $"ConfirmDelete invocado para {id}");

        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Deseja realmente deletar a categoria {id}?");
        if (!confirm) return;

        try
        {
            var response = await Http.DeleteAsync($"https://localhost:7187/Categoria/{id}");
            if (response.IsSuccessStatusCode)
            {
                await CarregarCategorias();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("alert", $"Erro ao deletar: {error}");
            }
        }
        catch (Exception ex)
        {
            // log de erro no console do navegador
            await JS.InvokeVoidAsync("console.error", $"Erro ao chamar backend: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Erro ao chamar backend. Veja console do navegador para mais detalhes.");
        }
    }

    private async Task TestClick()
    {
        await JS.InvokeVoidAsync("console.log", "Botão funcionando!");
    }

    private async Task Proximo()
    {
        if (TemProximaPagina)
        {
            _paginaAtual++;
            await CarregarCategorias();
        }
    }

    private async Task Anterior()
    {
        if (TemPaginaAnterior)
        {
            _paginaAtual--;
            await CarregarCategorias();
        }
    }
}
